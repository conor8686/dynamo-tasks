  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\nclr.AddReference('RevitAPI')\nclr.AddReference('RevitServices')\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\nfrom Autodesk.Revit.DB import *\nimport math\nimport os\n\ndoc = DocumentManager.Instance.CurrentDBDocument\n\n# V2.57: Civil 3D Project Explorer PC/PT exact horizontal-curve transition fix.\n\n# INPUTS\ndata = IN[0] if len(IN) > 0 else None\ndiameter_mm = IN[1] if len(IN) > 1 else 100.0\nuse_true_coords = IN[2] if len(IN) > 2 else False\ndata2 = IN[3] if len(IN) > 3 else None\nuse_custom_profile_in = IN[4] if len(IN) > 4 else False\nprofile_rfa_path_in = IN[5] if len(IN) > 5 else None\nglobal_origin_in = IN[6] if len(IN) > 6 else None\norigin_unit_in = IN[7] if len(IN) > 7 and IN[7] else \"M\"\n\n# Independent settings for Excel route names containing Com (case-insensitive).\ncom_diameter_mm = IN[8] if len(IN) > 8 else 0.0\ncom_use_custom_profile = bool(IN[9]) if len(IN) > 9 else False\ncom_profile_path = IN[10] if len(IN) > 10 else None\n\ndef optional_profile_path(value):\n    \"\"\"Treat empty Dynamo File Path outputs as absent, not as filenames.\"\"\"\n    while isinstance(value, (list, tuple)):\n        if not value:\n            return ''\n        if len(value) != 1:\n            raise ValueError('Select one profile family per optional family node.')\n        value = value[0]\n    if value is None:\n        return ''\n    path = str(value).strip().strip('\"').strip(\"'\").strip()\n    empty_labels = ('', 'none', 'null', 'no file selected', 'no file selected.',\n                    'no file selected...', 'no file selected…', '<none>', '<null>')\n    if path.lower() in empty_labels:\n        return ''\n    return path\n\n# True selects the browsed RFA; False always selects the embedded family.\nduct_use_imported = bool(IN[4]) if len(IN) > 4 else False\ncom_use_imported = bool(IN[9]) if len(IN) > 9 else False\nprofile_rfa_path_in = optional_profile_path(IN[11] if len(IN) > 11 else None) if duct_use_imported else 'BUILT_IN_CIRCULAR_PROFILE'\ncom_profile_path = optional_profile_path(IN[12] if len(IN) > 12 else None) if com_use_imported else 'BUILT_IN_CIRCULAR_PROFILE'\n# Both choices use a family profile, including the embedded circular family.\nuse_custom_profile_in = True\ncom_use_custom_profile = True\n\n# V2.83: one sweep per duct gridline.  IN[13] = formation:\n#   0 Single  - one duct on the path (old behaviour; blank also means this)\n#   1 Three   - three ducts in a flat row, pitch = duct diameter + 75 mm clear\n#             (160 mm ducts -> 235 c/c, i.e. -235 / 0 / +235 about the path)\n#   2 Trefoil - three ducts at an equilateral triangle: two side by side, one centred\n#             above them (path = top of the lower pair; apex raised by pitch x sqrt(3)/2)\n#   IN[14] = Three (flat) c/c mm (blank/0 = diameter + 75), IN[15] = Trefoil c/c mm (blank/0 = diameter).\n#   or a custom list of lateral offsets in mm, e.g. \"-300,0,300\" (left of travel +).\ndef parse_grid_offsets(value):\n    while isinstance(value, (list, tuple)):\n        if not value:\n            return [0.0]\n        if len(value) == 1:\n            value = value[0]\n        else:\n            value = \",\".join(str(v) for v in value)\n    if value is None:\n        return [0.0]\n    items = str(value).replace(';', ',').replace(' ', ',').split(',')\n    offsets = []\n    for item in items:\n        item = item.strip()\n        if not item:\n            continue\n        number = float(item)\n        if not (abs(number) < 1.0e6):\n            raise ValueError('Gridline offset is not a finite number: ' + item)\n        if not [o for o in offsets if abs(o - number) < 1e-6]:\n            offsets.append(number)\n    return offsets if offsets else [0.0]\n\ndef _pitch_mm(value):\n    while isinstance(value, (list, tuple)) and len(value) == 1:\n        value = value[0]\n    try:\n        number = float(value)\n    except (TypeError, ValueError):\n        return None\n    return number if (number == number and abs(number) < 1.0e6 and number > 0.0) else None\n\ndef resolve_grid_layout(value, duct_diameter_mm, flat_pitch_in=None, trefoil_pitch_in=None):\n    \"\"\"Return [(lateral_mm, rise_mm), ...] for the chosen formation.\n    flat_pitch_in / trefoil_pitch_in are centre-to-centre distances in mm; blank or\n    zero falls back to diameter + 75 (flat) and diameter (trefoil, touching).\"\"\"\n    while isinstance(value, (list, tuple)) and len(value) == 1:\n        value = value[0]\n    text = '' if value is None else str(value).strip().lower()\n    try:\n        # Selector index from the slider: 0 = Single, 1 = Three, 2 = Trefoil.\n        text = {0: 'single', 1: 'three', 2: 'trefoil'}.get(int(round(float(text))), text) \\\n            if abs(float(text) - round(float(text))) < 1e-9 and 0 <= round(float(text)) <= 2 else text\n    except ValueError:\n        pass\n    dia = float(duct_diameter_mm)\n    if text in ('', 'single', 'one'):\n        return [(0.0, 0.0)]\n    if text in ('three', 'flat', 'three flat', 'flat three'):\n        pitch = _pitch_mm(flat_pitch_in) or (dia + 75.0)\n        if pitch < dia - 1e-6:\n            raise ValueError('Three (flat) spacing {:.1f} mm is smaller than the {:.1f} mm duct diameter - ducts would overlap.'.format(pitch, dia))\n        return [(-pitch, 0.0), (0.0, 0.0), (pitch, 0.0)]\n    if text.startswith('tref'):\n        pitch = _pitch_mm(trefoil_pitch_in) or dia\n        if pitch < dia - 1e-6:\n            raise ValueError('Trefoil spacing {:.1f} mm is smaller than the {:.1f} mm duct diameter - ducts would overlap.'.format(pitch, dia))\n        return [(-pitch / 2.0, 0.0), (pitch / 2.0, 0.0), (0.0, pitch * math.sqrt(3.0) / 2.0)]\n    return [(o, 0.0) for o in parse_grid_offsets(value)]\n\ngrid_mode_in = IN[13] if len(IN) > 13 else None\ngrid_flat_pitch_in = IN[14] if len(IN) > 14 else None      # Three (flat) c/c, mm\ngrid_trefoil_pitch_in = IN[15] if len(IN) > 15 else None   # Trefoil c/c, mm\ncurrent_route_is_com = False   # Com routes stay a single sweep on the centreline\n\nresult = None\n\n# V2.61 ROBUST INPUT NORMALIZER\n# The one-click selector can arrive through Dynamo as either genuine nested\n# lists or as rows stringified like \"['point index', ...]\". It can also hand\n# both XY and Z tables to one input. Normalize all of those cases before the\n# proven V2.57 geometry parser runs.\nimport ast\n\nclass _NoneNameToConstant(ast.NodeTransformer):\n    def visit_Name(self, node):\n        if str(node.id).lower() == \"none\":\n            return ast.copy_location(ast.Constant(value=None), node)\n        return node\n\ndef _parse_row_string(value):\n    if not isinstance(value, str):\n        return value\n    s = value.strip()\n    if not (s.startswith('[') and s.endswith(']')):\n        return value\n    try:\n        tree = ast.parse(s, mode='eval')\n        tree = _NoneNameToConstant().visit(tree)\n        ast.fix_missing_locations(tree)\n        return ast.literal_eval(tree)\n    except Exception:\n        return value\n\ndef _normalize_table(obj):\n    if obj is None:\n        return None\n    if isinstance(obj, tuple):\n        obj = list(obj)\n    if not isinstance(obj, list):\n        return obj\n    result_rows = []\n    for item in obj:\n        item = _parse_row_string(item)\n        if isinstance(item, tuple):\n            item = list(item)\n        result_rows.append(item)\n    return result_rows\n\ndef _header_kind(table):\n    if not isinstance(table, list):\n        return None\n    for row in table:\n        row = _parse_row_string(row)\n        if not isinstance(row, (list, tuple)):\n            continue\n        vals = [str(x).strip().lower() if x is not None else '' for x in row]\n        if 'point index' in vals and 'easting' in vals and 'northing' in vals:\n            return 'xy'\n        if ('entity index' in vals and 'start easting' in vals and\n                'start northing' in vals and 'end easting' in vals and\n                'end northing' in vals):\n            return 'z'\n    return None\n\ndef _collect_candidate_tables(obj):\n    \"\"\"Return likely worksheet tables without flattening their row structure.\"\"\"\n    obj = _normalize_table(obj)\n    candidates = []\n    if not isinstance(obj, list):\n        return candidates\n    if _header_kind(obj):\n        candidates.append(obj)\n        return candidates\n    # One-click output may be [XY_table, Z_table].\n    for child in obj:\n        child = _normalize_table(child)\n        if isinstance(child, list) and _header_kind(child):\n            candidates.append(child)\n    return candidates\n\n# Prefer explicitly wired IN[0]/IN[3], but recover automatically if the\n# one-click node supplies both worksheets on either input.\n_candidates = []\n_candidates.extend(_collect_candidate_tables(data))\n_candidates.extend(_collect_candidate_tables(data2))\n\n_xy = None\n_z = None\nfor _tbl in _candidates:\n    _kind = _header_kind(_tbl)\n    if _kind == 'xy' and _xy is None:\n        _xy = _tbl\n    elif _kind == 'z' and _z is None:\n        _z = _tbl\n\n# Also normalize a normal, correctly wired table.\nif _xy is None:\n    _tmp = _normalize_table(data)\n    if _header_kind(_tmp) == 'xy':\n        _xy = _tmp\nif _z is None:\n    _tmp = _normalize_table(data2)\n    if _header_kind(_tmp) == 'z':\n        _z = _tmp\n\nif _xy is not None:\n    data = _xy\nif _z is not None:\n    data2 = _z\n\n\ndef to_float(v):\n    if v is None:\n        return None\n    if isinstance(v, str):\n        v = v.strip()\n        # Civil 3D / Excel exports can contain Unicode minus signs or\n        # non-breaking spaces.  Normalise them so negative Alignment Radius\n        # values (for example -8.9956) are never discarded as text.\n        v = (v.replace(u'\\u2212', '-')\n               .replace(u'\\u2013', '-')\n               .replace(u'\\u2014', '-')\n               .replace(u'\\xa0', '')\n               .replace(',', ''))\n        if v.endswith(u'°'):\n            v = v[:-1].strip()\n        # Allow a harmless trailing metre marker from some report formats.\n        if v.lower().endswith(' m'):\n            v = v[:-2].strip()\n        if v == '':\n            return None\n    try:\n        return float(v)\n    except:\n        return None\n\n\ndef is_finite_number(v):\n    try:\n        return v is not None and not math.isnan(v) and not math.isinf(v)\n    except Exception:\n        return False\n\n\ndef parse_station(v):\n    \"\"\"Parse Civil 3D station values such as 0+002.19 or 1+234.56.\"\"\"\n    if v is None:\n        return None\n    try:\n        s = str(v).strip().replace('\\xa0', '').replace(' ', '')\n    except:\n        return None\n    if not s:\n        return None\n    # Civil 3D chainage: kilometres/hundreds prefix + remainder.\n    if '+' in s:\n        try:\n            left, right = s.split('+', 1)\n            left = left.replace(',', '')\n            right = right.replace(',', '')\n            sign = -1.0 if left.startswith('-') else 1.0\n            return sign * (abs(float(left)) * 1000.0 + abs(float(right)))\n        except:\n            return None\n    try:\n        return float(s.replace(',', ''))\n    except:\n        return None\n\n\ndef origin_unit_to_meters_factor(unit_str):\n    key = str(unit_str).strip().lower()\n\n    if key in (\n        \"mm\",\n        \"millimeter\",\n        \"millimetre\",\n        \"millimeters\",\n        \"millimetres\"\n    ):\n        return 0.001\n\n    if key in (\n        \"m\",\n        \"meter\",\n        \"metre\",\n        \"meters\",\n        \"metres\"\n    ):\n        return 1.0\n\n    return None\n\n\ndef parse_global_origin(v):\n    if v is None:\n        return None\n\n    if isinstance(v, str):\n        parts = [p.strip() for p in v.split(',')]\n    else:\n        parts = list(v)\n\n    if len(parts) == 4:\n        # E, N, Z, rotation - same order as the 3-value form.\n        e = to_float(parts[0])\n        nn = to_float(parts[1])\n        z = to_float(parts[2])\n        angle_deg = to_float(parts[3])\n\n    elif len(parts) == 3:\n        e = to_float(parts[0])\n        nn = to_float(parts[1])\n        z = to_float(parts[2])\n        angle_deg = None\n\n    else:\n        return None\n\n    if e is None or nn is None or z is None:\n        return None\n\n    return e, nn, z, angle_deg\n\n\ndef find_vcurve(s0, s1, vcurves):\n    mid = (s0 + s1) / 2.0\n\n    for vc in vcurves:\n        lo = min(vc['start'], vc['end'])\n        hi = max(vc['start'], vc['end'])\n\n        if lo - 1e-6 <= mid <= hi + 1e-6:\n            return vc\n\n    return None\n\n\ndef merge_collinear_lines(curves, dot_tol=1e-6):\n    if not curves:\n        return curves\n\n    merged = [curves[0]]\n\n    for c in curves[1:]:\n        prev = merged[-1]\n        combined = None\n\n        if isinstance(prev, Line) and isinstance(c, Line):\n            p0 = prev.GetEndPoint(0)\n            p1 = prev.GetEndPoint(1)\n            q0 = c.GetEndPoint(0)\n            q1 = c.GetEndPoint(1)\n\n            if p1.DistanceTo(q0) < 1e-6:\n                try:\n                    d1 = p1.Subtract(p0).Normalize()\n                    d2 = q1.Subtract(q0).Normalize()\n\n                    if d1.DotProduct(d2) > 1.0 - dot_tol:\n                        combined = Line.CreateBound(p0, q1)\n                except Exception:\n                    combined = None\n\n        if combined is not None:\n            merged[-1] = combined\n        else:\n            merged.append(c)\n\n    return merged\n\n\nBUILT_IN_PROFILE = 'BUILT_IN_CIRCULAR_PROFILE'\n\ndef resolve_builtin_profile(path):\n    if str(path) != BUILT_IN_PROFILE:\n        return path\n    if int(doc.Application.VersionNumber) < 2026:\n        raise ValueError('The built-in circular family requires Revit 2026 or newer.')\n    import base64\n    import hashlib\n    import tempfile\n    payload = base64.b64decode('')\n    expected = '19b1a0298b802ed8074973d6cb9519c857f1296966219296b367ed265fdd1a99'\n    if hashlib.sha256(payload).hexdigest() != expected:\n        raise ValueError('The embedded circular family is damaged.')\n    folder = os.path.join(tempfile.gettempdir(), 'MWP_Dynamo_Profiles', expected)\n    if not os.path.isdir(folder):\n        os.makedirs(folder)\n    target = os.path.join(folder, 'MWP_Circular_Profile_Parameterized_RV2026.rfa')\n    valid = False\n    if os.path.isfile(target):\n        with open(target, 'rb') as stream:\n            valid = hashlib.sha256(stream.read()).hexdigest() == expected\n    if not valid:\n        handle, staging = tempfile.mkstemp(suffix='.rfa', dir=folder)\n        try:\n            with os.fdopen(handle, 'wb') as stream:\n                stream.write(payload)\n            os.replace(staging, target)\n        finally:\n            if os.path.isfile(staging):\n                os.remove(staging)\n    return target\n\n\ndef get_or_load_profile_symbol(path):\n    try:\n        path = resolve_builtin_profile(path)\n    except Exception as ex:\n        return None, str(ex)\n\n    if path is None:\n        return None, \"no .rfa path was supplied\"\n\n    path = str(path).strip()\n\n    if not path:\n        return None, \"the .rfa path was empty\"\n\n    if not path.lower().endswith('.rfa'):\n        return None, \"path does not end in .rfa: '{}'\".format(path)\n\n    if not os.path.isfile(path):\n        return None, \"file does not exist: '{}'\".format(path)\n\n    family_name = os.path.splitext(os.path.basename(path))[0]\n    existing_family = None\n\n    for fam in FilteredElementCollector(doc).OfClass(Family):\n        if fam.Name == family_name:\n            existing_family = fam\n            break\n\n    family = existing_family\n\n    if family is None:\n        try:\n            raw_result = doc.LoadFamily(path)\n            loaded_ok = bool(raw_result[0]) if isinstance(raw_result, tuple) else bool(raw_result)\n            loaded_family = raw_result[1] if isinstance(raw_result, tuple) and len(raw_result) > 1 else None\n\n            if loaded_ok:\n                loaded_name = os.path.splitext(\n                    os.path.basename(str(path))\n                )[0]\n\n                for loaded_fam in FilteredElementCollector(doc).OfClass(Family):\n                    if loaded_fam.Name == loaded_name:\n                        loaded_family = loaded_fam\n                        break\n\n        except Exception as ex:\n            return None, \"could not load '{}': {}\".format(path, str(ex))\n\n        if not loaded_ok or loaded_family is None:\n            return None, \"LoadFamily returned false for '{}'\".format(path)\n\n        family = loaded_family\n\n    symbol_ids = list(family.GetFamilySymbolIds())\n\n    if not symbol_ids:\n        return None, (\n            \"family '{}' has no types (FamilySymbols)\"\n            .format(family_name)\n        )\n\n    symbol = doc.GetElement(symbol_ids[0])\n\n    if not isinstance(symbol, FamilySymbol):\n        return None, (\n            \"element resolved from '{}' is not a FamilySymbol\"\n            .format(family_name)\n        )\n\n    if not symbol.IsActive:\n        symbol.Activate()\n        doc.Regenerate()\n\n    return symbol, None\n\n\ndef sized_profile_symbol(symbol, diameter):\n    \"\"\"Use a dedicated type for each diameter; never resize an existing sweep type.\"\"\"\n    mm = to_float(diameter)\n    if not is_finite_number(mm) or mm <= 0:\n        raise ValueError(\"Duct diameter must be a positive number in mm.\")\n    target_ft = mm / 304.8\n    parameter = symbol.LookupParameter('Diameter')\n    if parameter is None or parameter.StorageType != StorageType.Double or parameter.Definition.GetDataType() != SpecTypeId.Length:\n        if str(profile_rfa_path_in) == BUILT_IN_PROFILE:\n            raise ValueError(\"Built-in circular profile is missing its Length type Diameter parameter.\")\n        # Imported profiles may be rectangular or fixed-size; preserve their geometry.\n        return symbol\n    # Reuse only a type whose actual parameter value already matches.\n    for sid in symbol.Family.GetFamilySymbolIds():\n        candidate = doc.GetElement(sid)\n        p = candidate.LookupParameter('Diameter')\n        if p is not None and abs(p.AsDouble() - target_ft) < 1e-9:\n            if not candidate.IsActive:\n                candidate.Activate()\n            doc.Regenerate()\n            return candidate\n    import uuid\n    candidate = symbol.Duplicate('Duct_{:.6g}mm_{}'.format(mm, uuid.uuid4().hex[:8]))\n    p = candidate.LookupParameter('Diameter')\n    if p is None or p.IsReadOnly:\n        raise ValueError(\"Profile Diameter must be writable.\")\n    p.Set(target_ft)\n    if not candidate.IsActive:\n        candidate.Activate()\n    doc.Regenerate()\n    if abs(p.AsDouble() - target_ft) > 1e-9:\n        raise ValueError(\"Profile Diameter did not accept the duct input.\")\n    return candidate\n\n\ndef custom_profile_top_offset(symbol):\n    \"\"\"Measure the selected type in a temporary straight sweep, then discard it.\n\n    Local profile Y maps to world Z on this horizontal X-directed probe.\n    Measuring actual solids respects profiles whose origin is not centred.\n    \"\"\"\n    # This supplied family is a circle centred on the origin. Use its exact\n    # radius: a solid bounding box may conservatively overestimate the top.\n    if symbol.Family.Name == 'MWP_Circular_Profile_Parameterized_RV2026':\n        return -symbol.LookupParameter('Diameter').AsDouble() / 2.0\n    probe = SubTransaction(doc)\n    probe.Start()\n    try:\n        profile = doc.Application.Create.NewFamilySymbolProfile(symbol)\n        path = CurveArray()\n        path.Append(Line.CreateBound(XYZ.Zero, XYZ(10.0, 0.0, 0.0)))\n        plane = SketchPlane.Create(doc, Plane.CreateByNormalAndOrigin(XYZ.BasisZ, XYZ.Zero))\n        sweep = doc.FamilyCreate.NewSweep(True, path, plane, profile, 0, ProfilePlaneLocation.Start)\n        doc.Regenerate()\n        tops = []\n        for item in sweep.get_Geometry(Options()):\n            if isinstance(item, Solid) and item.Volume > 0:\n                bounds = item.GetBoundingBox()\n                for x in (bounds.Min.X, bounds.Max.X):\n                    for y in (bounds.Min.Y, bounds.Max.Y):\n                        for z in (bounds.Min.Z, bounds.Max.Z):\n                            tops.append(bounds.Transform.OfPoint(XYZ(x, y, z)).Z)\n        if not tops:\n            raise RuntimeError(\"Cannot measure the top of the selected custom profile.\")\n        return -max(tops)\n    finally:\n        probe.RollBack()\n\n\ndef top_profile_frame(refs, curves, radius):\n    \"\"\"Resolve Revit's actual section frame at the flattest path start.\n\n    Near-vertical route starts do not define a reliable top direction.\n    Never assume that local profile +Y equals world up.\n    \"\"\"\n    index = min(range(len(curves)), key=lambda i:\n                abs(curves[i].ComputeDerivatives(0.0, True).BasisX.Normalize().Z))\n    probe_tx = SubTransaction(doc)\n    probe_tx.Start()\n    try:\n        arcs = CurveArray()\n        for a, b in ((0.0, math.pi), (math.pi, 2.0 * math.pi)):\n            arcs.Append(Arc.Create(XYZ.Zero, radius, a, b, XYZ.BasisX, XYZ.BasisY))\n        loops = CurveArrArray()\n        loops.Append(arcs)\n        profile = doc.Application.Create.NewCurveLoopsProfile(loops)\n        probe = doc.FamilyCreate.NewSweep(True, refs, profile, index, ProfilePlaneLocation.Start)\n        doc.Regenerate()\n        plane = probe.ProfileSketch.SketchPlane.GetPlane()\n        up = XYZ.BasisZ.Subtract(plane.Normal.Multiply(plane.Normal.Z))\n        if up.GetLength() < 1e-8:\n            raise RuntimeError(\"A fully vertical route has no unique top-of-duct section direction.\")\n        up = up.Normalize()\n        return index, up.DotProduct(plane.XVec), up.DotProduct(plane.YVec)\n    finally:\n        probe_tx.RollBack()\n\n\ndef run_sweeps():\n    global _created_sweep_ids\n    _created_sweep_ids = []\n    result = None\n    if not doc.IsFamilyDocument:\n        result = \"ERROR: Open a Family Editor document before running this script.\"\n    \n    elif not data:\n        result = \"ERROR: Input Data (IN[0]) is empty.\"\n    \n    else:\n        # Detect either the original point-table format or a Civil 3D\n        # profile entity table (Entity Index / Start Easting / End Easting...).\n        def clean_header(value):\n            if value is None:\n                return ''\n            try:\n                txt = str(value)\n            except:\n                return ''\n            txt = txt.replace('\\xa0', ' ').replace('_', ' ').strip().lower()\n            return ' '.join(txt.split())\n\n        header_idx = None\n        header = None\n        header_map = None\n        input_mode = None\n\n        for i, row in enumerate(data):\n            if not row:\n                continue\n            cleaned = [clean_header(x) for x in row]\n            if 'point index' in cleaned:\n                input_mode = 'point'\n            elif 'entity index' in cleaned and 'start easting' in cleaned and 'end easting' in cleaned:\n                input_mode = 'entity'\n            else:\n                continue\n\n            header_idx = i\n            header = row\n            header_map = {}\n            for j, name in enumerate(cleaned):\n                if name and name not in header_map:\n                    header_map[name] = j\n            break\n\n        if header_idx is None:\n            preview = []\n            try:\n                for r in data[:10]:\n                    preview.append([clean_header(x) for x in r] if r else [])\n            except:\n                pass\n            return (\n                \"ERROR: Could not find a supported geometry header row. \"\n                \"Expected either 'Point Index' or a Civil 3D 'Entity Index' row \"\n                \"with Start/End Easting and Northing. First rows received: {}\"\n            ).format(preview)\n\n        if input_mode == 'point':\n            required = ['easting', 'northing', 'entity type', 'station']\n        else:\n            required = [\n                'entity index', 'entity type', 'start station', 'end station',\n                'start easting', 'start northing', 'start elevation',\n                'end easting', 'end northing', 'end elevation'\n            ]\n\n        missing = [name for name in required if name not in header_map]\n        if missing:\n            return (\n                \"ERROR: {} table found, but required columns are missing. \"\n                \"Missing: {}. Headers found: {}\"\n            ).format(\n                input_mode, ', '.join(missing),\n                ', '.join([clean_header(x) for x in header if clean_header(x)])\n            )\n\n        # V2.52: Build a station -> elevation table from IN[3] (Z_Calculated).\n        # Supports either a point report (Station/Elevation) or a profile entity\n        # report (Start/End Station + Start/End Elevation).  This lets IN[0]\n        # remain the Civil 3D XY report even when its Elevation cells are blank.\n        z_by_station = {}\n        z_source_note = \"\"\n\n        if data2:\n            z_header_idx = None\n            z_header_map = None\n            for zi, zrow in enumerate(data2):\n                if not zrow:\n                    continue\n                zclean = [clean_header(x) for x in zrow]\n                if ('station' in zclean and 'elevation' in zclean) or (\n                    'start station' in zclean and 'end station' in zclean and\n                    'start elevation' in zclean and 'end elevation' in zclean\n                ):\n                    z_header_idx = zi\n                    z_header_map = {}\n                    for zj, zname in enumerate(zclean):\n                        if zname and zname not in z_header_map:\n                            z_header_map[zname] = zj\n                    break\n\n            if z_header_idx is not None:\n                if 'station' in z_header_map and 'elevation' in z_header_map:\n                    for zrow in data2[z_header_idx + 1:]:\n                        if not zrow:\n                            continue\n                        zs = parse_station(zrow[z_header_map['station']] if z_header_map['station'] < len(zrow) else None)\n                        zz = to_float(zrow[z_header_map['elevation']] if z_header_map['elevation'] < len(zrow) else None)\n                        if zs is not None and zz is not None:\n                            z_by_station[round(zs, 6)] = zz\n                    z_source_note = \"point Station/Elevation table\"\n                else:\n                    for zrow in data2[z_header_idx + 1:]:\n                        if not zrow:\n                            continue\n                        for skey, zkey in (('start station','start elevation'), ('end station','end elevation')):\n                            zs = parse_station(zrow[z_header_map[skey]] if z_header_map[skey] < len(zrow) else None)\n                            zz = to_float(zrow[z_header_map[zkey]] if z_header_map[zkey] < len(zrow) else None)\n                            if zs is not None and zz is not None:\n                                z_by_station[round(zs, 6)] = zz\n                    z_source_note = \"profile Start/End Station/Elevation table\"\n\n        def elevation_at_station(station):\n            if station is None or not z_by_station:\n                return None\n            key = round(station, 6)\n            if key in z_by_station:\n                return z_by_station[key]\n            # Linear interpolation between profile stations for XY sample points\n            keys = sorted(z_by_station.keys())\n            if station < keys[0] - 1e-6 or station > keys[-1] + 1e-6:\n                return None\n            for ai in range(len(keys) - 1):\n                s0, s1 = keys[ai], keys[ai + 1]\n                if s0 - 1e-6 <= station <= s1 + 1e-6:\n                    z0, z1 = z_by_station[s0], z_by_station[s1]\n                    if abs(s1 - s0) < 1e-12:\n                        return z0\n                    f = (station - s0) / (s1 - s0)\n                    return z0 + (z1 - z0) * f\n            return None\n\n        vcurves = []\n\n        if data2:\n            header2_idx = None\n            header2_map = None\n            for vi, vrow in enumerate(data2):\n                if not vrow:\n                    continue\n                vclean = [clean_header(x) for x in vrow]\n                # Vertical-curve metadata is optional. Only parse it when the\n                # necessary fields actually exist; an alignment entity report\n                # must not crash the node.\n                if 'start station' in vclean and 'end station' in vclean:\n                    header2_idx = vi\n                    header2_map = {name: j for j, name in enumerate(vclean) if name}\n                    if ('curve radius' in header2_map or 'profile radius' in header2_map or 'radius' in header2_map):\n                        break\n\n            if header2_idx is not None and header2_map:\n                radius_key = ('curve radius' if 'curve radius' in header2_map else\n                              'profile radius' if 'profile radius' in header2_map else\n                              'radius' if 'radius' in header2_map else None)\n                pc_key = 'parameter constraint' if 'parameter constraint' in header2_map else None\n                ct_key = 'curve type' if 'curve type' in header2_map else ('entity type' if 'entity type' in header2_map else None)\n                if radius_key:\n                    for vrow in data2[header2_idx + 1:]:\n                        if not vrow:\n                            continue\n                        ss = parse_station(vrow[header2_map['start station']] if header2_map['start station'] < len(vrow) else None)\n                        es = parse_station(vrow[header2_map['end station']] if header2_map['end station'] < len(vrow) else None)\n                        radius = to_float(vrow[header2_map[radius_key]] if header2_map[radius_key] < len(vrow) else None)\n                        curve_type = vrow[header2_map[ct_key]] if ct_key and header2_map[ct_key] < len(vrow) else None\n                        pc_ok = True\n                        if pc_key:\n                            pc = vrow[header2_map[pc_key]] if header2_map[pc_key] < len(vrow) else None\n                            pc_ok = pc is not None and str(pc).strip().lower() == 'radius'\n                        entity_col = header2_map.get('entity type')\n                        entity_label = str(vrow[entity_col]).lower() if entity_col is not None and entity_col < len(vrow) else ''\n                        circular = 'circular' in entity_label\n                        if (circular or (pc_ok and 'parab' not in entity_label and 'tangent' not in entity_label)) and ss is not None and es is not None and is_finite_number(radius) and radius != 0.0:\n                            vcurves.append({'start': ss, 'end': es, 'radius': radius, 'curve_type': curve_type})\n\n        raw_pts = []\n\n        if input_mode == 'point':\n            col_e = header_map['easting']\n            col_n = header_map['northing']\n            col_z = header_map.get('elevation')\n            col_t = header_map['entity type']\n            col_station = header_map['station']\n            # Optional Civil 3D XY report column.  For Entity Type = Curve,\n            # this signed value controls the horizontal curve radius/direction.\n            col_align_radius = header_map.get('alignment radius')\n\n            for row in data[header_idx + 1:]:\n                if not row or row[0] is None or str(row[0]).strip() == '':\n                    continue\n                if to_float(row[0]) is None:\n                    break\n                e_val = to_float(row[col_e])\n                n_val = to_float(row[col_n])\n                z_val = to_float(row[col_z]) if col_z is not None and col_z < len(row) else None\n                type_val = row[col_t]\n                station_val = parse_station(row[col_station])\n                # V2.52: if XY report has a blank Elevation, obtain Z from\n                # IN[3] by station (exact match or linear interpolation).\n                if z_val is None:\n                    z_val = elevation_at_station(station_val)\n                alignment_radius = (\n                    to_float(row[col_align_radius])\n                    if col_align_radius is not None and col_align_radius < len(row)\n                    else None\n                )\n                # Ignore any point row that has no usable Elevation value.\n                if e_val is None or n_val is None or z_val is None:\n                    continue\n                raw_pts.append([\n                    e_val, n_val, z_val, type_val, station_val, alignment_radius\n                ])\n\n        else:\n            # Civil 3D profile entity table.  Store the segment type on the\n            # END point; later seg_types[k] uses point k+1, so transitions\n            # Tangent -> Curve -> Tangent remain unambiguous at shared PVIs.\n            ci = header_map\n            first_entity = True\n            for row in data[header_idx + 1:]:\n                if not row or row[ci['entity index']] is None or str(row[ci['entity index']]).strip() == '':\n                    continue\n                if to_float(row[ci['entity index']]) is None:\n                    break\n\n                se = to_float(row[ci['start easting']])\n                sn = to_float(row[ci['start northing']])\n                sz = to_float(row[ci['start elevation']])\n                ee = to_float(row[ci['end easting']])\n                en = to_float(row[ci['end northing']])\n                ez = to_float(row[ci['end elevation']])\n                ss = parse_station(row[ci['start station']])\n                es = parse_station(row[ci['end station']])\n                et = clean_header(row[ci['entity type']])\n                seg_type = 'Curve' if 'curve' in et else 'Line'\n\n                # Ignore any Civil 3D entity row when either end has no Elevation.\n                if (\n                    se is None or sn is None or sz is None or\n                    ee is None or en is None or ez is None\n                ):\n                    continue\n\n                if first_entity:\n                    raw_pts.append([se, sn, sz, None, ss, None])\n                    first_entity = False\n                else:\n                    # Add a start point only when the report has a real gap.\n                    pe, pn = raw_pts[-1][0], raw_pts[-1][1]\n                    if abs(pe - se) > 1e-6 or abs(pn - sn) > 1e-6:\n                        raw_pts.append([se, sn, sz, 'Line', ss, None])\n\n                raw_pts.append([ee, en, ez, seg_type, es, None])\n\n        # Blank/invalid Elevation rows are intentionally ignored above.\n        # Do not copy elevations from neighbouring points and do not substitute 0.0.\n\n        if len(raw_pts) < 2:\n            if input_mode == 'point' and not z_by_station:\n                result = (\n                    \"ERROR: XY points were found, but no usable elevations were found. \"\n                    \"IN[0] may contain blank Elevation cells, so IN[3] (Z_Calculated) \"\n                    \"must be a Civil 3D PROFILE report containing Station/Elevation or \"\n                    \"Start/End Station + Start/End Elevation. The current Z input appears \"\n                    \"to be an alignment/XY report rather than a profile report.\"\n                )\n            else:\n                result = (\n                    \"ERROR: Fewer than 2 valid XYZ points found after matching XY and Z by station.\"\n                )\n\n        else:\n            M_TO_FT = 1.0 / 0.3048\n            profile_fallback_note = \"\"\n\n            profile_symbol = None\n\n            if bool(use_custom_profile_in):\n                profile_symbol, load_error = (\n                    get_or_load_profile_symbol(profile_rfa_path_in)\n                )\n\n                if profile_symbol is None:\n                    detail = (\n                        load_error if load_error\n                        else \"unknown error loading profile family\"\n                    )\n\n                    return \"ERROR: Custom profile could not be loaded: \" + str(detail)\n                    profile_fallback_note = (\n                        \" (custom profile failed - {} - \"\n                        \"used duct diameter instead)\"\n                    ).format(detail)\n\n            if profile_symbol is not None:\n                profile_symbol = sized_profile_symbol(profile_symbol, diameter_mm)\n            use_custom_profile = profile_symbol is not None\n\n            diam_ft_raw = to_float(diameter_mm) or 100.0\n            radius_ft = (diam_ft_raw / 2.0) / 304.8\n            # V2.70: keep the path on the imported top-of-duct alignment.\n            # Offset the section instead of lowering the path to its centre.\n            z_shift_ft = 0.0\n            custom_y_offset = custom_profile_top_offset(profile_symbol) if use_custom_profile else 0.0\n\n            angle_deg = None\n            origin_unit_note = \"\"\n\n            if use_true_coords:\n                ox = 0.0\n                oy = 0.0\n                oz = 0.0\n\n            elif parse_global_origin(global_origin_in) is not None:\n                ox, oy, oz, angle_deg = parse_global_origin(\n                    global_origin_in\n                )\n\n                origin_unit_factor = origin_unit_to_meters_factor(\n                    origin_unit_in\n                )\n\n                if origin_unit_factor is None:\n                    origin_unit_note = (\n                        \" (WARNING: unit '{}' not recognized - \"\n                        \"use 'mm' or 'M'; treated origin as meters)\"\n                    ).format(origin_unit_in)\n\n                    origin_unit_factor = 1.0\n\n                ox *= origin_unit_factor\n                oy *= origin_unit_factor\n                oz *= origin_unit_factor\n\n            else:\n                ox = raw_pts[0][0]\n                oy = raw_pts[0][1]\n                oz = raw_pts[0][2]\n\n            # V2.67: preserve imported elevation against family Z=0 (Ref. Level).\n            # The supplied/automatic origin only translates the horizontal XY.\n            oz = 0.0\n\n            if angle_deg is not None and angle_deg != 0.0:\n                normalized_angle = angle_deg % 360.0\n\n                revit_angle_deg = (\n                    360.0 - normalized_angle\n                    if normalized_angle != 0.0\n                    else 0.0\n                )\n\n                angle_rad = math.radians(revit_angle_deg)\n                cos_a = math.cos(angle_rad)\n                sin_a = math.sin(angle_rad)\n\n                def rotate_offset(de, dn):\n                    return (\n                        de * cos_a + dn * sin_a,\n                        -de * sin_a + dn * cos_a\n                    )\n            else:\n                def rotate_offset(de, dn):\n                    return de, dn\n\n            def to_internal_xy(e, n):\n                if use_true_coords:\n                    return e * M_TO_FT, n * M_TO_FT\n\n                dx, dy = rotate_offset(e - ox, n - oy)\n                return dx * M_TO_FT, dy * M_TO_FT\n\n            all_pts = []\n\n            for e, n, z, entity_type, station, alignment_radius in raw_pts:\n                x_ft, y_ft = to_internal_xy(e, n)\n\n                all_pts.append((\n                    XYZ(\n                        x_ft,\n                        y_ft,\n                        (z - oz) * M_TO_FT - z_shift_ft\n                    ),\n                    entity_type,\n                    station,\n                    alignment_radius\n                ))\n\n            tol_ft = 0.01 * M_TO_FT\n            clean = [all_pts[0]]\n\n            for point, entity_type, station, alignment_radius in all_pts[1:]:\n                if point.DistanceTo(clean[-1][0]) > tol_ft:\n                    clean.append((\n                        point,\n                        entity_type,\n                        station,\n                        alignment_radius\n                    ))\n                else:\n                    # Keep geometry de-duplicated, but do not lose horizontal-curve\n                    # metadata merely because two exported points are almost coincident.\n                    prev_point, prev_type, prev_station, prev_radius = clean[-1]\n                    this_is_curve = ('curve' in str(entity_type).strip().lower()) if entity_type is not None else False\n                    prev_is_curve = ('curve' in str(prev_type).strip().lower()) if prev_type is not None else False\n                    if this_is_curve and not prev_is_curve:\n                        clean[-1] = (prev_point, entity_type, station, alignment_radius)\n                    elif this_is_curve and prev_is_curve and is_finite_number(alignment_radius):\n                        clean[-1] = (prev_point, prev_type, prev_station, alignment_radius)\n\n            clean_pts = [item[0] for item in clean]\n            clean_types = [item[1] for item in clean]\n            clean_stations = [item[2] for item in clean]\n            clean_alignment_radii = [item[3] for item in clean]\n\n            farthest_pt = max(\n                clean_pts,\n                key=lambda point: point.DistanceTo(XYZ.Zero)\n            )\n\n            max_dist_ft = farthest_pt.DistanceTo(XYZ.Zero)\n            REVIT_LIMIT_FT = 105600.0\n\n            if len(clean_pts) < 2:\n                result = (\n                    \"ERROR: Not enough distinct points to build a path.\"\n                )\n\n            elif max_dist_ft > REVIT_LIMIT_FT:\n                result = (\n                    \"ERROR: after applying the origin/rotation, \"\n                    \"the farthest point is {:.1f} m ({:.0f} ft) \"\n                    \"from the internal origin - Revit's limit is \"\n                    \"about 20 miles (~32,000 m).\"\n                ).format(\n                    max_dist_ft * 0.3048,\n                    max_dist_ft\n                )\n\n            else:\n                if input_mode == 'entity':\n                    # Entity-table convention: each point stores the type of\n                    # the segment that ENDS at that point.\n                    seg_types = [\n                        'Curve' if clean_types[i + 1] == 'Curve' else 'Line'\n                        for i in range(len(clean_pts) - 1)\n                    ]\n                else:\n                    # XY point-table convention: honour the Entity Type text\n                    # from Excel.  Any value containing the word \"curve\"\n                    # (for example \"Curve\", \"Circular Curve\",\n                    # \"Horizontal Curve\") marks the adjacent XY segment as\n                    # curved.  This is deliberately a contains check rather\n                    # than requiring the cell to equal exactly \"Curve\".\n                    def xy_entity_is_curve(value):\n                        if value is None:\n                            return False\n                        try:\n                            return 'curve' in str(value).strip().lower()\n                        except Exception:\n                            return False\n\n                    # V2.57 CIVIL 3D PC/PT FIX\n                    # Project Explorer marks the PC row as Curve, while the PT\n                    # row is already reported as Line. Classify each segment from\n                    # its START point so the last curve segment reaches the true PT.\n                    # tangent->PC = Line, PC->...->PT = Curve, PT->onward = Line.\n                    seg_types = [\n                        'Curve' if xy_entity_is_curve(clean_types[i]) else 'Line'\n                        for i in range(len(clean_pts) - 1)\n                    ]\n\n                def build_xy_alignment_radius_arc(start, end, signed_radius_m, sample_points):\n                    \"\"\"Build a 3D Revit Arc whose PLAN geometry uses Alignment Radius.\n\n                    The signed radius magnitude is the horizontal radius.  When\n                    intermediate XY points are available, they decide which of the\n                    two possible circle centres matches the Excel geometry; the sign\n                    is used as the tie-breaker/direction hint.  Z comes from the\n                    middle sample so the sweep still follows the imported elevation.\n                    \"\"\"\n                    if signed_radius_m is None or abs(signed_radius_m) < 1e-12:\n                        return None, \"blank/zero Alignment Radius\"\n\n                    radius_ft_plan = abs(signed_radius_m) * M_TO_FT\n                    dx = end.X - start.X\n                    dy = end.Y - start.Y\n                    chord_xy = math.sqrt(dx * dx + dy * dy)\n                    if chord_xy < 1e-9:\n                        return None, \"zero XY chord\"\n                    if radius_ft_plan + 1e-8 < chord_xy / 2.0:\n                        return None, (\n                            \"Alignment Radius {:.6g} m is smaller than half the \"\n                            \"XY chord {:.6g} m\"\n                        ).format(signed_radius_m, chord_xy * 0.3048)\n\n                    mx = (start.X + end.X) * 0.5\n                    my = (start.Y + end.Y) * 0.5\n                    h_sq = max(0.0, radius_ft_plan * radius_ft_plan - (chord_xy * chord_xy) / 4.0)\n                    h = math.sqrt(h_sq)\n                    left_x = -dy / chord_xy\n                    left_y = dx / chord_xy\n                    centres = [\n                        (mx + left_x * h, my + left_y * h),\n                        (mx - left_x * h, my - left_y * h)\n                    ]\n\n                    samples = sample_points if sample_points else []\n                    def centre_score(c):\n                        cx, cy = c\n                        if not samples:\n                            return 0.0\n                        total = 0.0\n                        for sp in samples:\n                            rr = math.sqrt((sp.X - cx) ** 2 + (sp.Y - cy) ** 2)\n                            total += abs(rr - radius_ft_plan)\n                        return total\n\n                    scores = [centre_score(c) for c in centres]\n\n                    # V2.56 EXACT XY ARC FIX\n                    # Civil 3D Calculated Stations are authoritative for the PLAN\n                    # geometry.  There are two possible circle centres for a given\n                    # PC/PT chord and radius.  Previous versions selected the centre\n                    # from the radius sign alone; that can choose the opposite circle\n                    # after coordinate rotation and creates a visible kink at PC/PT.\n                    # When Civil 3D intermediate calculated stations exist, choose the\n                    # centre whose circle best fits those exported XY points.  Use the\n                    # signed radius only as a fallback when there are no samples.\n                    if samples:\n                        chosen_index = 0 if scores[0] <= scores[1] else 1\n                    else:\n                        # Fallback only.  centres[0] is left of start->end and\n                        # centres[1] is right of start->end in the current XY frame.\n                        chosen_index = 0 if signed_radius_m > 0.0 else 1\n                    chosen = centres[chosen_index]\n\n                    cx, cy = chosen\n                    if samples:\n                        mid_sample = samples[len(samples) // 2]\n                        vx = mid_sample.X - cx\n                        vy = mid_sample.Y - cy\n                        vl = math.sqrt(vx * vx + vy * vy)\n                        if vl < 1e-9:\n                            mid_sample = None\n                    else:\n                        mid_sample = None\n\n                    if mid_sample is not None:\n                        mid = XYZ(\n                            cx + (vx / vl) * radius_ft_plan,\n                            cy + (vy / vl) * radius_ft_plan,\n                            mid_sample.Z\n                        )\n                    else:\n                        # No useful intermediate point: use the midpoint of the\n                        # minor circular arc in plan and average the elevation.\n                        ux0 = (start.X - cx) / radius_ft_plan\n                        uy0 = (start.Y - cy) / radius_ft_plan\n                        ux1 = (end.X - cx) / radius_ft_plan\n                        uy1 = (end.Y - cy) / radius_ft_plan\n                        sx = ux0 + ux1\n                        sy = uy0 + uy1\n                        sl = math.sqrt(sx * sx + sy * sy)\n                        if sl < 1e-9:\n                            # Semicircle: choose a perpendicular direction using sign.\n                            direction = 1.0 if signed_radius_m >= 0.0 else -1.0\n                            sx = -uy0 * direction\n                            sy = ux0 * direction\n                            sl = math.sqrt(sx * sx + sy * sy)\n                        mid = XYZ(\n                            cx + (sx / sl) * radius_ft_plan,\n                            cy + (sy / sl) * radius_ft_plan,\n                            (start.Z + end.Z) * 0.5\n                        )\n\n                    try:\n                        arc = Arc.Create(start, end, mid)\n                        # V2.73: Revit can regenerate but reject a shallow arc at\n                        # final commit when its defining sample is off-centre.\n                        # Rebuild the SAME circle using its own parametric midpoint.\n                        # Do not resample the route or alter the imported elevations.\n                        stable = Arc.Create(arc.GetEndPoint(0), arc.GetEndPoint(1),\n                                            arc.Evaluate(0.5, True))\n                        deviation = max(arc.Evaluate(t, True).DistanceTo(\n                            stable.Evaluate(t, True)) for t in (0.0, 0.25, 0.5, 0.75, 1.0))\n                        if deviation > 1e-7:\n                            return None, \"Arc normalization exceeded the geometry tolerance.\"\n                        return stable, None\n                    except Exception as ex:\n                        return None, \"Revit Arc.Create failed: {}\".format(str(ex))\n\n                def build_vertical_arc_or_line(k):\n                    start = clean_pts[k]\n                    end = clean_pts[k + 1]\n\n                    if (\n                        clean_stations[k] is not None and\n                        clean_stations[k + 1] is not None\n                    ):\n                        vertical_curve = find_vcurve(\n                            clean_stations[k],\n                            clean_stations[k + 1],\n                            vcurves\n                        )\n                    else:\n                        vertical_curve = None\n\n                    if vertical_curve is not None:\n                        arc_radius_ft = (\n                            abs(vertical_curve['radius']) * M_TO_FT\n                        )\n\n                        chord_len = start.DistanceTo(end)\n\n                        if arc_radius_ft > chord_len / 2.0:\n                            chord_dir = (\n                                end.Subtract(start).Normalize()\n                            )\n\n                            ratio = min(\n                                1.0,\n                                (chord_len / 2.0) / arc_radius_ft\n                            )\n\n                            half_angle = math.asin(ratio)\n\n                            sagitta = (\n                                arc_radius_ft -\n                                arc_radius_ft * math.cos(half_angle)\n                            )\n\n                            z_axis = XYZ.BasisZ\n\n                            vert_perp = z_axis.Subtract(\n                                chord_dir.Multiply(\n                                    z_axis.DotProduct(chord_dir)\n                                )\n                            )\n\n                            if vert_perp.GetLength() < 1e-6:\n                                vert_perp = XYZ.BasisX.Subtract(\n                                    chord_dir.Multiply(\n                                        XYZ.BasisX.DotProduct(chord_dir)\n                                    )\n                                )\n\n                            vert_perp = vert_perp.Normalize()\n\n                            sign = (\n                                -1.0\n                                if str(vertical_curve['curve_type']).strip().lower() == 'sag'\n                                else 1.0\n                            )\n\n                            mid_chord = start.Add(end).Multiply(0.5)\n\n                            mid_point = mid_chord.Add(\n                                vert_perp.Multiply(sign * sagitta)\n                            )\n\n                            try:\n                                return Arc.Create(\n                                    start,\n                                    end,\n                                    mid_point\n                                )\n                            except Exception:\n                                return Line.CreateBound(start, end)\n\n                    return Line.CreateBound(start, end)\n\n                xy_curve_block_notes = []\n                if input_mode == 'point':\n                    bi = 0\n                    while bi < len(clean_pts):\n                        if not xy_entity_is_curve(clean_types[bi]):\n                            bi += 1\n                            continue\n                        bj = bi\n                        while bj + 1 < len(clean_pts) and xy_entity_is_curve(clean_types[bj + 1]):\n                            bj += 1\n                        block_radii = [\n                            rr for rr in clean_alignment_radii[bi:bj + 1]\n                            if is_finite_number(rr)\n                        ]\n                        radius_label = (\n                            \"{:.6g}\".format(block_radii[0])\n                            if block_radii else \"NO VALID RADIUS\"\n                        )\n                        xy_curve_block_notes.append(\n                            \"stations {} to {} | points {} | signed radius {}\".format(\n                                clean_stations[bi], clean_stations[bj],\n                                (bj - bi + 1), radius_label\n                            )\n                        )\n                        bi = bj + 1\n\n                sweep_groups = []\n                i = 0\n                number_of_segments = len(seg_types)\n\n                while i < number_of_segments:\n                    run_type = seg_types[i]\n                    j = i\n\n                    while (\n                        j < number_of_segments and\n                        seg_types[j] == run_type\n                    ):\n                        # The outgoing radius at a shared PC belongs to the NEXT arc.\n                        if run_type == 'Curve' and input_mode == 'point' and j > i:\n                            first_radius = clean_alignment_radii[i]\n                            next_radius = clean_alignment_radii[j]\n                            if (not is_finite_number(first_radius) or\n                                not is_finite_number(next_radius) or\n                                abs(next_radius-first_radius) > max(1e-6,abs(first_radius)*1e-6)):\n                                break\n                        j += 1\n\n                    group_curves = []\n                    run_point_count = (j - i) + 1\n\n                    if run_type == 'Curve' and input_mode == 'point':\n                        # A continuous Excel block of Entity Type = Curve is one\n                        # horizontal curve.  Use Alignment Radius rather than\n                        # merely fitting an arbitrary arc through the XY samples.\n                        radius_values = []\n                        for rr in clean_alignment_radii[i:j]:\n                            if is_finite_number(rr):\n                                radius_values.append(rr)\n\n                        if not radius_values:\n                            return (\n                                \"ERROR: Curve block at station {} to {} has no valid \"\n                                \"Alignment Radius. The curve was not guessed.\"\n                            ).format(clean_stations[i], clean_stations[j])\n\n                        signed_alignment_radius = radius_values[0]\n                        # A single curve block should carry one radius.  Allow only\n                        # tiny spreadsheet rounding differences.\n                        for rr in radius_values[1:]:\n                            if abs(rr - signed_alignment_radius) > max(1e-6, abs(signed_alignment_radius) * 1e-6):\n                                return (\n                                    \"ERROR: Curve block at station {} to {} contains \"\n                                    \"multiple Alignment Radius values: {}\"\n                                ).format(clean_stations[i], clean_stations[j], radius_values)\n\n                        sample_points = clean_pts[i + 1:j]\n                        fitted_arc, radius_error = build_xy_alignment_radius_arc(\n                            clean_pts[i], clean_pts[j], signed_alignment_radius, sample_points\n                        )\n                        if fitted_arc is None:\n                            return (\n                                \"ERROR: Could not build XY curve at station {} to {} \"\n                                \"from Alignment Radius {}: {}\"\n                            ).format(\n                                clean_stations[i], clean_stations[j],\n                                signed_alignment_radius, radius_error\n                            )\n                        group_curves.append(fitted_arc)\n\n                    elif run_type == 'Curve' and run_point_count >= 3:\n                        # Civil 3D entity-table fallback: retain the existing\n                        # 3-point fit when no XY Alignment Radius column is involved.\n                        start_point = clean_pts[i]\n                        end_point = clean_pts[j]\n                        mid_index = i + (j - i) // 2\n                        middle_point = clean_pts[mid_index]\n                        fitted_arc = None\n\n                        try:\n                            if (\n                                middle_point.DistanceTo(start_point) < 1e-7 or\n                                middle_point.DistanceTo(end_point) < 1e-7\n                            ):\n                                raise Exception(\"No distinct intermediate point for arc\")\n                            fitted_arc = Arc.Create(start_point, end_point, middle_point)\n                        except Exception:\n                            fitted_arc = None\n\n                        if fitted_arc is not None:\n                            group_curves.append(fitted_arc)\n                        else:\n                            for k in range(i, j):\n                                group_curves.append(build_vertical_arc_or_line(k))\n\n                    else:\n                        for k in range(i, j):\n                            group_curves.append(\n                                build_vertical_arc_or_line(k)\n                            )\n\n                    group_station_start = clean_stations[i]\n                    group_station_end = clean_stations[j]\n\n                    sweep_groups.append((\n                        run_type,\n                        merge_collinear_lines(group_curves),\n                        group_station_start,\n                        group_station_end\n                    ))\n\n                    i = j\n\n                # V2.71: use one continuous sweep for circular AND custom profiles.\n                # Independent sweeps choose different section frames at bends;\n                # an off-centre (top-aligned) section then leaves offset end faces.\n                # Preserve the V2.69 curve/radius boundaries within the one path.\n                if sweep_groups:\n                    continuous_curves = [c for sg in sweep_groups for c in sg[1]]\n                    for ci in range(len(continuous_curves) - 1):\n                        gap = continuous_curves[ci].GetEndPoint(1).DistanceTo(\n                            continuous_curves[ci + 1].GetEndPoint(0))\n                        if gap > 1e-6:\n                            raise RuntimeError(\n                                \"Cannot connect top-aligned duct: path gap after segment {} = {:.6f} mm.\"\n                                .format(ci + 1, gap * 304.8))\n                    if continuous_curves:\n                        def _plan_normal(tangent):\n                            length = math.hypot(tangent.X, tangent.Y)\n                            if length < 1e-9:\n                                return None\n                            return (-tangent.Y / length, tangent.X / length)\n\n                        def _tangent_at(curve, normalized_param):\n                            return curve.ComputeDerivatives(normalized_param, True).BasisX\n\n                        def offset_path_curves(curves, offset_ft, rise_ft=0.0):\n                            \"\"\"Offset a connected path sideways in plan; Z is kept.\n                            Shared joints use one common point so the offset path stays\n                            gap-free, and arcs are rebuilt through offset start/mid/end.\"\"\"\n                            joint_normals = []\n                            for idx in range(len(curves) + 1):\n                                normals = []\n                                if idx > 0:\n                                    nrm = _plan_normal(_tangent_at(curves[idx - 1], 1.0))\n                                    if nrm is not None:\n                                        normals.append(nrm)\n                                if idx < len(curves):\n                                    nrm = _plan_normal(_tangent_at(curves[idx], 0.0))\n                                    if nrm is not None:\n                                        normals.append(nrm)\n                                if not normals:\n                                    raise RuntimeError('Cannot offset a vertical path segment sideways.')\n                                sx = sum(v[0] for v in normals)\n                                sy = sum(v[1] for v in normals)\n                                sl = math.hypot(sx, sy)\n                                if sl < 1e-9:\n                                    raise RuntimeError('Path reverses direction; cannot offset it.')\n                                joint_normals.append((sx / sl, sy / sl))\n                            joints = []\n                            for idx in range(len(curves) + 1):\n                                base = (curves[idx].GetEndPoint(0) if idx < len(curves)\n                                        else curves[-1].GetEndPoint(1))\n                                joints.append(XYZ(base.X + joint_normals[idx][0] * offset_ft,\n                                                  base.Y + joint_normals[idx][1] * offset_ft,\n                                                  base.Z + rise_ft))\n                            result_curves = []\n                            for idx, curve in enumerate(curves):\n                                if isinstance(curve, Arc):\n                                    mid_nrm = _plan_normal(_tangent_at(curve, 0.5))\n                                    if mid_nrm is None:\n                                        raise RuntimeError('Cannot offset a vertical arc sideways.')\n                                    mid = curve.Evaluate(0.5, True)\n                                    result_curves.append(Arc.Create(\n                                        joints[idx], joints[idx + 1],\n                                        XYZ(mid.X + mid_nrm[0] * offset_ft,\n                                            mid.Y + mid_nrm[1] * offset_ft, mid.Z + rise_ft)))\n                                else:\n                                    result_curves.append(Line.CreateBound(joints[idx], joints[idx + 1]))\n                            return result_curves\n\n                        grid_list = ([(0.0, 0.0)] if current_route_is_com\n                                     else resolve_grid_layout(grid_mode_in, diam_ft_raw,\n                                                         grid_flat_pitch_in, grid_trefoil_pitch_in))\n                        expanded_groups = []\n                        for offset_mm, rise_mm in grid_list:\n                            if abs(offset_mm) < 1e-9 and abs(rise_mm) < 1e-9:\n                                path_curves = continuous_curves\n                            else:\n                                path_curves = offset_path_curves(\n                                    continuous_curves, offset_mm / 304.8, rise_mm / 304.8)\n                            expanded_groups.append((\n                                'Continuous 3D Path (gridline {:+.0f} mm lateral, {:+.0f} mm up)'.format(offset_mm, rise_mm),\n                                path_curves, sweep_groups[0][2], sweep_groups[-1][3]))\n                        sweep_groups = expanded_groups\n\n                tight_curve_warnings = []\n\n                if not use_custom_profile:\n                    for group_index, group_data in enumerate(sweep_groups):\n                        segment_kind = group_data[0]\n                        group_curves = group_data[1]\n                        group_station_start = group_data[2]\n                        group_station_end = group_data[3]\n\n                        for curve in group_curves:\n                            if (\n                                isinstance(curve, Arc) and\n                                curve.Radius <= radius_ft * 1.01\n                            ):\n                                tight_curve_warnings.append(\n                                    (\n                                        \"group {} ({}, station {} to {}): \"\n                                        \"arc radius {:.1f} mm is too tight \"\n                                        \"for the {:.0f} mm duct diameter \"\n                                        \"(needs to exceed {:.1f} mm)\"\n                                    ).format(\n                                        group_index,\n                                        segment_kind,\n                                        group_station_start,\n                                        group_station_end,\n                                        curve.Radius * 304.8,\n                                        diam_ft_raw,\n                                        radius_ft * 304.8\n                                    )\n                                )\n\n                if tight_curve_warnings:\n                    result = (\n                        \"ERROR: path curve radius too tight \"\n                        \"for the sweep profile:\\n\" +\n                        \"\\n\".join(tight_curve_warnings)\n                    )\n\n                else:\n                    # The caller owns one atomic transaction for this run.\n\n                    created_sweeps = []\n                    sweep_failures = []\n\n                    try:\n                        for group_data in sweep_groups:\n                            segment_kind = group_data[0]\n                            curves_in_group = group_data[1]\n                            group_station_start = group_data[2]\n                            group_station_end = group_data[3]\n\n                            ref_array = ReferenceArray()\n\n                            for curve in curves_in_group:\n                                curve_start = curve.GetEndPoint(0)\n\n                                # The sketch plane must contain the curve.\n                                if isinstance(curve, Arc):\n                                    curve_plane = (\n                                        Plane.CreateByNormalAndOrigin(\n                                            curve.Normal,\n                                            curve.Center\n                                        )\n                                    )\n\n                                else:\n                                    curve_end = curve.GetEndPoint(1)\n\n                                    tangent = (\n                                        curve_end\n                                        .Subtract(curve_start)\n                                        .Normalize()\n                                    )\n\n                                    helper = XYZ.BasisZ\n\n                                    if abs(\n                                        tangent.DotProduct(helper)\n                                    ) > 0.99:\n                                        helper = XYZ.BasisY\n\n                                    plane_normal = (\n                                        tangent\n                                        .CrossProduct(helper)\n                                        .Normalize()\n                                    )\n\n                                    curve_plane = (\n                                        Plane.CreateByNormalAndOrigin(\n                                            plane_normal,\n                                            curve_start\n                                        )\n                                    )\n\n                                sketch_plane = SketchPlane.Create(\n                                    doc,\n                                    curve_plane\n                                )\n\n                                model_curve = (\n                                    doc.FamilyCreate.NewModelCurve(\n                                        curve,\n                                        sketch_plane\n                                    )\n                                )\n\n                                ref_array.Append(\n                                    model_curve.GeometryCurve.Reference\n                                )\n\n                            doc.Regenerate()\n\n                            profile_index, up_x, up_y = top_profile_frame(\n                                ref_array, curves_in_group, radius_ft)\n\n                            if use_custom_profile:\n                                sweep_profile = (\n                                    doc.Application.Create\n                                    .NewFamilySymbolProfile(profile_symbol)\n                                )\n                                sweep_profile.Angle = math.atan2(up_y, up_x) - math.pi / 2.0\n                                sweep_profile.XOffset = custom_y_offset * up_x\n                                sweep_profile.YOffset = custom_y_offset * up_y\n\n                            else:\n                                first_curve = curves_in_group[0]\n\n                                # Project world-down into Revit's measured section frame.\n                                profile_origin = XYZ(-radius_ft * up_x, -radius_ft * up_y, 0.0)\n\n                                # NewSweep's SweepProfile must be built flat in the\n                                # world XY-plane using the global X/Y axes - Revit\n                                # transforms it onto the path automatically (via\n                                # IndexOfPathReference and ProfilePlaneLocation).\n                                # Building it pre-rotated to the group's own curve\n                                # tangent (as before) double-applies that transform\n                                # and throws \"One of the conditions for the inputs\n                                # was not satisfied.\" from FamilyItemFactory.NewSweep.\n                                profile_x = XYZ.BasisX\n                                profile_y = XYZ.BasisY\n\n                                profile_curves = CurveArray()\n\n                                profile_curves.Append(\n                                    Arc.Create(\n                                        profile_origin,\n                                        radius_ft,\n                                        0.0,\n                                        math.pi,\n                                        profile_x,\n                                        profile_y\n                                    )\n                                )\n\n                                profile_curves.Append(\n                                    Arc.Create(\n                                        profile_origin,\n                                        radius_ft,\n                                        math.pi,\n                                        2.0 * math.pi,\n                                        profile_x,\n                                        profile_y\n                                    )\n                                )\n\n                                profile_curve_arrays = CurveArrArray()\n                                profile_curve_arrays.Append(\n                                    profile_curves\n                                )\n\n                                sweep_profile = (\n                                    doc.Application.Create\n                                    .NewCurveLoopsProfile(\n                                        profile_curve_arrays\n                                    )\n                                )\n\n                            sweep = doc.FamilyCreate.NewSweep(\n                                True,\n                                ref_array,\n                                sweep_profile,\n                                profile_index,\n                                ProfilePlaneLocation.Start\n                            )\n\n                            _created_sweep_ids.append(sweep.Id)\n                            doc.Regenerate()\n                            # Verify actual geometry, not only matching path endpoints.\n                            solids = [g for g in sweep.get_Geometry(Options())\n                                      if isinstance(g, Solid) and g.Volume > 0.0]\n                            if len(solids) != 1:\n                                raise RuntimeError(\n                                    \"The continuous duct did not produce one connected solid.\")\n                            created_sweeps.append((\n                                segment_kind,\n                                sweep,\n                                group_station_start,\n                                group_station_end\n                            ))\n\n                        if use_custom_profile:\n                            size_parameter = profile_symbol.LookupParameter('Diameter')\n                            has_diameter = (size_parameter is not None and\n                                size_parameter.StorageType == StorageType.Double and\n                                size_parameter.Definition.GetDataType() == SpecTypeId.Length)\n                            if has_diameter:\n                                mode_label = \"profile family '{}', Diameter {:.6g}mm\".format(\n                                    profile_symbol.Family.Name, size_parameter.AsDouble() * 304.8)\n                            else:\n                                mode_label = (\"profile family '{}', authored size retained \"\n                                    \"(no Length type Diameter parameter; duct size input not applied)\").format(\n                                        profile_symbol.Family.Name)\n                        else:\n                            mode_label = (\n                                \"{:.0f}mm circular duct\"\n                                .format(diam_ft_raw)\n                            )\n\n                        # Revit-family verification report.  Check that every\n                        # created Sweep still resolves in the active Family document,\n                        # report ElementIds, segment counts and path continuity.\n                        sweep_ids = []\n                        missing_sweep_ids = []\n                        line_count = 0\n                        curve_count = 0\n                        for created_data in created_sweeps:\n                            kind = created_data[0]\n                            sw = created_data[1]\n                            sid = sw.Id\n                            try:\n                                sid_value = sid.Value\n                            except Exception:\n                                sid_value = sid.IntegerValue\n                            sweep_ids.append(str(sid_value))\n                            if doc.GetElement(sid) is None:\n                                missing_sweep_ids.append(str(sid_value))\n\n                        continuity_issues = []\n                        path_curves_flat = []\n                        group_boundaries = set()\n                        for sg in sweep_groups:\n                            for cc in sg[1]:\n                                path_curves_flat.append(cc)\n                                if isinstance(cc, Line):\n                                    line_count += 1\n                                else:\n                                    curve_count += 1\n                            group_boundaries.add(len(path_curves_flat) - 1)\n                        for ci in range(len(path_curves_flat) - 1):\n                            if ci in group_boundaries:\n                                continue\n                            gap_ft = path_curves_flat[ci].GetEndPoint(1).DistanceTo(\n                                path_curves_flat[ci + 1].GetEndPoint(0)\n                            )\n                            if gap_ft > tol_ft:\n                                continuity_issues.append(\n                                    \"gap after path segment {} = {:.3f} mm\".format(\n                                        ci + 1, gap_ft * 304.8\n                                    )\n                                )\n\n                        xy_radius_notes = []\n                        if input_mode == 'point':\n                            seen = []\n                            for rr in clean_alignment_radii:\n                                if is_finite_number(rr):\n                                    if not [x for x in seen if abs(rr - x) <= max(1e-6, abs(x) * 1e-6)]:\n                                        seen.append(rr)\n                            if seen:\n                                xy_radius_notes.append(\n                                    \"Alignment Radius values used/detected: {}\".format(\n                                        \", \".join([\"{:.6g}\".format(x) for x in seen])\n                                    )\n                                )\n                            if xy_curve_block_notes:\n                                xy_radius_notes.append(\n                                    \"XY source blocks (may contain multiple bends): \" +\n                                    \" ; \".join(xy_curve_block_notes)\n                                )\n\n                        check_status = \"PASS\"\n                        check_details = []\n                        if missing_sweep_ids:\n                            check_status = \"FAIL\"\n                            check_details.append(\n                                \"missing Revit sweep element(s): {}\".format(\n                                    \", \".join(missing_sweep_ids)\n                                )\n                            )\n                        if continuity_issues:\n                            check_status = \"WARNING\" if check_status == \"PASS\" else check_status\n                            check_details.extend(continuity_issues)\n\n                        result = (\n                            \"Successfully created {} continuous sweeps using {}. Top of profile aligned to sweep path.\\n\"\n                            \"Revit family check: {}. Lines: {}, Curves: {}.\\n\"\n                            \"Sweep Element IDs: {}{}{}{}{}\"\n                        ).format(\n                            len(created_sweeps),\n                            mode_label,\n                            check_status,\n                            line_count,\n                            curve_count,\n                            \", \".join(sweep_ids) if sweep_ids else \"none\",\n                            (\"\\n\" + \"\\n\".join(xy_radius_notes)) if xy_radius_notes else \"\",\n                            (\"\\nCheck details: \" + \"; \".join(check_details)) if check_details else \"\",\n                            profile_fallback_note,\n                            origin_unit_note\n                        )\n\n                    except Exception as ex:\n                        raise RuntimeError(\"Sweep failed at station {} to {} ({}): {}\".format(\n                            group_station_start, group_station_end, segment_kind, str(ex)))\n\n                    finally:\n                        pass  # Commit only after all groups regenerate successfully.\n\n                    if created_sweeps:\n                        try:\n                            for warning in doc.GetWarnings():\n                                failing_ids = list(\n                                    warning.GetFailingElements()\n                                )\n\n                                for created_data in created_sweeps:\n                                    segment_kind = created_data[0]\n                                    sweep = created_data[1]\n                                    station_start = created_data[2]\n                                    station_end = created_data[3]\n\n                                    if sweep.Id in failing_ids:\n                                        sweep_failures.append(\n                                            (\n                                                \"station {} to {} \"\n                                                \"({}, element id {}): {}\"\n                                            ).format(\n                                                station_start,\n                                                station_end,\n                                                segment_kind,\n                                                sweep.Id.Value,\n                                                warning.GetDescriptionText()\n                                            )\n                                        )\n\n                        except Exception as warning_exception:\n                            sweep_failures.append(\n                                (\n                                    \"Could not check post-commit \"\n                                    \"warnings: {}\"\n                                ).format(str(warning_exception))\n                            )\n\n                        if sweep_failures:\n                            result = (\n                                \"Created {} sweep(s), but {} failed \"\n                                \"Revit's regeneration check:\\n{}\"\n                            ).format(\n                                len(created_sweeps),\n                                len(sweep_failures),\n                                \"\\n\".join(sweep_failures)\n                            )\n    return result\n\ndef execute_atomic():\n    if doc is None or not doc.IsFamilyDocument:\n        return \"ERROR: Open a 3D family supporting sweeps (for example Generic Model) in Family Editor.\"\n    sub = None\n    try:\n        TransactionManager.Instance.EnsureInTransaction(doc)\n        sub = SubTransaction(doc)\n        sub.Start()\n        message = run_sweeps()\n        if str(message).startswith(\"ERROR:\"):\n            sub.RollBack()\n            return message\n        doc.Regenerate()\n        if sub.Commit() != TransactionStatus.Committed:\n            raise RuntimeError(\"Revit did not commit the sweep changes.\")\n        # A SubTransaction commit does not run Revit's final sweep validation.\n        # Finish the owning Dynamo transaction for THIS route before reporting\n        # success or starting the next batch route.\n        TransactionManager.Instance.ForceCloseTransaction()\n        if not _created_sweep_ids:\n            return \"ERROR: No sweep was retained for this route.\"\n        for sweep_id in _created_sweep_ids:\n            retained = doc.GetElement(sweep_id)\n            if retained is None or not isinstance(retained, Sweep):\n                return \"ERROR: Revit rejected the sweep at final commit; no sweep retained for this route.\"\n        return message + \"\\nFinal Revit transaction committed; sweep elements verified.\"\n    except Exception as ex:\n        if sub is not None and sub.GetStatus() == TransactionStatus.Started:\n            sub.RollBack()\n        return \"ERROR: Sweep run rolled back; no new sweep geometry retained. {}\".format(ex)\n    finally:\n        TransactionManager.Instance.TransactionTaskDone()\n\n\ndef _decode_batch_packet(value, depth=0):\n    import json\n    if depth > 8:\n        return None\n    if isinstance(value, dict):\n        return value if 'batch_version' in value else None\n    if isinstance(value, str):\n        text = value.strip()\n        if not text.startswith(('{', '[')):\n            return None\n        try:\n            decoded = json.loads(text)\n        except Exception:\n            # A Dynamo wrapper can be a Python-list representation with None.\n            try:\n                decoded = ast.literal_eval(text)\n            except Exception:\n                if 'batch_version' in text:\n                    raise ValueError('The report batch is damaged; reselect the report files.')\n                return None\n        return _decode_batch_packet(decoded, depth+1)\n    if isinstance(value, (list, tuple)):\n        packets = []\n        for child in value:\n            packet = _decode_batch_packet(child, depth+1)\n            if packet is not None:\n                packets.append(packet)\n        if len(packets) > 1:\n            raise ValueError('More than one batch packet reached the sweep node.')\n        return packets[0] if packets else None\n    return None\n\n\ndef execute_batch_or_single():\n    global data, data2, global_origin_in, origin_unit_in\n    global diameter_mm, use_custom_profile_in, profile_rfa_path_in\n    import json\n    try:\n        packet = _decode_batch_packet(data)\n        if packet is None:\n            packet = _decode_batch_packet(data2)\n    except ValueError as ex:\n        return \"ERROR: \" + str(ex)\n    if packet is None:\n        return execute_atomic()\n    if not isinstance(packet, dict) or packet.get('batch_version') != 1:\n        return \"ERROR: Unrecognised report selection.\"\n    if packet.get('error'):\n        return \"ERROR: \" + packet['error']\n    pairs = packet.get('pairs', [])\n    if not pairs:\n        return \"ERROR: No XY/Z report pairs selected.\"\n    # Check every table before starting any Revit transaction.\n    for pair in pairs:\n        if _header_kind(pair.get('xy')) != 'xy' or _header_kind(pair.get('z')) != 'z':\n            return \"ERROR: Missing XY/Z table for \" + pair.get('name', 'unknown route')\n    # Reject a selected invalid file before creating any route.\n    for pair in pairs:\n        is_com = 'com' in str(pair.get('name', '')).lower()\n        selected = com_profile_path if is_com else profile_rfa_path_in\n        enabled = com_use_custom_profile if is_com else use_custom_profile_in\n        if enabled and str(selected) != BUILT_IN_PROFILE:\n            if not selected or not str(selected).lower().endswith('.rfa') or not os.path.isfile(str(selected)):\n                return ('ERROR: {} optional family node contains an invalid file: {!r}. '\n                        'Browse to an existing .rfa, or set Use custom profile to False for the built-in circle. Route: {}').format(\n                            'COM' if is_com else 'DUCT', selected, pair.get('name', 'route'))\n    # Both custom profiles and generated circles follow the diameter inputs.\n    if any('com' not in str(pair.get('name', '')).lower() for pair in pairs):\n        if not is_finite_number(to_float(diameter_mm)) or to_float(diameter_mm) <= 0:\n            return 'ERROR: Set standard duct diameter (mm) to a positive size.'\n    # Validate the alternate settings before creating any routes.\n    if any('com' in str(pair.get('name', '')).lower() for pair in pairs):\n        if com_use_custom_profile:\n            if str(com_profile_path) != BUILT_IN_PROFILE and (not com_profile_path or not os.path.isfile(str(com_profile_path)) or not str(com_profile_path).lower().endswith('.rfa')):\n                return 'ERROR: Select an existing Com custom profile .rfa file.'\n        if not is_finite_number(to_float(com_diameter_mm)) or to_float(com_diameter_mm) <= 0:\n            return 'ERROR: Set Com duct diameter (mm) to a positive size, including when using a Com custom profile.'\n    saved = data, data2, global_origin_in, origin_unit_in\n    saved_profile = diameter_mm, use_custom_profile_in, profile_rfa_path_in\n    origin_note = 'Using the supplied horizontal origin; imported elevations retained relative to family Z=0 (Ref. Level).' \n    try:\n        if not use_true_coords and parse_global_origin(global_origin_in) is None:\n            # All routes must share one origin, not each move to its own zero.\n            table = pairs[0]['xy']\n            header_index = next(i for i,row in enumerate(table) if isinstance(row,list) and 'point index' in [str(x).strip().lower() for x in row])\n            headers = [str(x).strip().lower() for x in table[header_index]]\n            indices = [headers.index(k) for k in ('easting','northing','elevation')]\n            common = None\n            for row in table[header_index+1:]:\n                if len(row) <= max(indices):\n                    continue\n                values = [to_float(row[i]) for i in indices]\n                if all(is_finite_number(v) for v in values):\n                    common = [values[0], values[1], 0.0]\n                    break\n            if common is None:\n                return 'ERROR: Supply a common origin or include numeric XY elevations in the first report.'\n            global_origin_in = common\n            origin_unit_in = 'M'\n            origin_note = 'Shared horizontal origin (E,N metres): ' + str(common[:2]) + '; imported elevations retained relative to family Z=0 (Ref. Level).' \n        elif use_true_coords:\n            origin_note = 'Using true coordinates for all routes.'\n        results = []\n        for pair in pairs:\n            data, data2 = pair['xy'], pair['z']\n            is_com = 'com' in str(pair.get('name', '')).lower()\n            diameter_mm, use_custom_profile_in, profile_rfa_path_in = (\n                (com_diameter_mm, com_use_custom_profile, com_profile_path)\n                if is_com else saved_profile)\n            global current_route_is_com\n            current_route_is_com = is_com\n            message = execute_atomic()\n            message = ('[Com profile] ' if is_com else '[Standard profile] ') + str(message)\n            results.append({'route':pair['name'], 'folder':pair['folder'], 'result':message})\n        return [origin_note, results]\n    finally:\n        data, data2, global_origin_in, origin_unit_in = saved\n        diameter_mm, use_custom_profile_in, profile_rfa_path_in = saved_profile\n\nOUT = execute_batch_or_single()\n\n",
