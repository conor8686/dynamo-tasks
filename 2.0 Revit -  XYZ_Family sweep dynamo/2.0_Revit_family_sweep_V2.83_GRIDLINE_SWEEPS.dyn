    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# V2.59 - ONE CLICK: select XY + Z reports and return the ACTUAL TABLE DATA\n# Dynamo CPython3\nimport os\nimport io\nimport zipfile\nimport clr\nclr.AddReference(\"System.Windows.Forms\")\nfrom System.Windows.Forms import OpenFileDialog, DialogResult\n\n\ndef _readable_xlsx(path):\n    try:\n        with open(path, 'rb') as fh:\n            raw = fh.read()\n    except Exception:\n        return path\n    try:\n        z = zipfile.ZipFile(io.BytesIO(raw)); z.close()\n        return path\n    except zipfile.BadZipFile:\n        pass\n    sig = b'PK\\x05\\x06'\n    pos = 0\n    while True:\n        idx = raw.find(sig, pos)\n        if idx < 0 or idx + 22 > len(raw):\n            return path\n        comment_len = int.from_bytes(raw[idx+20:idx+22], 'little')\n        end = idx + 22 + comment_len\n        if end <= len(raw):\n            candidate = raw[:end]\n            try:\n                z = zipfile.ZipFile(io.BytesIO(candidate)); z.close()\n                return io.BytesIO(candidate)\n            except zipfile.BadZipFile:\n                pass\n        pos = idx + 4\n\n\ndef clean(v):\n    if v is None: return ''\n    return ' '.join(str(v).replace('\\xa0',' ').strip().lower().split())\n\n\ndef read_and_classify(path):\n    import openpyxl\n    src = _readable_xlsx(path)\n    wb = openpyxl.load_workbook(src, read_only=True, data_only=True)\n    best_xy = None\n    best_z = None\n    for ws in wb.worksheets:\n        rows = [list(r) for r in ws.iter_rows(values_only=True)]\n        for i, row in enumerate(rows[:60]):\n            h = [clean(x) for x in row]\n            hs = set(h)\n            # Project Explorer Calculated Stations\n            xy_score = 0\n            if 'point index' in hs: xy_score += 5\n            if 'station' in hs: xy_score += 3\n            if 'easting' in hs and 'northing' in hs: xy_score += 5\n            if 'alignment radius' in hs: xy_score += 3\n            if 'entity type' in hs: xy_score += 2\n            # Project Explorer Layout Profile Entities\n            z_score = 0\n            if 'entity index' in hs: z_score += 5\n            if 'start station' in hs and 'end station' in hs: z_score += 5\n            if 'start elevation' in hs and 'end elevation' in hs: z_score += 6\n            if 'entity type' in hs: z_score += 2\n            if 'curve radius' in hs: z_score += 2\n            if xy_score >= 13 and (best_xy is None or xy_score > best_xy[0]):\n                best_xy = (xy_score, rows)\n            if z_score >= 16 and (best_z is None or z_score > best_z[0]):\n                best_z = (z_score, rows)\n    wb.close()\n    return (best_xy[1] if best_xy else None, best_z[1] if best_z else None)\n\n\n\nimport json\n\ndef pair_files(files):\n    pairs = {}\n    for path in files:\n        stem = os.path.splitext(os.path.basename(path))[0]\n        low = stem.lower()\n        role = 'xy' if low.endswith('xy') else 'z' if low.endswith('z') else None\n        if role is None:\n            raise ValueError('Report filename must end in xy.xlsx or z.xlsx: ' + os.path.basename(path))\n        base = stem[:-len(role)]\n        key = (os.path.normcase(os.path.abspath(os.path.dirname(path))), base.lower())\n        pair = pairs.setdefault(key, {'name':base, 'folder':os.path.dirname(path)})\n        if role in pair:\n            raise ValueError('Duplicate ' + role.upper() + ' report for ' + base)\n        pair[role] = path\n    if not pairs:\n        raise ValueError('No report pairs selected')\n    for pair in pairs.values():\n        if 'xy' not in pair or 'z' not in pair:\n            raise ValueError('Select both XY and Z reports for ' + pair['name'])\n    return [pairs[key] for key in sorted(pairs)]\n\ndlg = OpenFileDialog()\ndlg.Title = 'Select ALL XY and Z reports - one matching pair per route'\ndlg.Filter = 'Excel workbooks (*.xlsx)|*.xlsx'\ndlg.Multiselect = True\npacket = {'batch_version':1, 'pairs':[]}\ntry:\n    if dlg.ShowDialog() != DialogResult.OK:\n        raise ValueError('File selection cancelled; no sweeps created')\n    for pair in pair_files(list(dlg.FileNames)):\n        xy, unused = read_and_classify(pair['xy'])\n        unused, z = read_and_classify(pair['z'])\n        if xy is None or z is None:\n            raise ValueError('Required XY/Z headers not found for ' + pair['name'])\n        packet['pairs'].append({'name':pair['name'], 'folder':pair['folder'], 'xy':xy, 'z':z})\nexcept Exception as ex:\n    packet = {'batch_version':1, 'error':str(ex), 'pairs':[]}\n# JSON protects nested rows from Dynamo list marshalling/stringification.\nOUT = (json.dumps(packet, ensure_ascii=True, default=str), None)\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "b9afa52dd16c4351ac31effad3803dbc",
      "NodeType": "PythonScriptNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "bb70e30a51344c95bbca9f65a4b3bed4",
          "Name": "XY_Data",
          "Description": "Batch of named XY/Z report pairs",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "f01b805fa69b42cb8b364b8b627a296c",
          "Name": "Z_Data",
          "Description": "Unused in batch mode",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\nclr.AddReference('RevitAPI')\nclr.AddReference('RevitServices')\nfrom Autodesk.Revit.DB import *\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\nimport math\n\ndoc = DocumentManager.Instance.CurrentDBDocument\nshow_marker = bool(IN[0]) if IN else True\n\ndef update_origin_marker(family_doc, visible):\n    manager = family_doc.FamilyManager\n    parameter_name = 'Show Origin Marker'\n    parameter = next((p for p in manager.Parameters if p.Definition.Name == parameter_name), None)\n    if parameter is None:\n        parameter = manager.AddParameter(parameter_name, GroupTypeId.Visibility, SpecTypeId.Boolean.YesNo, True)\n    elif parameter.Definition.GetDataType() != SpecTypeId.Boolean.YesNo:\n        raise ValueError('Show Origin Marker already exists but is not a Yes/No parameter.')\n    category = family_doc.OwnerFamily.FamilyCategory\n    category_name = 'MWP Origin Marker 0-0-0'\n    subcategory = next((c for c in category.SubCategories if c.Name == category_name), None)\n    if subcategory is None:\n        subcategory = family_doc.Settings.Categories.NewSubcategory(category, category_name)\n        subcategory.SetLineWeight(3, GraphicsStyleType.Projection)\n    style = subcategory.GetGraphicsStyle(GraphicsStyleType.Projection)\n    existing = []\n    for curve in FilteredElementCollector(family_doc).OfClass(CurveElement):\n        if isinstance(curve, SymbolicCurve) and curve.LineStyle is not None and curve.LineStyle.Id == style.Id:\n            existing.append(curve)\n    if not existing:\n        sketch = SketchPlane.Create(family_doc, Plane.CreateByNormalAndOrigin(XYZ.BasisZ, XYZ.Zero))\n        half = 500.0 / 304.8\n        radius = 200.0 / 304.8\n        geometry = [\n            Line.CreateBound(XYZ(-half,0,0), XYZ(half,0,0)),\n            Line.CreateBound(XYZ(0,-half,0), XYZ(0,half,0)),\n            Arc.Create(XYZ.Zero,radius,0.0,math.pi,XYZ.BasisX,XYZ.BasisY),\n            Arc.Create(XYZ.Zero,radius,math.pi,2*math.pi,XYZ.BasisX,XYZ.BasisY)\n        ]\n        for shape in geometry:\n            curve = family_doc.FamilyCreate.NewSymbolicCurve(shape, sketch)\n            curve.LineStyle = style\n            visibility = curve.GetVisibility()\n            visibility.IsShownInCoarse = True\n            visibility.IsShownInMedium = True\n            visibility.IsShownInFine = True\n            curve.SetVisibility(visibility)\n            existing.append(curve)\n    for curve in existing:\n        element_parameter = curve.get_Parameter(BuiltInParameter.IS_VISIBLE_PARAM)\n        if element_parameter is None or not manager.CanElementParameterBeAssociated(element_parameter):\n            raise ValueError('The origin marker visibility cannot be associated in this family.')\n        manager.AssociateElementParameterToFamilyParameter(element_parameter, parameter)\n    original_type = manager.CurrentType\n    if original_type is None:\n        original_type = manager.NewType('Default')\n    try:\n        for family_type in manager.Types:\n            manager.CurrentType = family_type\n            manager.Set(parameter, 1 if visible else 0)\n    finally:\n        manager.CurrentType = original_type\n    family_doc.Regenerate()\n    return 'Origin marker at (0,0,0): {}. Cross centre is the alignment point. Visibility: Show Origin Marker.'.format('ON' if visible else 'OFF')\n\ndef run_marker():\n    if doc is None or not doc.IsFamilyDocument:\n        return 'ERROR: Open the sweep family in Family Editor to create the origin marker.'\n    sub = None\n    try:\n        TransactionManager.Instance.EnsureInTransaction(doc)\n        sub = SubTransaction(doc)\n        sub.Start()\n        result = update_origin_marker(doc, show_marker)\n        if sub.Commit() != TransactionStatus.Committed:\n            raise RuntimeError('Marker changes were not committed.')\n        return result\n    except Exception as ex:\n        if sub is not None and sub.GetStatus() == TransactionStatus.Started:\n            sub.RollBack()\n        return 'ERROR: Origin marker was not updated: ' + str(ex)\n    finally:\n        TransactionManager.Instance.TransactionTaskDone()\n\nOUT = run_marker()\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "5756bb7a31f74c1387e74a217b62d676",
      "NodeType": "PythonScriptNode",
