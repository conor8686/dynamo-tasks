    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nclr.AddReference('RevitAPI')\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\nfrom Autodesk.Revit.DB import *\r\nimport os\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# --- Inputs ---\r\nfolder_path = IN[0] if len(IN) > 0 else None      # Folder containing .rfa profile families\r\noverwrite_existing = IN[1] if len(IN) > 1 else False  # Reload+overwrite if a family with the same name already exists\r\n\r\nresults = []  # one status string per file, in the order processed\r\nloaded_names = []\r\nfailed_names = []\r\n\r\n\r\nif not doc.IsFamilyDocument:\r\n    OUT = \"ERROR: Open a Family Editor document before running this script.\"\r\nelif not folder_path:\r\n    OUT = \"ERROR: No folder path supplied in IN[0].\"\r\nelif not os.path.isdir(str(folder_path)):\r\n    OUT = \"ERROR: '{}' is not a valid folder.\".format(folder_path)\r\nelse:\r\n    folder_path = str(folder_path)\r\n    rfa_files = sorted(\r\n        f for f in os.listdir(folder_path)\r\n        if f.lower().endswith('.rfa') and not f.startswith('~')\r\n    )\r\n\r\n    if not rfa_files:\r\n        OUT = \"No .rfa files found in '{}'.\".format(folder_path)\r\n    else:\r\n        TransactionManager.Instance.EnsureInTransaction(doc)\r\n        try:\r\n            for fname in rfa_files:\r\n                full_path = os.path.join(folder_path, fname)\r\n                family_name = os.path.splitext(fname)[0]\r\n\r\n                already_loaded = any(\r\n                    fam.Name == family_name\r\n                    for fam in FilteredElementCollector(doc).OfClass(Family)\r\n                )\r\n                if already_loaded and not overwrite_existing:\r\n                    results.append(\"{} - skipped (already loaded)\".format(fname))\r\n                    loaded_names.append(family_name)\r\n                    continue\r\n\r\n                try:\r\n                    raw_result = doc.LoadFamily(full_path)\r\n                    if isinstance(raw_result, tuple):\r\n                        loaded_ok = raw_result[0]\r\n                        loaded_family = raw_result[1] if len(raw_result) > 1 else None\r\n                    else:\r\n                        loaded_ok = bool(raw_result)\r\n                        loaded_family = None\r\n                    if loaded_ok and loaded_family is None:\r\n                        # CPython3's LoadFamily(path) overload only returns the bool, not\r\n                        # the Family object, so look up the family Revit just loaded by name.\r\n                        _fam_name = os.path.splitext(os.path.basename(str(full_path)))[0]\r\n                        for _fam in FilteredElementCollector(doc).OfClass(Family):\r\n                            if _fam.Name == _fam_name:\r\n                                loaded_family = _fam\r\n                                break\r\n                    if loaded_ok and loaded_family is not None:\r\n                        results.append(\"{} - loaded OK\".format(fname))\r\n                        loaded_names.append(loaded_family.Name)\r\n                    else:\r\n                        results.append(\"{} - LoadFamily returned false\".format(fname))\r\n                        failed_names.append(fname)\r\n                except Exception as ex:\r\n                    results.append(\"{} - FAILED: {}\".format(fname, str(ex)))\r\n                    failed_names.append(fname)\r\n        finally:\r\n            TransactionManager.Instance.TransactionTaskDone()\r\n\r\n        summary = \"Loaded {}/{} profile families from '{}'.\".format(\r\n            len(loaded_names), len(rfa_files), folder_path\r\n        )\r\n        if failed_names:\r\n            summary += \" Failed: {}\".format(\", \".join(failed_names))\r\n\r\n        OUT = [summary, results, loaded_names]",
      "Engine": "CPython3",
