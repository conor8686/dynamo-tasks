      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "CoreNodeModels.Watch, CoreNodeModels",
      "WatchWidth": 200.0,
      "WatchHeight": 250.0,
      "Id": "f44b2a444f8b4d07a37f5ac4f0fae93d",
      "NodeType": "ExtensionNode",
      "Inputs": [
        {
          "Id": "1540c3918bf24f3db08cfd5fb7c90830",
          "Name": "",
          "Description": "Input",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "215af2e1ea2e4cacb2f17753568648b6",
