{
  "Uuid": "61080772-deb9-43f6-a2fc-897653314c9d",
  "IsCustomNode": false,
  "Description": "Run the graph, pick any georeferenced TIF in the Open dialog, confirm the coordinate check, and the image is attached in Civil 3D at true position and scale (metres).",
  "Name": "C10.0 Civil3D_Attach_Image_Exact_Scale_V28",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [
