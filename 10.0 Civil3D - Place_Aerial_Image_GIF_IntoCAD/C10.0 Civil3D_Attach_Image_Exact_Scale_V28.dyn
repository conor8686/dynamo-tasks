      ],
      "Replication": "Disabled",
      "Description": "Visualizes a node's output"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Shows a coordinate-check message in Civil 3D, then (on Yes) hands the SCRIPT\r\n# command to the Civil 3D window via a Windows WM_COPYDATA message (no .NET).\r\n# IN[0] = output list from the \"Write .scr\" node\r\nimport os\r\nimport ctypes\r\nfrom ctypes import wintypes\r\n\r\nuser32 = ctypes.windll.user32\r\nlines = [str(l) for l in (IN[0] if isinstance(IN[0], list) else [IN[0]])]\r\ntag = 'SCRIPT CREATED: '\r\nscr = None\r\nfor l in lines:\r\n    if l.startswith(tag):\r\n        scr = l[len(tag):]\r\n\r\nMB_OK, MB_YESNO, IDYES = 0x0, 0x4, 6\r\nICON_ERR, ICON_Q, ICON_WARN, ICON_INFO = 0x10, 0x20, 0x30, 0x40\r\nTOP = 0x40000 | 0x10000  # MB_TOPMOST | MB_SETFOREGROUND - never hidden behind windows\r\n\r\n\r\nclass COPYDATASTRUCT(ctypes.Structure):\r\n    _fields_ = [('dwData', ctypes.c_size_t),\r\n                ('cbData', wintypes.DWORD),\r\n                ('lpData', ctypes.c_void_p)]\r\n\r\n\r\ndef find_cad_window():\r\n    pid = os.getpid()\r\n    found = []\r\n    PROC = ctypes.WINFUNCTYPE(wintypes.BOOL, wintypes.HWND, wintypes.LPARAM)\r\n\r\n    def cb(hwnd, lparam):\r\n        p = wintypes.DWORD()\r\n        user32.GetWindowThreadProcessId(hwnd, ctypes.byref(p))\r\n        if p.value == pid and user32.IsWindowVisible(hwnd) and not user32.GetWindow(hwnd, 4):\r\n            n = user32.GetWindowTextLengthW(hwnd)\r\n            buf = ctypes.create_unicode_buffer(n + 1)\r\n            user32.GetWindowTextW(hwnd, buf, n + 1)\r\n            t = buf.value\r\n            if 'Dynamo' not in t and ('Autodesk' in t or 'Civil 3D' in t or 'AutoCAD' in t):\r\n                found.append((hwnd, t))\r\n        return True\r\n\r\n    user32.EnumWindows(PROC(cb), 0)\r\n    return found[0] if found else (None, None)\r\n\r\n\r\ndef msg(text, title, flags, owner=None):\r\n    return user32.MessageBoxW(owner, text, title, flags | TOP)\r\n\r\n\r\ndef send(hwnd, text):\r\n    buf = ctypes.create_unicode_buffer(text)\r\n    cds = COPYDATASTRUCT(1, ctypes.sizeof(buf), ctypes.cast(buf, ctypes.c_void_p))\r\n    res = ctypes.c_size_t()\r\n    user32.SendMessageTimeoutW.argtypes = [wintypes.HWND, wintypes.UINT, wintypes.WPARAM,\r\n                                           wintypes.LPARAM, wintypes.UINT, wintypes.UINT,\r\n                                           ctypes.POINTER(ctypes.c_size_t)]\r\n    return bool(user32.SendMessageTimeoutW(hwnd, 0x004A, 0, ctypes.addressof(cds),\r\n                                           0x0002, 3000, ctypes.byref(res)))\r\n\r\n\r\ndef run():\r\n    hwnd, title = find_cad_window()\r\n    report = '\\n'.join(l for l in lines if not l.startswith(tag)\r\n                       and not l.startswith('Node 2') and not l.startswith('Running it'))\r\n    name = 'TIF coordinate check'\r\n\r\n    if any(l.startswith('CANCELLED') for l in lines):\r\n        return 'Cancelled - no TIF selected.'\r\n\r\n    if any(l.startswith('ERROR') for l in lines):\r\n        msg('This TIF can NOT be attached at real coordinates.\\n\\n' + report,\r\n            name + ' - FAILED', MB_OK | ICON_ERR, hwnd)\r\n        return 'Check failed - see message.'\r\n\r\n    warned = any('WARNING' in l for l in lines)\r\n    if not scr:\r\n        msg(report, name, MB_OK | (ICON_WARN if warned else ICON_INFO), hwnd)\r\n        return 'Checked only (Create = False).'\r\n\r\n    head = ('Coordinates found, but check the warnings below.\\n\\n' if warned\r\n            else 'The TIF is coordinated.\\n\\n')\r\n    if msg(head + report + '\\n\\nAttach it to the drawing now?', name,\r\n           MB_YESNO | (ICON_WARN if warned else ICON_Q), hwnd) != IDYES:\r\n        return 'Cancelled - nothing attached. Script kept: ' + scr\r\n\r\n    if not hwnd:\r\n        return 'Could not find the Civil 3D window. Run it by hand: SCRIPT > ' + scr\r\n    if send(hwnd, '(command \"_.SCRIPT\" \"{}\")\\n'.format(scr.replace('\\\\', '/'))):\r\n        return 'Sent to ' + title + ' - the image attaches when this run finishes.'\r\n    return 'Civil 3D did not accept the message. Run it by hand: SCRIPT > ' + scr\r\n\r\n\r\ntry:\r\n    OUT = run()\r\nexcept Exception as ex:\r\n    OUT = 'Auto-run failed ({}). Run it by hand: SCRIPT > {}'.format(ex, scr)\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "af33018d73b5411e95320278b20102a2",
      "NodeType": "PythonScriptNode",
      "Inputs": [
