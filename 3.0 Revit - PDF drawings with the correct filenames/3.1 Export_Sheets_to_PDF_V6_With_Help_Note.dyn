{
  "Uuid": "ac0c2432-136d-4aba-84ef-e6cb0115aee0",
  "IsCustomNode": false,
  "Description": "HELP - EXPORT SELECTED SHEETS TO PDF\n\n1. Click RUN.\n2. Select the Revit sheets you want to export.\n3. Click Continue.\n4. Choose the folder where the PDF files will be saved.\n5. The selected sheets will export automatically.\n\nIf you cancel the sheet selection or folder selection, no PDFs will be exported.",
  "Name": "Export_Sheets_to_PDF",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "CoreNodeModels.Input.StringInput, CoreNodeModels",
      "Id": "9ed853994b154c1cb7a91c7b1a2997b6",
      "NodeType": "StringInputNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "70eee7c160d54b329c6c014d9c3ecc1f",
          "Name": "",
          "Description": "String",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Creates a string",
      "InputValue": "{SheetNumber}_{SheetName}_{Revision}"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\nclr.AddReference('RevitAPI')\nclr.AddReference('RevitServices')\nclr.AddReference('System.Windows.Forms')\n\nfrom Autodesk.Revit.DB import *\nfrom RevitServices.Persistence import DocumentManager\nfrom System.Collections.Generic import List\nimport System.Windows.Forms as WinForms\nimport re\n\ndoc = DocumentManager.Instance.CurrentDBDocument\n\nexport_folder = None\nname_pattern  = IN[1]      # e.g. \"{SheetNumber}_{SheetName}_{Revision}\"\n\nimport System\n\ndef sanitize(text):\n    return re.sub(r'[\\\\/:*?\"<>|]', '-', text)\n\ndef clean_separators(text):\n    # collapse runs of separator-like characters (space, underscore, hyphen)\n    # left behind by empty tokens (e.g. blank Revision) into a single one\n    text = re.sub(r'[ _\\\\-]{2,}', lambda m: m.group(0)[0], text)\n    # trim leading/trailing separators\n    return text.strip(' _-')\n\n# Sheets to export come from IN[2] (output of the sheet-selection node)\nsheets = IN[2]\n\nresults = []\nerrors = []\n\n# Ask for destination only after sheets have been selected.\nif sheets:\n    folder_dialog = WinForms.FolderBrowserDialog()\n    folder_dialog.Description = \"Select folder to save exported PDF sheets\"\n    folder_dialog.ShowNewFolderButton = True\n    folder_result = folder_dialog.ShowDialog()\n    if folder_result == WinForms.DialogResult.OK and folder_dialog.SelectedPath:\n        export_folder = folder_dialog.SelectedPath\n        if not System.IO.Directory.Exists(export_folder):\n            System.IO.Directory.CreateDirectory(export_folder)\n    else:\n        errors.append(\"Export cancelled - no save folder selected.\")\n\nif not sheets:\n    errors.append(\"No sheets selected (dialog cancelled or nothing checked).\")\nelif not export_folder:\n    pass\nelse:\n    options = PDFExportOptions()\n    options.Combine = True  # required so FileName is actually used per sheet\n\n    for sheet in sheets:\n        try:\n            # Dynamo may wrap ViewSheet objects when passing between Python nodes.\n            # Convert the selected item back to the native Autodesk.Revit.DB.ViewSheet.\n            native_sheet = sheet\n            try:\n                native_sheet = UnwrapElement(sheet)\n            except:\n                pass\n\n            # Extra fallback for wrappers that UnwrapElement does not resolve.\n            if not isinstance(native_sheet, ViewSheet):\n                try:\n                    sid = sheet.Id\n                    if isinstance(sid, ElementId):\n                        native_sheet = doc.GetElement(sid)\n                    else:\n                        native_sheet = doc.GetElement(ElementId(int(sid)))\n                except:\n                    native_sheet = None\n\n            if native_sheet is None or not isinstance(native_sheet, ViewSheet):\n                raise Exception(\"Selected sheet could not be converted to a native Revit ViewSheet\")\n\n            number = native_sheet.SheetNumber\n            name = native_sheet.Name\n            rev_param = native_sheet.get_Parameter(BuiltInParameter.SHEET_CURRENT_REVISION)\n            revision = rev_param.AsString() if rev_param else \"\"\n            revision = revision or \"\"\n\n            filename = name_pattern\n            filename = filename.replace(\"{SheetNumber}\", number)\n            filename = filename.replace(\"{SheetName}\", name)\n            filename = filename.replace(\"{Revision}\", revision)\n            filename = clean_separators(filename)\n            filename = sanitize(filename)\n\n            options.FileName = filename\n            view_ids = List[ElementId]()\n            view_ids.Add(native_sheet.Id)\n\n            doc.Export(export_folder, view_ids, options)\n            results.append(filename + \".pdf\")\n        except Exception as e:\n            errors.append(\"{0}: {1}\".format(getattr(sheet, \"SheetNumber\", \"Sheet\"), str(e)))\n\nOUT = results, errors\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "38993d0893fe444bb7e9f13e13668bcb",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "25473174d5a941549c04a9e232930f52",
          "Name": "IN[0]",
          "Description": "Input #0",
