      "Description": "Visualizes a node's output"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\nclr.AddReference('RevitAPI')\nclr.AddReference('RevitServices')\nclr.AddReference('System.Windows.Forms')\nclr.AddReference('System.Drawing')\n\nfrom Autodesk.Revit.DB import *\nfrom RevitServices.Persistence import DocumentManager\nimport System.Windows.Forms as WinForms\n\ndoc = DocumentManager.Instance.CurrentDBDocument\n\ncollector = FilteredElementCollector(doc).OfClass(ViewSheet)\nsheets = sorted([s for s in collector if not s.IsPlaceholder], key=lambda s: s.SheetNumber)\n\nform = WinForms.Form()\nform.Text = \"Select Sheets to Export\"\nform.Width = 560\nform.Height = 640\nform.StartPosition = WinForms.FormStartPosition.CenterScreen\nform.TopMost = True\n\nlabel = WinForms.Label()\nlabel.Text = \"Tick the sheets to export, then click Continue.\"\nlabel.Left = 10\nlabel.Top = 10\nlabel.Width = 510\nform.Controls.Add(label)\n\nchecklist = WinForms.CheckedListBox()\nchecklist.Left = 10\nchecklist.Top = 35\nchecklist.Width = 520\nchecklist.Height = 500\nchecklist.CheckOnClick = True\nfor s in sheets:\n    checklist.Items.Add(\"{0} - {1}\".format(s.SheetNumber, s.Name), True)\nform.Controls.Add(checklist)\n\nbtn_ok = WinForms.Button()\nbtn_ok.Text = \"Continue\"\nbtn_ok.Left = 340\nbtn_ok.Top = 545\nbtn_ok.Width = 90\nbtn_ok.DialogResult = WinForms.DialogResult.OK\nform.Controls.Add(btn_ok)\n\nbtn_cancel = WinForms.Button()\nbtn_cancel.Text = \"Cancel\"\nbtn_cancel.Left = 440\nbtn_cancel.Top = 545\nbtn_cancel.Width = 90\nbtn_cancel.DialogResult = WinForms.DialogResult.Cancel\nform.Controls.Add(btn_cancel)\n\n# Native dialog results avoid Python click-handler delegates in CPython3.\nbtn_uncheck = WinForms.Button()\nbtn_uncheck.Text = \"Uncheck All\"\nbtn_uncheck.Left = 10\nbtn_uncheck.Top = 545\nbtn_uncheck.Width = 100\nbtn_uncheck.DialogResult = WinForms.DialogResult.Retry\nform.Controls.Add(btn_uncheck)\n\nbtn_check = WinForms.Button()\nbtn_check.Text = \"Check All\"\nbtn_check.Left = 120\nbtn_check.Top = 545\nbtn_check.Width = 100\nbtn_check.DialogResult = WinForms.DialogResult.Ignore\nform.Controls.Add(btn_check)\n\nform.AcceptButton = btn_ok\nform.CancelButton = btn_cancel\n# Redisplay the same form after bulk selection, retaining all sheet states.\nwhile True:\n    form.DialogResult = getattr(WinForms.DialogResult, \"None\")\n    result = form.ShowDialog()\n    if result == WinForms.DialogResult.Retry or result == WinForms.DialogResult.Ignore:\n        checked = result == WinForms.DialogResult.Ignore\n        checklist.BeginUpdate()\n        try:\n            for i in range(checklist.Items.Count):\n                checklist.SetItemChecked(i, checked)\n        finally:\n            checklist.EndUpdate()\n    else:\n        break\n\nselected_sheets = []\n\nif result == WinForms.DialogResult.OK:\n    for i in range(checklist.Items.Count):\n        if checklist.GetItemChecked(i):\n            selected_sheets.append(sheets[i])\n\nOUT = selected_sheets\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "2d77d9149b1f4eacac7116e6171c1549",
      "NodeType": "PythonScriptNode",
      "Inputs": [],
