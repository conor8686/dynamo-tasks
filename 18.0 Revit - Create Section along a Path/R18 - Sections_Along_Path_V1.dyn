    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "\"\"\"Revit Dynamo CPython3. IN: curves (model lines/arcs, one connected path), spacing m, width m, half height m, section depth m, create.\"\"\"\nimport clr\nclr.AddReference('RevitAPI')\nclr.AddReference('RevitServices')\nclr.AddReference('RevitNodes')\nimport Revit\nclr.ImportExtensions(Revit.Elements)\nfrom Autodesk.Revit.DB import *\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\n\nM = 1.0 / 0.3048  # metres -> feet\n\ndef raw(e):\n    return e.InternalElement if hasattr(e, 'InternalElement') else e\n\ndef run():\n    items = IN[0] if isinstance(IN[0], list) else [IN[0]]\n    spacing, width, half_h, depth, create = IN[1], IN[2], IN[3], IN[4], IN[5]\n    if not create:\n        return 'READY - set Create to True and Run'\n    doc = DocumentManager.Instance.CurrentDBDocument\n    curves = [raw(e).GeometryCurve for e in items]\n    # order the curves end-to-start into one chain\n    tol = 0.01\n    def same(a, b):\n        return a.DistanceTo(b) < tol\n    chain = [curves.pop(0)]\n    while curves:\n        hit = False\n        for c in list(curves):\n            if same(chain[-1].GetEndPoint(1), c.GetEndPoint(0)):\n                chain.append(c); curves.remove(c); hit = True; break\n            if same(chain[-1].GetEndPoint(1), c.GetEndPoint(1)):\n                chain.append(c.CreateReversed()); curves.remove(c); hit = True; break\n            if same(chain[0].GetEndPoint(0), c.GetEndPoint(1)):\n                chain.insert(0, c); curves.remove(c); hit = True; break\n            if same(chain[0].GetEndPoint(0), c.GetEndPoint(0)):\n                chain.insert(0, c.CreateReversed()); curves.remove(c); hit = True; break\n        if not hit:\n            return 'ERROR - curves are not one connected path'\n    lens = [c.Length for c in chain]\n    total = sum(lens)\n    step = spacing * M\n    stations = []\n    s = 0.0\n    while s < total - 1e-6:\n        stations.append(s)\n        s += step\n    stations.append(total)\n    vft = [v for v in FilteredElementCollector(doc).OfClass(ViewFamilyType) if v.ViewFamily == ViewFamily.Section][0]\n    existing = set(v.Name for v in FilteredElementCollector(doc).OfClass(View))\n    made = []\n    TransactionManager.Instance.EnsureInTransaction(doc)\n    for st in stations:\n        acc = 0.0\n        u = 1.0\n        c = chain[-1]\n        for cc, l in zip(chain, lens):\n            if st <= acc + l + 1e-9:\n                c = cc\n                u = min(max((st - acc) / l, 0.0), 1.0)\n                break\n            acc += l\n        d = c.ComputeDerivatives(u, True)\n        tg = XYZ(d.BasisX.X, d.BasisX.Y, 0).Normalize()\n        tr = Transform.Identity\n        tr.Origin = d.Origin\n        tr.BasisZ = tg.Negate()\n        tr.BasisY = XYZ.BasisZ\n        tr.BasisX = XYZ.BasisZ.CrossProduct(tg.Negate())\n        bb = BoundingBoxXYZ()\n        bb.Transform = tr\n        bb.Min = XYZ(-width * M / 2.0, -half_h * M, 0)\n        bb.Max = XYZ(width * M / 2.0, half_h * M, depth * M)\n        v = ViewSection.CreateSection(doc, vft.Id, bb)\n        nm = 'PATH SEC %05.1f m' % (st / M)\n        while nm in existing:\n            nm += ' (2)'\n        v.Name = nm\n        existing.add(nm)\n        made.append(nm)\n    TransactionManager.Instance.TransactionTaskDone()\n    return made\n\nOUT = run()\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "3faad5c83d5149c4847f96daa4a0bd9f",
      "NodeType": "PythonScriptNode",
