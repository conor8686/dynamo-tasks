    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\n# Import Revit API\r\nclr.AddReference(\"RevitAPI\")\r\nfrom Autodesk.Revit.DB import *\r\n\r\n# Import Revit Services\r\nclr.AddReference(\"RevitServices\")\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# Target Level Type name to check/create\r\ntarget_type_name = \"MWP_Circle Head - Survey point\"\r\nsymbol_at_end_1 = IN[0] if IN[0] is not None else True  # Default to True/Checked\r\n\r\n# Fetch all LevelTypes in the project\r\nlevel_types = FilteredElementCollector(doc).OfClass(LevelType).ToElements()\r\n\r\n# Helper function to get Element Name across Python versions\r\ndef get_elem_name(elem):\r\n    param = elem.get_Parameter(BuiltInParameter.SYMBOL_NAME_PARAM)\r\n    if param and param.HasValue:\r\n        return param.AsString()\r\n    try:\r\n        return elem.get_Name()\r\n    except AttributeError:\r\n        return str(elem.Name)\r\n\r\n# Check if target LevelType already exists\r\nexisting_type = None\r\nfor ltype in level_types:\r\n    if get_elem_name(ltype) == target_type_name:\r\n        existing_type = ltype\r\n        break\r\n\r\n# Start Revit Transaction\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nout_message = \"\"\r\n\r\nif existing_type:\r\n    target_type = existing_type\r\n    out_message = f\"Level Type '{target_type_name}' already exists.\"\r\nelse:\r\n    # Duplicate the first available Level Type as a template\r\n    template_type = level_types[0]\r\n    target_type = template_type.Duplicate(target_type_name)\r\n    out_message = f\"Level Type '{target_type_name}' created successfully.\"\r\n\r\n# --- Apply Type Properties ---\r\n\r\n# 1. Set \"Symbol at End 1 Default\"\r\nparam_end1 = target_type.get_Parameter(BuiltInParameter.DATUM_BUBBLE_END_1)\r\nif not param_end1:\r\n    param_end1 = target_type.LookupParameter(\"Symbol at End 1 Default\")\r\n\r\nif param_end1 and not param_end1.IsReadOnly:\r\n    param_end1.Set(1 if symbol_at_end_1 else 0)\r\n\r\n# 2. Set \"Elevation Base\" to Survey Point\r\nparam_base = target_type.get_Parameter(BuiltInParameter.LEVEL_RELATIVE_BASE_TYPE)\r\nif not param_base:\r\n    param_base = target_type.LookupParameter(\"Elevation Base\")\r\n\r\nif param_base and not param_base.IsReadOnly:\r\n    # 0 = Project Base Point, 1 = Survey Point, 2 = Internal Origin\r\n    param_base.Set(1)\r\n\r\n# Commit Transaction\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\n# Return result message and element\r\nOUT = [out_message, target_type]",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "a8149a7acd1a405d8dc0f310079c3319",
      "NodeType": "PythonScriptNode",
