    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "\"\"\"\r\nDynamo Python Script node\r\nSets the Survey Point's N/S, E/W, Elevation, and Angle to True North.\r\n\r\nInputs (IN):\r\n  IN[0] = North/South offset, in meters\r\n  IN[1] = East/West offset, in meters\r\n  IN[2] = Elevation, in meters\r\n  IN[3] = Angle to True North, in degrees\r\n\r\nUses RevitServices.TransactionManager instead of a raw Transaction object,\r\nbecause Dynamo already wraps Python Script nodes in its own transaction -\r\nstarting a second Transaction manually throws:\r\n  \"InvalidOperationException: Starting a new transaction is not permitted.\"\r\n\"\"\"\r\n\r\nimport math\r\nimport clr\r\n\r\nclr.AddReference(\"RevitServices\")\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\nclr.AddReference(\"RevitAPI\")\r\nfrom Autodesk.Revit.DB import *\r\n\r\n# Inputs (Convert Meters to Feet - Revit's internal length unit)\r\nns_feet = float(IN[0]) / 0.3048\r\new_feet = float(IN[1]) / 0.3048\r\nelev_feet = float(IN[2]) / 0.3048\r\nangle_deg = float(IN[3])\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# 1. Find the Survey Point\r\ncollector = FilteredElementCollector(doc).OfClass(BasePoint)\r\nsurvey_point = next((bp for bp in collector if bp.IsShared), None)\r\n\r\nif survey_point is None:\r\n    OUT = \"Survey Point not found.\"\r\nelse:\r\n    TransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\n    try:\r\n        # Unpin & Unclip\r\n        if survey_point.Pinned:\r\n            survey_point.Pinned = False\r\n        survey_point.Clipped = False\r\n\r\n        # Force position back to Internal Origin (0,0,0)\r\n        pos = survey_point.Position\r\n        if not pos.IsAlmostEqualTo(XYZ.Zero):\r\n            ElementTransformUtils.MoveElement(doc, survey_point.Id, XYZ.Zero.Subtract(pos))\r\n\r\n        # True North Rotation Angle (Radians)\r\n        normalized_angle = angle_deg % 360.0\r\n        revit_angle_deg = (360.0 - normalized_angle) if normalized_angle != 0 else 0.0\r\n        angle_rad = math.radians(revit_angle_deg)\r\n\r\n        # 2. Direct Parameter Updates\r\n        param_map = {\r\n            BuiltInParameter.BASEPOINT_NORTHSOUTH_PARAM: ns_feet,\r\n            BuiltInParameter.BASEPOINT_EASTWEST_PARAM: ew_feet,\r\n            BuiltInParameter.BASEPOINT_ELEVATION_PARAM: elev_feet,\r\n            BuiltInParameter.BASEPOINT_ANGLETON_PARAM: angle_rad\r\n        }\r\n\r\n        for builtin_param, value in param_map.items():\r\n            p = survey_point.get_Parameter(builtin_param)\r\n            if p and not p.IsReadOnly:\r\n                p.Set(value)\r\n\r\n        # Re-clip and Re-pin\r\n        survey_point.Clipped = True\r\n        survey_point.Pinned = True\r\n\r\n        # 3. Regenerate WHILE transaction is active\r\n        doc.Regenerate()\r\n\r\n        OUT = \"Survey Point coordinates updated.\"\r\n\r\n    except Exception as e:\r\n        OUT = \"Failed to update Survey Point: {}\".format(e)\r\n\r\n    finally:\r\n        # Commits on success, rolls back cleanly on failure - either way\r\n        # Dynamo's transaction is closed out properly for the next run.\r\n        TransactionManager.Instance.TransactionTaskDone()\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "f5586fd554ac499892da6cce85a3b0a1",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "d7f85db5056140568ac282d2439a2e39",
          "Name": "YN",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "01bc149b5c0d4fc4b6080beccf516fc2",
          "Name": "XE",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "a212e75589dd4762a608415b11e20e91",
          "Name": "ELV",
