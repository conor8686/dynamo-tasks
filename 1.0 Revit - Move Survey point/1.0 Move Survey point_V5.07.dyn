    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "\"\"\"\r\nDynamo Python Script Node\r\nSets Revit Project Units -> Length -> Meters, 3 decimal places, symbol \"m\"\r\n\r\nUsage in Dynamo:\r\n1. IN[0]: Document (Optional - defaults to Active Document if unwired/null).\r\n2. IN[1]: Boolean toggle (True to run, False to skip).\r\n3. Run the graph.\r\n\r\nCompatible Engine: IronPython 2 & CPython 3 (Revit 2021+)\r\n\"\"\"\r\n\r\nimport clr\r\n\r\nclr.AddReference('RevitAPI')\r\nclr.AddReference('RevitServices')\r\n\r\nfrom Autodesk.Revit.DB import FormatOptions, UnitTypeId, SymbolTypeId, SpecTypeId, ForgeTypeId\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\n# 1. Check Boolean Run Toggle (IN[1])\r\nrun_script = IN[1] if isinstance(IN, list) and len(IN) > 1 else True\r\n\r\nif not bool(run_script):\r\n    OUT = \"Script skipped (Boolean set to False).\"\r\nelse:\r\n    # 2. Resolve Input Document (IN[0] or Active Document fallback)\r\n    input_doc = IN[0] if isinstance(IN, list) and len(IN) > 0 and IN[0] is not None else None\r\n\r\n    if input_doc is not None:\r\n        doc = getattr(input_doc, \"InternalElement\", input_doc)\r\n    else:\r\n        doc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n    # 3. Modify Project Units within a Transaction\r\n    TransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\n    try:\r\n        units = doc.GetUnits()\r\n\r\n        # Create FormatOptions: Meters with 3 decimal places (Accuracy = 0.001)\r\n        format_options = FormatOptions(UnitTypeId.Meters)\r\n        format_options.Accuracy = 0.001\r\n\r\n        # Probe for the meter unit symbol (\"m\")\r\n        symbol_id = None\r\n        for candidate in [\"Meter\", \"Meters\", \"M\", \"MSup1\"]:\r\n            if hasattr(SymbolTypeId, candidate):\r\n                symbol_id = getattr(SymbolTypeId, candidate)\r\n                break\r\n\r\n        if symbol_id is not None:\r\n            format_options.SetSymbolTypeId(symbol_id)\r\n            symbol_note = \"Symbol set to 'm'.\"\r\n        else:\r\n            format_options.SetSymbolTypeId(ForgeTypeId())\r\n            symbol_note = \"No 'm' symbol constant found; symbol left default/blank.\"\r\n\r\n        # Zero-suppression formatting flags\r\n        format_options.SuppressTrailingZeros = False\r\n        format_options.SuppressLeadingZero = False\r\n\r\n        # Apply formatting to Length spec and commit to document\r\n        units.SetFormatOptions(SpecTypeId.Length, format_options)\r\n        doc.SetUnits(units)\r\n\r\n        OUT = \"Success: Project length units set to Meters (3 decimal places). \" + symbol_note\r\n\r\n    except Exception as e:\r\n        OUT = \"Failed to set units: {}\".format(str(e))\r\n\r\n    finally:\r\n        TransactionManager.Instance.TransactionTaskDone()",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "43677e2a57a24e6893a1cae5dfac656e",
      "NodeType": "PythonScriptNode",
