    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import math\r\nimport clr\r\n\r\n# Import Revit Services for Dynamo\r\nclr.AddReference(\"RevitServices\")\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\n# Import Revit API\r\nclr.AddReference(\"RevitAPI\")\r\nfrom Autodesk.Revit.DB import *\r\n\r\n# Inputs (Assume meters for N/S, E/W, Elev and degrees for Angle)\r\nns_meters = float(IN[0])\r\new_meters = float(IN[1])\r\nelev_meters = float(IN[2])\r\nangle_deg = float(IN[3])\r\n\r\n# 1. Convert length inputs from Meters to Internal Units (Feet)\r\nns = ns_meters / 0.3048\r\new = ew_meters / 0.3048\r\nelev = elev_meters / 0.3048\r\n\r\n# 2. Normalize and invert the angle for Revit's True North direction convention\r\n# (360 - angle resolves the 12.79 vs 347.21 degree rotational inversion)\r\nnormalized_angle = angle_deg % 360.0\r\nrevit_angle_deg = (360.0 - normalized_angle) if normalized_angle != 0 else 0.0\r\nangle_rad = math.radians(revit_angle_deg)\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# Find Survey Point using IsShared property\r\ncollector = FilteredElementCollector(doc).OfClass(BasePoint)\r\nsurvey_point = None\r\n\r\nfor bp in collector:\r\n    if bp.IsShared:\r\n        survey_point = bp\r\n        break\r\n\r\nif survey_point is None:\r\n    OUT = \"Survey Point not found.\"\r\nelse:\r\n    TransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\n    # Update Position via Active ProjectLocation\r\n    active_location = doc.ActiveProjectLocation\r\n    proj_position = active_location.GetProjectPosition(XYZ.Zero)\r\n\r\n    proj_position.NorthSouth = ns\r\n    proj_position.EastWest = ew\r\n    proj_position.Elevation = elev\r\n    proj_position.Angle = angle_rad\r\n\r\n    active_location.SetProjectPosition(XYZ.Zero, proj_position)\r\n\r\n    # Update parameter values directly on the Survey Point element\r\n    ns_param = survey_point.get_Parameter(BuiltInParameter.BASEPOINT_NORTHSOUTH_PARAM)\r\n    ew_param = survey_point.get_Parameter(BuiltInParameter.BASEPOINT_EASTWEST_PARAM)\r\n    elev_param = survey_point.get_Parameter(BuiltInParameter.BASEPOINT_ELEVATION_PARAM)\r\n    angle_param = survey_point.get_Parameter(BuiltInParameter.BASEPOINT_ANGLETON_PARAM)\r\n\r\n    if ns_param and not ns_param.IsReadOnly:\r\n        ns_param.Set(ns)\r\n    if ew_param and not ew_param.IsReadOnly:\r\n        ew_param.Set(ew)\r\n    if elev_param and not elev_param.IsReadOnly:\r\n        elev_param.Set(elev)\r\n    if angle_param and not angle_param.IsReadOnly:\r\n        angle_param.Set(angle_rad)\r\n\r\n    TransactionManager.Instance.TransactionTaskDone()\r\n\r\n    OUT = \"Survey Point updated successfully.\"",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "25d3aada2c004c2b8aa0464235171ad2",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "3aab40b261504f29b0346740a4b6f165",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
