        }
      ],
      "Replication": "Disabled",
      "Description": "Visualizes a node's output"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nimport os\r\n\r\n# Import Revit API\r\nclr.AddReference(\"RevitAPI\")\r\nfrom Autodesk.Revit.DB import *\r\n\r\n# Import Revit Services & Transaction Manager\r\nclr.AddReference(\"RevitServices\")\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\n# Host Document & App\r\nhost_doc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# Input: File Path string from IN[0]\r\nfile_path_str = IN[0]\r\n\r\noutput = {}\r\n\r\n# Validate IN[0]: must be a non-blank string, a .rvt file, and must exist on disk\r\nis_valid = False\r\nif file_path_str is None:\r\n    output[\"Error\"] = \"IN[0] is blank. Connect a File Path (string) to IN[0].\"\r\nelif not isinstance(file_path_str, str):\r\n    output[\"Error\"] = \"IN[0] is the wrong format. Expected a string file path, got: \" + str(type(file_path_str))\r\nelif not file_path_str.strip():\r\n    output[\"Error\"] = \"IN[0] is blank. Connect a File Path (string) to IN[0].\"\r\nelif not file_path_str.lower().endswith(\".rvt\"):\r\n    output[\"Error\"] = \"IN[0] must point to a .rvt file. Got: \" + file_path_str\r\nelif not os.path.isfile(file_path_str):\r\n    output[\"Error\"] = \"File not found on disk: \" + file_path_str\r\nelse:\r\n    is_valid = True\r\n\r\nif is_valid:\r\n    model_path = ModelPathUtils.ConvertUserVisiblePathToModelPath(file_path_str)\r\n\r\n    TransactionManager.Instance.EnsureInTransaction(host_doc)\r\n\r\n    try:\r\n        # 1. Create/Load the RevitLinkType\r\n        link_options = RevitLinkOptions(False)\r\n        link_type_result = RevitLinkType.Create(host_doc, model_path, link_options)\r\n        link_type_id = link_type_result.ElementId\r\n\r\n        # 2. Place a temporary RevitLinkInstance in the host document.\r\n        # RevitLinkInstance.Create only takes (Document, ElementId) - there is\r\n        # no ImportPlacement overload. That mismatched signature was the error.\r\n        link_instance = RevitLinkInstance.Create(host_doc, link_type_id)\r\n\r\n        # 3. Acquire shared coordinates from the linked file\r\n        host_doc.AcquireCoordinates(link_instance.Id)\r\n\r\n        # 4. Clean up - remove the temporary link instance and link type so you\r\n        # keep the acquired coordinate system without leaving a permanent link.\r\n        host_doc.Delete(link_instance.Id)\r\n        host_doc.Delete(link_type_id)\r\n\r\n        TransactionManager.Instance.TransactionTaskDone()\r\n\r\n        output[\"Status\"] = \"Coordinates successfully acquired from linked file!\"\r\n\r\n    except Exception as e:\r\n        TransactionManager.Instance.TransactionTaskDone()\r\n        output[\"Error\"] = \"Failed to create link or acquire coordinates: \" + str(e)\r\n\r\n# (if is_valid is False, output[\"Error\"] was already set by the checks above)\r\n\r\nOUT = output\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "7bad03328be9424092aa41d24c2fef9d",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "bfcf01c3a7b9419995fa2a19d699866f",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "40833e49ab1842ca8a7285ee68e57efa",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    }
