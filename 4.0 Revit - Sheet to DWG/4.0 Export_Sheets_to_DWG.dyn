{
  "Uuid": "0a9c8868-3b71-465e-863e-a533b27f0dd3",
  "IsCustomNode": false,
  "Description": "",
  "Name": "4.0 Export_Sheets_to_DWG",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\nclr.AddReference('RevitAPI')\nclr.AddReference('RevitServices')\nclr.AddReference('System.Windows.Forms')\nclr.AddReference('System.Drawing')\n\nimport os\nimport Autodesk.Revit.DB as DB\nfrom RevitServices.Persistence import DocumentManager\nfrom System.Collections.Generic import List\nfrom System.Windows.Forms import Form, CheckedListBox, Button, FormStartPosition, DockStyle, DialogResult, FolderBrowserDialog, FlowLayoutPanel\n\ndoc = DocumentManager.Instance.CurrentDBDocument\n\nall_sheets = list(DB.FilteredElementCollector(doc).OfClass(DB.ViewSheet).ToElements())\nall_sheets.sort(key=lambda s: s.SheetNumber)\nlabels = [\"%s - %s\" % (s.SheetNumber, s.Name) for s in all_sheets]\n\n# --- Window 1: pick sheets ---\nsheet_form = Form()\nsheet_form.Text = \"Select sheets to export to DWG\"\nsheet_form.Width = 480\nsheet_form.Height = 560\nsheet_form.StartPosition = FormStartPosition.CenterScreen\nsheet_form.TopMost = True\n\nclb = CheckedListBox()\nclb.Dock = DockStyle.Top\nclb.Height = 420\nclb.CheckOnClick = True\nfor lbl in labels:\n    clb.Items.Add(lbl)\nsheet_form.Controls.Add(clb)\n\n# DialogResult on the button closes the form without needing a Python\n# event-handler delegate (Dynamo's CPython3/pythonnet engine cannot build\n# one at runtime - it throws \"Constructor on type 'TypeBuilder' not found\").\nnext_btn = Button()\nnext_btn.Text = \"Next: Choose Save Folder\"\nnext_btn.Dock = DockStyle.Bottom\nnext_btn.Height = 40\nnext_btn.DialogResult = DialogResult.OK\nsheet_form.Controls.Add(next_btn)\nsheet_form.AcceptButton = next_btn\n\n# Native dialog results avoid Python event delegates in CPython3/pythonnet.\n# Bulk actions return to this loop and redisplay the same form and checklist.\nselection_buttons = FlowLayoutPanel()\nselection_buttons.Dock = DockStyle.Bottom\nselection_buttons.Height = 36\n\nuncheck_btn = Button()\nuncheck_btn.Text = \"Uncheck All\"\nuncheck_btn.Width = 110\nuncheck_btn.DialogResult = DialogResult.Retry\nselection_buttons.Controls.Add(uncheck_btn)\n\ncheck_btn = Button()\ncheck_btn.Text = \"Check All\"\ncheck_btn.Width = 110\ncheck_btn.DialogResult = DialogResult.Ignore\nselection_buttons.Controls.Add(check_btn)\n\ncancel_btn = Button()\ncancel_btn.Text = \"Cancel\"\ncancel_btn.Width = 110\ncancel_btn.DialogResult = DialogResult.Cancel\nselection_buttons.Controls.Add(cancel_btn)\nsheet_form.Controls.Add(selection_buttons)\nsheet_form.CancelButton = cancel_btn\n\nwhile True:\n    sheet_form.DialogResult = getattr(DialogResult, \"None\")\n    sheet_dialog_result = sheet_form.ShowDialog()\n    if sheet_dialog_result == DialogResult.Retry or sheet_dialog_result == DialogResult.Ignore:\n        checked = sheet_dialog_result == DialogResult.Ignore\n        clb.BeginUpdate()\n        try:\n            for i in range(clb.Items.Count):\n                clb.SetItemChecked(i, checked)\n        finally:\n            clb.EndUpdate()\n    else:\n        break\n\nresults = []\nif sheet_dialog_result != DialogResult.OK:\n    results = [\"Cancelled - no sheets exported\"]\nelse:\n    chosen_sheets = [all_sheets[i] for i in list(clb.CheckedIndices)]\n\n    if len(chosen_sheets) == 0:\n        results = [\"No sheets checked - nothing exported\"]\n    else:\n        # --- Window 2: pick save folder ---\n        folder_dialog = FolderBrowserDialog()\n        folder_dialog.Description = \"Choose folder to save the DWG files\"\n        folder_dialog.ShowNewFolderButton = True\n\n        folder_dialog_result = folder_dialog.ShowDialog()\n        folder = folder_dialog.SelectedPath\n\n        # FolderBrowserDialog can return DialogResult.OK with an empty\n        # SelectedPath if OK is clicked without ever highlighting a folder\n        # node in the tree - guard against that and against a folder that\n        # no longer exists (create it) before handing the path to Export.\n        folder_ok = False\n        if folder_dialog_result != DialogResult.OK or not folder:\n            results = [\"Cancelled - no folder chosen, no sheets exported\"]\n        elif os.path.isdir(folder):\n            folder_ok = True\n        else:\n            try:\n                os.makedirs(folder)\n                folder_ok = True\n            except Exception as e:\n                results = [\"Could not use folder '%s': %s\" % (folder, e)]\n\n        if folder_ok:\n            opts = DB.DWGExportOptions()\n            opts.TargetUnit = DB.ExportUnit.Millimeter\n            opts.SharedCoords = False\n            opts.MergedViews = True\n            opts.FileVersion = DB.ACADVersion.Default\n\n            invalid_chars = '\\\\/:*?\"<>|'\n\n            for s in chosen_sheets:\n                ids = List[DB.ElementId]([s.Id])\n                safe_name = \"\".join(c for c in s.Name if c not in invalid_chars)\n                fname = \"%s - %s\" % (s.SheetNumber, safe_name)\n                ok = doc.Export(folder, fname, ids, opts)\n                results.append(\"%s -> %s\" % (fname, ok))\n\nOUT = results",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
