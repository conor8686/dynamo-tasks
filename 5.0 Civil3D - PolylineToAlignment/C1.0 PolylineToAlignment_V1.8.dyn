  "Description": "Cleaned Polyline-to-Alignment Dynamo graph for Civil 3D.",
  "Name": "C1.0 PolylineToAlignment V1.8 MAJOR7 MINOR1 SAFE",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [
    {
      "Id": "80487ed9d66f4c4c9379f7a59690519f",
      "Name": "Major_Chainage_Style",
