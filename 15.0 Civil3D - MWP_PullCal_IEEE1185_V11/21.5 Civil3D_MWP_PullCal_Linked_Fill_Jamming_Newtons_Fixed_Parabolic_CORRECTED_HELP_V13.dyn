          "Name": "T1",
          "Description": "T1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "94c693e033df48699eeceb601199ac1b",
          "Name": "W",
          "Description": "W",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "bb07fc3c85974a1c93bb9da340ccad58",
          "Name": "f",
          "Description": "f",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "27bf167d431f4dbb8158c66a63363f05",
          "Name": "R",
          "Description": "R",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "7428f66455b54ca7a23353252d33c01a",
          "Name": "theta",
          "Description": "theta = DSCore.Math.DegreesToRadians(angleDeg)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "f4046a302dbf4f0c9a2778965db79277",
          "Name": "valid",
          "Description": "valid = (((((T1 >= 0) && (W >= 0)) && (f >= 0)) && (R > 0)) && (angleDeg >= 0)) && (angleDeg <= 90)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "829f836a2843403dbb369fd77111ba31",
          "Name": "E",
          "Description": "E = DSCore.Math.Exp(f * theta)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "33dbba4c37ed48ca95d9ac0c31ebd84f",
          "Name": "s",
          "Description": "s = DSCore.Math.Sin(angleDeg)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "2d6333c2df3d4d5cbda640443f45f28f",
          "Name": "c",
          "Description": "c = DSCore.Math.Cos(angleDeg)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "db87eb4720ca43c99e88dc4e27708361",
          "Name": "B",
          "Description": "B = (W * R) / (1 + (f * f))",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "3452d959a45f483799a88301e60e71dc",
          "Name": "term1",
          "Description": "term1 = ((2 * f) * E) * s",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "92602f86c6bc4cdca829aab636de760b",
          "Name": "term2",
          "Description": "term2 = (1 - (f * f)) * (1 - (E * c))",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "c2a911e290f14d2bb9c34417aab27014",
          "Name": "C",
          "Description": "C = term1 + term2",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "7f9384e6158c40efbfe3b774ac191812",
          "Name": "rawT2",
          "Description": "rawT2 = (T1 * E) + (B * C)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "33c5bd0ab64d46e485fc985e948faf98",
          "Name": "formulaApplicable",
          "Description": "formulaApplicable = valid",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "f20ebeb1c8bf4cbda4d81a176c49eb14",
          "Name": "T2",
          "Description": "T2 = ((formulaApplicable && (rawT2 >= 0) ? rawT2 : null))",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "d182006c85824a17ad002c8f7ec2c4d1",
          "Name": "status",
          "Description": "status = ((valid ? (formulaApplicable ? (rawT2 >= 0 ? \"Taut solution\" : \"Loss of taut tension - use general solver\") : \"Contact branch not established - use V18\") : \"Invalid input\"))",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "// Inclination: +angleDeg to 0 degrees.\n// Circular bend in a vertical plane, constant R.\ntheta = Math.DegreesToRadians(angleDeg);\nvalid = T1 >= 0 && W >= 0 && f >= 0 && R > 0 && angleDeg >= 0 && angleDeg <= 90;\nE = Math.Exp(f * theta);\ns = Math.Sin(angleDeg);\nc = Math.Cos(angleDeg);\nB = W * R / (1 + f*f);\nterm1 = 2 * f * E * s;\nterm2 = (1 - f*f) * (1 - E*c);\nC = term1 + term2;\nrawT2 = T1 * E + B * C;\nformulaApplicable = valid;\nT2 = formulaApplicable && rawT2 >= 0 ? rawT2 : null;\nstatus = valid ? (formulaApplicable ? (rawT2 >= 0 ? \"Taut solution\" : \"Loss of taut tension - use general solver\") : \"Contact branch not established - use V18\") : \"Invalid input\";"
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "Id": "dcfc15276da34b67abbf3ec10fa1f4d2",
      "NodeType": "CodeBlockNode",
      "Inputs": [
        {
          "Id": "308d14fd3f05472484d6b3882e73aff0",
          "Name": "angleDeg",
          "Description": "angleDeg",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "40af7ebb661a4a24a611a38844ca4689",
          "Name": "T1",
          "Description": "T1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "f36c70e547b2410898903b5e997cb1ff",
          "Name": "W",
          "Description": "W",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "2b3145fe583144d49320eb6b74e02fc2",
          "Name": "f",
          "Description": "f",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "2c20d1d987b64e70b5134d60f4886066",
          "Name": "R",
          "Description": "R",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "3db1275e46c84d79a5b0d9d7f4f5f3a7",
          "Name": "theta",
          "Description": "theta = DSCore.Math.DegreesToRadians(angleDeg)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "81a977ebd0bf4a838a1022b41b8b6de9",
          "Name": "valid",
          "Description": "valid = (((((T1 >= 0) && (W >= 0)) && (f >= 0)) && (R > 0)) && (angleDeg >= 0)) && (angleDeg <= 360)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "e393e79dd9aa4ed8b11f2ff2257e6e80",
          "Name": "x",
          "Description": "x = f * theta",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "216dca880ce94e709e535dd40a087e86",
          "Name": "ePlus",
          "Description": "ePlus = DSCore.Math.Exp(x)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "4d76b58f5cc44efb8184edbd0475d55d",
          "Name": "eMinus",
          "Description": "eMinus = DSCore.Math.Exp(-x)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "d2cb93a05810414286d1fb849dc58b00",
          "Name": "coshValue",
          "Description": "coshValue = (ePlus + eMinus) / 2",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "aefd534c920f4b9aaf5620710744e2f3",
          "Name": "sinhValue",
          "Description": "sinhValue = (ePlus - eMinus) / 2",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "677cd9ab81454834a855159988282858",
          "Name": "WR",
          "Description": "WR = W * R",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "657a4ecaa682403195d6290fa8648bf2",
          "Name": "root",
          "Description": "root = DSCore.Math.Sqrt((T1 * T1) + (WR * WR))",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "3edde0e2b3b045b4a0978f213c87a4db",
          "Name": "rawT2",
          "Description": "rawT2 = (T1 * coshValue) + (sinhValue * root)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "e9d012ca990141a6a8b47324783fa463",
          "Name": "T2",
          "Description": "T2 = ((valid ? rawT2 : null))",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "070040933df643fc968d36348c63b6cc",
          "Name": "status",
          "Description": "status = ((valid ? \"Taut solution\" : \"Invalid input\"))",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "// Level circular bend in plan. No vertical rise or fall.\ntheta = Math.DegreesToRadians(angleDeg);\nvalid = T1 >= 0 && W >= 0 && f >= 0 && R > 0 && angleDeg >= 0 && angleDeg <= 360;\nx = f * theta;\nePlus = Math.Exp(x);\neMinus = Math.Exp(-x);\ncoshValue = (ePlus + eMinus) / 2;\nsinhValue = (ePlus - eMinus) / 2;\nWR = W * R;\nroot = Math.Sqrt(T1*T1 + WR*WR);\nrawT2 = T1*coshValue + sinhValue*root;\nT2 = valid ? rawT2 : null;\nstatus = valid ? \"Taut solution\" : \"Invalid input\";"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import math\nn,d,D,f=map(float,IN)\nif n<1 or n!=int(n) or d<=0 or D<=d or f<0:\n    raise ValueError('Use positive cable count and diameters, D>d, and nonnegative friction.')\nratio=D/d\nr=d/(D-d)\ntri=1/math.sqrt(1-r*r) if r<1 else None\ndiamond=1+2*r*r\ncradle=1+4*r*r/3\nproject_three=tri if ratio<=2.5 else (diamond if ratio<=3 else cradle)\nselected=1 if n==1 else (tri if n==2 else (project_three if n==3 else (diamond if n==4 else 1.4)))\nOUT=[['D/d',ratio],['d/(D-d)',r],['Triangular Wc = 1/sqrt(1-r^2)',tri],['Diamond Wc = 1+2r^2',diamond],['Cradled Wc = 1+(4/3)r^2',cradle],['Project three-cable ratio Wc',project_three],['Selected Wc',selected],[\"Effective friction f prime = Wc*f\",selected*f if selected is not None else None],['Conduit fill n*(d/D)^2',n*(d/D)**2]]\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "8109d536444e4bcaafff1f88c72f7060",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "0da8c1de3b8b4d30942209df3b6a68e1",
          "Name": "Cable_count",
