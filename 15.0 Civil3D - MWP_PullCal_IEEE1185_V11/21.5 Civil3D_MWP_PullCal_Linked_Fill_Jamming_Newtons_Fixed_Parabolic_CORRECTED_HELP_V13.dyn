        },
        {
          "Id": "2718c471a47b4628ac1ec348926fa434",
          "Name": "Min_bend_radius_installed_m",
          "Description": "Minimum installed (static) cable bending radius (m). 0 switches the check off.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "5dcca58889984094932832df4ee74ee8",
          "Name": "Grade_break_tolerance_deg",
          "Description": "Profile angle changes at or below this (degrees) are not counted as grade breaks. 0 counts every break.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "ef08098f385649588fc056df3e43ff07",
          "Name": "High_sidewall_friction_0_off",
          "Description": "Friction coefficient used for a whole section when the sidewall force at its start exceeds the threshold. 0 switches it off.",
          "UsingDefaultValue": false,
          "Level": 2,
