        },
        {
          "Id": "8da1bde799da4258b461768b0799c50c",
          "Name": "g",
          "Description": "g",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "d2a042a50a314d31977f7ba85dcbfac6",
          "Name": "mu",
          "Description": "mu",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "4d4ca4067157455dae75823474f687bd",
          "Name": "Wc",
          "Description": "Wc",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "8f735c968ef443369b326de7367eb4cb",
          "Name": "W",
          "Description": "W = (n * m) * g",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "dc9c6e2eb96d48938c2ea8aa33d97cbe",
          "Name": "f",
          "Description": "f = mu * Wc",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "// Total cable weight per metre, not mass.\nW = n * m * g;\n// Effective friction. Wc must suit the cable arrangement.\nf = mu * Wc;"
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "Id": "02e5eae91b9b421da4b8a22c4136cf31",
      "NodeType": "CodeBlockNode",
      "Inputs": [
        {
          "Id": "17219376f3de44f5a32ab261223050e6",
          "Name": "T1",
          "Description": "T1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "39f3a3c59d734b9192fbca63d3bd6a04",
          "Name": "W",
          "Description": "W",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "57fa3bc1dd3940039d50eb748bd28071",
          "Name": "f",
          "Description": "f",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "665f036a31c941f48b57b27e33229d18",
          "Name": "L",
          "Description": "L",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "f24a5f10ef3849bbaad58ee92a528c3b",
          "Name": "valid",
          "Description": "valid = (((T1 >= 0) && (W >= 0)) && (f >= 0)) && (L >= 0)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "56afb290c7b44654abdb03de2708dde8",
          "Name": "increment",
          "Description": "increment = (W * f) * L",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "c6ddcda6e2594f6e8710372de03dc36e",
          "Name": "rawT2",
          "Description": "rawT2 = T1 + increment",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "2d532d20e7dd4b8ca99844518d2e88b9",
          "Name": "T2",
          "Description": "T2 = ((valid && (rawT2 >= 0) ? rawT2 : null))",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "0d7d750bb9774011ab89add858bfec9b",
          "Name": "status",
          "Description": "status = ((valid ? (rawT2 >= 0 ? \"Taut solution\" : \"Loss of taut tension - use general solver\") : \"Invalid input\"))",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "// L is actual cable length along the section.\nvalid = T1 >= 0 && W >= 0 && f >= 0 && L >= 0;\nincrement = W * f * L;\nrawT2 = T1 + increment;\nT2 = valid && rawT2 >= 0 ? rawT2 : null;\nstatus = valid ? (rawT2 >= 0 ? \"Taut solution\" : \"Loss of taut tension - use general solver\") : \"Invalid input\";"
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "Id": "6f011f11e828463ab3c8431721f486cd",
