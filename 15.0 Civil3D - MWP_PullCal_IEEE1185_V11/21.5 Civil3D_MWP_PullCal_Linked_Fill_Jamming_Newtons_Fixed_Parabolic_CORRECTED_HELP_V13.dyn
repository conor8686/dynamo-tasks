        },
        {
          "Id": "a8bc466f826b41bf94539084ebf33948",
          "Name": "sinAngle",
          "Description": "sinAngle = DSCore.Math.Sin(angleDeg)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "9d3a59cb7e3c400eaf66a3114757d917",
          "Name": "frictionTerm",
          "Description": "frictionTerm = f * cosAngle",
