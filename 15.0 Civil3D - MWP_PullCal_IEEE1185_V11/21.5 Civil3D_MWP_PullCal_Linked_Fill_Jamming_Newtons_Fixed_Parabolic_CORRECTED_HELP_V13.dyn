        },
        {
          "Id": "870b113595dc481298343bf49e82c2f8",
          "Name": "W",
          "Description": "W",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "0ca5744b3367425c84527de14642e014",
          "Name": "sectionExit",
          "Description": "sectionExit",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "a745ce0a42774c1391bc2d59ecb1d475",
          "Name": "applicable",
          "Description": "applicable = (((Rh > 0) && (kv == 0)) && (angle > -1E-07)) && (angle < 1E-07)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "b49b3b6263c642f49da15b2874691f24",
          "Name": "safeRadius",
          "Description": "safeRadius = ((Rh == 0 ? 1 : Rh))",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "6764abc1f4e64959828f9bc06822ce6d",
          "Name": "thetaRadians",
          "Description": "thetaRadians = planLength / safeRadius",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "944cf482fd1747499a0b20f10f36585a",
          "Name": "ePlus",
          "Description": "ePlus = DSCore.Math.Exp(f * thetaRadians)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "8c35c10d0de24aada52df120ccf8cb60",
          "Name": "eMinus",
          "Description": "eMinus = DSCore.Math.Exp(0 - (f * thetaRadians))",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "f33e6fa88ff24afba54d3ea61649d962",
          "Name": "coshValue",
          "Description": "coshValue = (ePlus + eMinus) / 2",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "df700a5f7357405caad78a7878b2de45",
          "Name": "sinhValue",
          "Description": "sinhValue = (ePlus - eMinus) / 2",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "c47a1065fb73482aa1d636460fe96d66",
          "Name": "root",
          "Description": "root = DSCore.Math.Sqrt((T1 * T1) + ((W * Rh) * (W * Rh)))",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "0e410e28a03447b7b91e60608039a3a7",
          "Name": "T2check",
          "Description": "T2check = ((applicable ? (T1 * coshValue) + (sinhValue * root) : null))",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "596871f6d51c4b09a83ae3d3f649e46e",
          "Name": "sectionDifference",
          "Description": "sectionDifference = ((applicable ? T2check - sectionExit : null))",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "// Applicable only to a LEVEL plan bend, not inclined/compound curves.\napplicable = Rh > 0 && kv == 0 && angle > -0.0000001 && angle < 0.0000001;\nsafeRadius = Rh == 0 ? 1 : Rh;\nthetaRadians = planLength/safeRadius;\nePlus = Math.Exp(f*thetaRadians);\neMinus = Math.Exp(0-f*thetaRadians);\ncoshValue = (ePlus+eMinus)/2;\nsinhValue = (ePlus-eMinus)/2;\nroot = Math.Sqrt(T1*T1 + (W*Rh)*(W*Rh));\nT2check = applicable ? T1*coshValue+sinhValue*root : null;\nsectionDifference = applicable ? T2check-sectionExit : null;"
    },
