        },
        {
          "Id": "54fd1cddc27748eca73af2494a99be60",
          "Name": "Report in kg / kg per m",
          "Description": "False = N and N/m; True = kg and kg/m force equivalents using configured gravity. Original inputs and RK4 remain SI.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
