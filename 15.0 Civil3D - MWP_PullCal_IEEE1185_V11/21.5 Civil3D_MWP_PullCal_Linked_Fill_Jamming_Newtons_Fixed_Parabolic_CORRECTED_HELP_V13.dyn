    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import builtins\nimport clr\nkey = '_mwp_excel_export_folder_4bc7b98a_7fee_45b1_96c4_d8bd4f74bc0b'\nif bool(IN[0]):\n    clr.AddReference('System.Windows.Forms')\n    from System.Windows.Forms import FolderBrowserDialog, DialogResult\n    from System.Threading import Thread, ThreadStart, ApartmentState\n    response = {'folder': None, 'error': None}\n    def browse():\n        dialog = FolderBrowserDialog()\n        try:\n            dialog.Description = 'Select the folder for the new Excel pull calculation report'\n            dialog.ShowNewFolderButton = True\n            previous = getattr(builtins, key, '')\n            if previous:\n                dialog.SelectedPath = previous\n            if dialog.ShowDialog() == DialogResult.OK:\n                response['folder'] = str(dialog.SelectedPath)\n        except Exception as error:\n            response['error'] = str(error)\n        finally:\n            dialog.Dispose()\n    worker = Thread(ThreadStart(browse))\n    worker.SetApartmentState(ApartmentState.STA)\n    worker.Start()\n    worker.Join()\n    if response['error']:\n        raise ValueError(response['error'])\n    if response['folder'] is None:\n        raise ValueError('Export folder selection cancelled. No Excel report was exported.')\n    setattr(builtins, key, response['folder'])\nOUT = getattr(builtins, key, '')\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "4bc7b98a7fee45b196c4d8bd4f74bc0b",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "b03ed5702b3f4d42aa8fc2b603aa3385",
          "Name": "Browse_for_export_folder",
          "Description": "Set True to open the folder picker when Dynamo runs",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "4da2b5940ade4a998545d47b4ba1930c",
          "Name": "Excel_export_folder",
          "Description": "Folder path (blank uses template folder)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
