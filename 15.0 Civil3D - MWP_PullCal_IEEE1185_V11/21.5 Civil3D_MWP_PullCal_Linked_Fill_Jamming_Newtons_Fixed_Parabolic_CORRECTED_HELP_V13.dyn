    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import bisect, math, os, posixpath, re, zipfile, json\nimport xml.etree.ElementTree as ET\nfrom datetime import datetime\n\n\nSTATION_TOL = 1e-6\n\nDUPLICATE_POINT_TOL = 0.001\n\nPROFILE_JOIN_ELEV_TOL = 0.001\n\nENTITY_LENGTH_TOL = 0.001\n\nPLAN_CHORD_TOL = 0.002\n\nELEVATION_MATCH_TOL = 0.002\n\nFLAT_TOL = 1e-8\n\nFLAT_ANGLE_TOL = 1e-8\n\nLEVEL_POINT_MIN_GAP = 0.01\n\nSTATION_LOOKUP_NUDGE = 1e-8\n\nGRADE_BREAK_MIN_DEG = 0.01\n\nNS = 'http://schemas.openxmlformats.org/spreadsheetml/2006/main'\n\nREL = 'http://schemas.openxmlformats.org/officeDocument/2006/relationships'\n\ndef tag(name):\n    \"\"\"Full XML tag name in the spreadsheet namespace, e.g. tag('row').\"\"\"\n    return '{%s}%s' % (NS, name)\n\ndef col_number(label):\n    \"\"\"'A' -> 1, 'Z' -> 26, 'AA' -> 27.\"\"\"\n    value = 0\n    for char in label:\n        value = 26 * value + ord(char) - 64\n    return value\n\ndef col_label(number):\n    \"\"\"1 -> 'A', 26 -> 'Z', 27 -> 'AA'.\"\"\"\n    text = ''\n    while number:\n        number, rem = divmod(number - 1, 26)\n        text = chr(65 + rem) + text\n    return text\n\ndef sheet_paths(archive):\n    \"\"\"Map sheet name -> XML file path inside the .xlsx.\"\"\"\n    relations = ET.fromstring(archive.read('xl/_rels/workbook.xml.rels'))\n    links = {r.attrib['Id']: r.attrib['Target'] for r in relations}\n    workbook = ET.fromstring(archive.read('xl/workbook.xml'))\n    result = {}\n    for sheet in workbook.find(tag('sheets')):\n        target = links[sheet.attrib['{%s}id' % REL]]\n        if target.startswith('/'):\n            result[sheet.attrib['name']] = target.lstrip('/')\n        else:\n            result[sheet.attrib['name']] = posixpath.normpath('xl/' + target)\n    return result\n\ndef read_xlsx(path):\n    \"\"\"Read literal/cached cell values.\n\n    Returns {sheet name: list of rows}, each row a list of cell values.\n    Formulas without a cached value and Excel error cells are rejected.\n    \"\"\"\n    with zipfile.ZipFile(path) as archive:\n        shared_strings = []\n        if 'xl/sharedStrings.xml' in archive.namelist():\n            for item in ET.fromstring(archive.read('xl/sharedStrings.xml')):\n                shared_strings.append(''.join(n.text or '' for n in item.iter(tag('t'))))\n\n        result = {}\n        for name, target in sheet_paths(archive).items():\n            grid = []\n            for row in ET.fromstring(archive.read(target)).iter(tag('row')):\n                row_index = int(row.attrib['r'])\n                while len(grid) < row_index:\n                    grid.append([])\n                for cell in row:\n                    address = cell.attrib.get('r', '')\n                    if not address:\n                        continue\n                    col_index = col_number(re.match('[A-Z]+', address).group())\n                    while len(grid[row_index - 1]) < col_index:\n                        grid[row_index - 1].append(None)\n\n                    kind = cell.attrib.get('t')\n                    raw = cell.find(tag('v'))\n                    value = raw.text if raw is not None else None\n                    if cell.find(tag('f')) is not None and value is None:\n                        raise ValueError('Source formula has no cached value: %s!%s' % (name, address))\n\n                    if kind == 'inlineStr':\n                        value = ''.join(n.text or '' for n in cell.iter(tag('t')))\n                    elif kind == 's' and value is not None:\n                        value = shared_strings[int(value)]\n                    elif kind == 'b':\n                        value = value == '1'\n                    elif kind == 'e':\n                        raise ValueError('Source Excel error at %s!%s: %s' % (name, address, value))\n                    elif value is not None and kind not in ('str', 'd'):\n                        value = float(value)\n                    grid[row_index - 1][col_index - 1] = value\n            result[name] = grid\n        return result\n\ndef records(workbook, first_header):\n    \"\"\"Find the table whose first header cell is `first_header` and return its\n    numeric rows as dicts keyed by header name (plus '_excel_row').\"\"\"\n    for rows in workbook.values():\n        for index, row in enumerate(rows):\n            if row and row[0] == first_header:\n                headers = row\n                table = []\n                for excel_index, data in enumerate(rows[index + 1:], index + 1):\n                    if data and isinstance(data[0], (float, int)):\n                        padded = data + [None] * (len(headers) - len(data))\n                        table.append(dict(zip(headers, padded), _excel_row=excel_index + 1))\n                return table\n    raise ValueError('Missing report header: ' + first_header)\n\ndef finite(value, name):\n    if isinstance(value, (bool, str)) or value is None or not math.isfinite(value):\n        raise ValueError(name + ' must be a finite number.')\n    return float(value)\n\ndef radius(value):\n    \"\"\"Curve radius as a positive number, or None for a straight (Infinity/blank).\"\"\"\n    if value is None or str(value).lower() in ('infinity', 'inf', '-infinity'):\n        return None\n    value = finite(value, 'Curve radius')\n    if value == 0:\n        raise ValueError('Curve radius cannot be zero.')\n    return abs(value)\n\ndef profile_at(profile, station):\n    \"\"\"Elevation and slope angle (rad) of one profile entity at a station.\"\"\"\n    ds = station - profile['s0']\n    kv, a0 = profile['kv'], profile['a0']\n    if kv == 0:\n        return profile['z0'] + ds * math.tan(a0), a0\n    sine = max(-1.0, min(1.0, math.sin(a0) + kv * ds))\n    alpha = math.asin(sine)\n    elevation = profile['z0'] + (math.cos(a0) - math.cos(alpha)) / kv\n    return elevation, alpha\n\ndef read_plan_points(xy_rows, issues):\n    \"\"\"XY rows in station order; exact duplicates are merged.\"\"\"\n    points = []\n    for row in xy_rows:\n        station = finite(row['Station'], 'XY station')\n        for key in ('Easting', 'Northing', 'Elevation'):\n            finite(row[key], key)\n        if points and station < points[-1]['Station'] - STATION_TOL:\n            raise ValueError('XY stations are out of order.')\n        if points and abs(station - points[-1]['Station']) <= STATION_TOL:\n            old = points[-1]\n            difference = max(abs(row[k] - old[k]) for k in ('Easting', 'Northing', 'Elevation'))\n            if difference > DUPLICATE_POINT_TOL:\n                raise ValueError('Conflicting duplicate XY station.')\n            issues.append(['INFO', station, 'Duplicate XY station merged',\n                           'Rows %d and %d agree within 1 mm.' % (old['_excel_row'], row['_excel_row'])])\n            continue\n        points.append(row)\n    return points\n\ndef read_profile_entities(z_rows, issues):\n    \"\"\"Tangent / circular-curve profile entities with start/end angles.\"\"\"\n    profiles = []\n    for row in z_rows:\n        s0, s1 = row['Start Station'], row['End Station']\n        z0, z1 = row['Start Elevation'], row['End Elevation']\n        for value in (s0, s1, z0, z1):\n            finite(value, 'Profile coordinate')\n        if s1 <= s0:\n            raise ValueError('Profile stations must increase.')\n        if profiles:\n            previous = profiles[-1]\n            if abs(s0 - previous['s1']) > STATION_TOL or abs(z0 - previous['z1']) > PROFILE_JOIN_ELEV_TOL:\n                raise ValueError('Gap or overlap between profile entities.')\n\n        ds, dz = s1 - s0, z1 - z0\n        profile = dict(s0=s0, s1=s1, z0=z0, z1=z1, entity=int(row['Entity Index']),\n                       kind=row['Entity Type'], kv=0.0)\n\n        if row['Entity Type'] == 'Tangent':\n            profile['a0'] = profile['a1'] = math.atan2(dz, ds)\n\n        elif row['Entity Type'] == 'Circular Curve':\n            r = radius(row['Curve Radius'])\n            if r is None or row['Curve Type'] not in ('Sag', 'Crest'):\n                raise ValueError('Circular profile requires radius and Sag/Crest type.')\n            chord = math.hypot(ds, dz)\n            if chord > 2 * r:\n                raise ValueError('Profile chord exceeds its circle diameter.')\n            sign = 1 if row['Curve Type'] == 'Sag' else -1\n            delta = sign * 2 * math.asin(chord / (2 * r))       # total turn of the arc\n            chord_angle = math.atan2(dz, ds)\n            profile.update(a0=chord_angle - delta / 2, a1=chord_angle + delta / 2, kv=sign / r)\n            if max(abs(profile['a0']), abs(profile['a1'])) >= math.pi / 2:\n                raise ValueError('Profile arc is not single-valued in station.')\n\n        elif row['Entity Type'] == 'Parabolic Curve':\n            # Approximate the parabola by the circular arc with the same end points\n            # and the same total turn (from the gradients); sub-mm elevation difference.\n            g_in, g_out = row.get('Gradient In'), row.get('Gradient Out')\n            if g_in is None or g_out is None:\n                raise ValueError('Parabolic profile requires Gradient In/Out.')\n            delta = math.atan(finite(g_out, 'Gradient Out')) - math.atan(finite(g_in, 'Gradient In'))\n            chord = math.hypot(ds, dz)\n            chord_angle = math.atan2(dz, ds)\n            if abs(delta) < 1e-12:\n                profile['a0'] = profile['a1'] = chord_angle\n            else:\n                r = chord / (2 * math.sin(abs(delta) / 2))\n                profile.update(a0=chord_angle - delta / 2, a1=chord_angle + delta / 2,\n                               kv=(1 if delta > 0 else -1) / r)\n                if max(abs(profile['a0']), abs(profile['a1'])) >= math.pi / 2:\n                    raise ValueError('Profile arc is not single-valued in station.')\n            issues.append(['INFO', s0, 'Parabolic curve approximated by circular arc',\n                           'Entity %d: same end points and total turn (%.4f deg); equivalent R=%.2f m.'\n                           % (profile['entity'], math.degrees(delta), chord / abs(delta) if delta else 0.0)])\n\n        else:\n            raise ValueError('Unsupported profile entity: ' + str(row['Entity Type']))\n\n        profiles.append(profile)\n        if row.get('Length') is not None and abs(row['Length'] - ds) > ENTITY_LENGTH_TOL:\n            issues.append(['REVIEW', s0, 'Reported entity length differs from station span',\n                           'Entity %d: use endpoint stations; reported %.6f m versus %.6f m.'\n                           % (profile['entity'], row['Length'], ds)])\n    return profiles\n\ndef check_plan_chords(points):\n    \"\"\"Chord between exported points must match the alignment radius (unit check).\"\"\"\n    for first, last in zip(points, points[1:]):\n        ds = last['Station'] - first['Station']\n        rh = radius(first['Alignment Radius'])\n        expected = 2 * rh * math.sin(ds / (2 * rh)) if rh else ds\n        actual = math.hypot(last['Easting'] - first['Easting'], last['Northing'] - first['Northing'])\n        if abs(actual - expected) > PLAN_CHORD_TOL:\n            raise ValueError('Plan geometry/units mismatch near station %.6f.' % first['Station'])\n\ndef check_point_elevations(points, profiles, starts):\n    \"\"\"XY-report elevations must sit on the rebuilt profile.\"\"\"\n    for row in points:\n        index = bisect.bisect_right(starts, row['Station'] + STATION_LOOKUP_NUDGE) - 1\n        profile = profiles[min(len(profiles) - 1, max(0, index))]\n        expected, _ = profile_at(profile, row['Station'])\n        if abs(expected - row['Elevation']) > ELEVATION_MATCH_TOL:\n            raise ValueError('XY/Z elevation mismatch at station %.6f.' % row['Station'])\n\ndef segment_kind(rh, kv, z0, z1):\n    if rh and kv:\n        return 'Compound curve'\n    if rh:\n        return 'Horizontal curve'\n    if kv:\n        return 'Vertical curve'\n    if z1 > z0 + FLAT_TOL:\n        return 'Slope up'\n    if z1 < z0 - FLAT_TOL:\n        return 'Slope down'\n    return 'Straight'\n\ndef build_geometry(xy_book, z_book):\n    xy = records(xy_book, 'Point Index')\n    z = records(z_book, 'Entity Index')\n    issues = []\n\n    # Both reports must come from the same drawing and alignment.\n    header_xy = dict(xy_book.get('Report Header', []))\n    header_z = dict(z_book.get('Report Header', []))\n    for key in ('Drawing:', 'Parent Alignment:'):\n        if header_xy.get(key) != header_z.get(key):\n            raise ValueError('XY and Z reports disagree on ' + key)\n\n    points = read_plan_points(xy, issues)\n    profiles = read_profile_entities(z, issues)\n    if len(points) < 2 or not profiles:\n        raise ValueError('Insufficient profile data.')\n\n    check_plan_chords(points)\n    if (abs(points[0]['Station'] - profiles[0]['s0']) > STATION_TOL\n            or abs(points[-1]['Station'] - profiles[-1]['s1']) > STATION_TOL):\n        raise ValueError('XY and Z reports cover different station ranges.')\n    starts = [p['s0'] for p in profiles]\n    check_point_elevations(points, profiles, starts)\n\n    # Break the route at every XY point and every profile entity start/end.\n    # Also break vertical curves at their low/high point (slope = 0), so each\n    # piece is wholly Upward or Downward for the IEEE bend formulas.\n    level_points = []\n    for profile in profiles:\n        if profile['kv']:\n            s_level = profile['s0'] - math.sin(profile['a0']) / profile['kv']\n            if profile['s0'] + LEVEL_POINT_MIN_GAP < s_level < profile['s1'] - LEVEL_POINT_MIN_GAP:\n                level_points.append(s_level)\n    # XY points are only a break where the plan radius changes (start/end of a\n    # horizontal curve); points in the middle of a straight or curve are not.\n    plan_breaks = [points[0]['Station'], points[-1]['Station']]\n    for k in range(1, len(points) - 1):\n        if radius(points[k]['Alignment Radius']) != radius(points[k - 1]['Alignment Radius']):\n            plan_breaks.append(points[k]['Station'])\n    all_stations = sorted(plan_breaks + starts + [profiles[-1]['s1']] + level_points)\n    stations = []\n    for station in all_stations:\n        if not stations or station - stations[-1] > STATION_TOL:\n            if station in level_points and (station - stations[-1] < LEVEL_POINT_MIN_GAP):\n                continue                       # low/high point too close to another break\n            stations.append(station)\n    # drop a low/high point that sits just before the next real break\n    stations = [s for k, s in enumerate(stations)\n                if not (s in level_points and k + 1 < len(stations)\n                        and stations[k + 1] - s < LEVEL_POINT_MIN_GAP)]\n\n    # One segment between each pair of break stations.\n    segments = []\n    xstarts = [p['Station'] for p in points]\n    for s0, s1 in zip(stations, stations[1:]):\n        middle = (s0 + s1) / 2\n        profile = profiles[bisect.bisect_right(starts, middle) - 1]\n        xi = bisect.bisect_right(xstarts, middle) - 1\n        point, end = points[xi:xi + 2]\n        rh = radius(point['Alignment Radius'])\n        z0, a0 = profile_at(profile, s0)\n        z1, a1 = profile_at(profile, s1)\n        if profile['kv'] == 0:\n            length = (s1 - s0) / math.cos(a0)\n        else:\n            length = abs((a1 - a0) / profile['kv'])\n        heading = math.atan2(end['Easting'] - point['Easting'], end['Northing'] - point['Northing'])\n        segments.append(dict(id=len(segments) + 1, s0=s0, s1=s1, z0=z0, z1=z1, a0=a0, a1=a1,\n                             kv=profile['kv'], rh=rh, length=length,\n                             kind=segment_kind(rh, profile['kv'], z0, z1),\n                             entity=profile['entity'], heading=heading, joint_angle=0.0))\n\n    # Grade breaks: exported points split smooth circular entities. Only profile\n    # angle discontinuities have no resolved radius in these reports; alignment\n    # curves retain their radii.\n    for previous, following in zip(segments, segments[1:]):\n        angle = abs(following['a0'] - previous['a1'])\n        if angle > math.radians(GRADE_BREAK_MIN_DEG):\n            following['joint_angle'] = angle\n            issues.append(['REVIEW', following['s0'], 'Grade break has no bend radius',\n                           'Direction changes %.4f degrees. Tension uses a zero-length capstan '\n                           'estimate; joint SWBP is unavailable.' % math.degrees(angle)])\n\n    metadata = dict(header=header_xy, xy_rows=len(xy), unique_xy=len(points),\n                    profile_entities=len(z), source_xy=xy, source_z=z)\n    return segments, issues, metadata\n\ndef report_role(path):\n    \"\"\"'xy' or 'z' from the report contents, plus its header.\"\"\"\n    book = read_xlsx(path)\n    headers = [row for rows in book.values() for row in rows if row]\n    is_z = any(row[0] == 'Entity Index' for row in headers)\n    is_xy = any('Station' in row and 'Entity Index' not in row for row in headers)\n    if is_z == is_xy:\n        raise ValueError('Cannot identify report as XY or Z: ' + path)\n    return ('z' if is_z else 'xy'), dict(book.get('Report Header', []))\n\ndef _report_stem(path, role):\n    \"\"\"File name without the Civil 3D 'xy' / 'z' ending, used to pair reports.\"\"\"\n    stem = os.path.splitext(os.path.basename(path))[0]\n    stem = re.sub(r'[ _\\-]?%s$' % role, '', stem, flags=re.IGNORECASE)\n    return stem.strip(' _-').lower()\n\ndef resolve_profile_pairs(selected):\n    \"\"\"All selected reports -> [(xy_path, z_path, route name)], one pair per route.\n    Pairs by file name (Civil 3D '...xy.xlsx' / '...z.xlsx'); reports whose names\n    do not pair are matched by drawing path + parent alignment in the header.\"\"\"\n    import json\n    if not selected:\n        raise ValueError('Set Select both reports to True and Run; select the XY and Z Excel reports.')\n    text = str(selected)\n    paths = json.loads(text) if text.lstrip().startswith('[') else [text]\n    unique, seen = [], set()\n    for path in paths:\n        key = os.path.normcase(os.path.abspath(path))\n        if key not in seen:\n            seen.add(key)\n            unique.append(path)\n    if len(unique) < 2 or len(unique) % 2:\n        raise ValueError('Select an XY report AND a Z entity report for every route (%d files selected).'\n                         % len(unique))\n    info = []\n    for path in unique:\n        role, header = report_role(path)\n        info.append(dict(path=path, role=role, header=header, stem=_report_stem(path, role)))\n    xys = [i for i in info if i['role'] == 'xy']\n    zs = [i for i in info if i['role'] == 'z']\n    if len(xys) != len(zs):\n        raise ValueError('Select one XY and one Z report per route: %d XY and %d Z reports selected.'\n                         % (len(xys), len(zs)))\n    pairs = []\n    for xy in xys:                                        # 1) same file name apart from xy / z\n        match = [z for z in zs if z['stem'] == xy['stem']]\n        if len(match) == 1:\n            pairs.append((xy, match[0]))\n            zs.remove(match[0])\n            xy['paired'] = True\n    for xy in [x for x in xys if not x.get('paired')]:    # 2) same drawing + alignment\n        key = (xy['header'].get('Drawing Path:'), xy['header'].get('Parent Alignment:'))\n        match = [z for z in zs\n                 if (z['header'].get('Drawing Path:'), z['header'].get('Parent Alignment:')) == key]\n        if len(match) != 1:\n            raise ValueError('Cannot find the Z report for ' + os.path.basename(xy['path']))\n        pairs.append((xy, match[0]))\n        zs.remove(match[0])\n    return [(xy['path'], z['path'], xy['header'].get('Parent Alignment:') or xy['stem']) for xy, z in pairs]\n\ndef same_file(a, b):\n    return os.path.normcase(os.path.abspath(str(a))) == os.path.normcase(os.path.abspath(str(b)))\n\n\"\"\"V16 numerical engine. SI units; circular vertical-profile geometry.\n\nIEEE 1185-2019 supplies Wc and listed SWBP factors. General 3D integration\nis an engineering extension, not a claim that IEEE supplies a 3D equation.\nNo third-party packages are needed inside Dynamo.\n\"\"\"\nDEFAULTS = dict(cable_count=17, cable_mass_kg_m=.95, cable_diameter_mm=23.,\n    conduit_diameter_mm=160., friction=.2, gravity=9.8, initial_tension_N=1960.,\n    allowable_tension_N=30000., allowable_swbp_N_m=7000., allowable_fill=.4,\n    formation='fourcables', assumptions_confirmed=False, max_step_m=.05,\n    max_angle_step_deg=.25, manufacturer_swbp_factor=0.,\n    min_bend_install_m=2.907, min_bend_static_m=1.938, grade_break_tol_deg=0.3, friction_high=0., sidewall_threshold_N_m=2185., three_cable_formation_rule=0.)\nSETTING_KEYS=list(DEFAULTS)[:14]\nEXTRA_SETTINGS={}\nMETHOD=[\n ['Weight','W = n m g (N/m); effective friction f = mu Wc, no rounding.'],\n ['Cable factors','IEEE 1185-2019 clause 4.13, equations 14-18. Single Wc=1; two triangular; three project ratio rule; four diamond; >4 assumed 1.4.'],\n ['Three cables','Project three-cable Wc rule: D/d<=2.5 triangular; <=3 diamond expression; >3 cradled expression. Middle band is user supplied, not verified IEEE. SWBP follows selected maintained formation.'],\n ['SWBP','MWP PullCal_V9 reference: single c=1; trefoil c=Wc/2; cradled c=(3Wc-2)/3; diamond c=Wc-1; more than four cables c=1.0 (conservative, no IEEE factor). Positive manufacturer override takes priority. P=c*T*kappa, sampled along each bend.'],\n ['Force balance','dT/dl = f*sqrt((T*kh)^2 + (T*kv-W*cos(alpha))^2) + W*sin(alpha).'],\n ['Curvature','kh=cos(alpha)^2/Rplan; kv=dalpha/dl; kappa=sqrt(kh^2+kv^2).'],\n ['Integration','RK4, full and half step. Refine until exit and sampled peaks differ by <=0.01 N or N/m plus 1e-7 relative.'],\n ['Contact','Absolute resultant normal force handles floor/roof contact continuously. No slope substitution for sags.'],\n ['Unknown joint','Zero-length capstan tension estimate; SWBP unresolved without radius.'],\n ['Slack','If taut tension reaches zero and would become negative, stop that direction. Subsequent results unavailable; braking/contact model required.'],\n ['Scope','3D force balance is an engineering extension of the straight/level bend relationships, requiring project review.'],\n ['Reports','Live formulas on fixed exported mesh. Rerun Dynamo after input changes to recheck convergence.'],\n ['Allowable tension','Allowable pulling tension = number of cables x maximum tension per cable x tension reduction factor when a per-cable limit is entered (as ELEK Cable Pulling). With a per-cable limit of 0 the total allowable pulling tension input is used.'],\n ['Bend radius','Effective radius R = 1/sqrt((cos^2(a)/R_plan)^2 + kv^2) at the tightest point of each curved section, compared with the cable minimum bending radius during installation and installed (HV cable datasheet). Grade breaks with no radius cannot be verified and stay REVIEW.'],\n ['ELEK-style section list','Sheets \"R1 F list\" and \"R1 R list\" (and one pair per route) list every section in pull order with Type, Specification, Length, Tension at the end of the section, sidewall force and Pass/Fail, in the same layout as the ELEK Cable Pulling section list, for a line by line comparison.'],\n ['High sidewall friction','If a high sidewall friction coefficient is entered, a section uses it (instead of the normal friction) when the sidewall force at the start of that section exceeds the sidewall pressure threshold. 0 switches this off. This matches the way ELEK Cable Pulling applies its high sidewall pressure friction.'],\n ['Three-cable factor rule','0 keeps the project ratio rule for three cables (D/d up to 2.5 triangular, up to 3 middle band, above 3 cradled). 1 uses the standard factor for the selected formation: triangular 1/sqrt(1-r^2) for Trefoil, cradled 1+4r^2/3 for Cradled.'],\n ['Grade breaks','A profile angle change between two entities counts as a grade break with no radius only if it exceeds the grade break tolerance (default 0.3 deg). Smaller steps are the report writing a parabolic curve as a circular arc; a 0.3 deg step needs about 1.5 cm of curve at the 2.907 m cable minimum radius.'],\n ['Reference','https://standards.ieee.org/ieee/1185/6194/']]\n\ndef validate_settings(settings=None):\n    p=dict(DEFAULTS,**(settings or {}));p.update(EXTRA_SETTINGS)\n    for key in DEFAULTS:\n        if key in ('formation','assumptions_confirmed'):continue\n        p[key]=finite(p[key],key)\n        if p[key]<0 or (p[key]==0 and key not in ('friction','initial_tension_N','manufacturer_swbp_factor','min_bend_install_m','min_bend_static_m','grade_break_tol_deg','friction_high','sidewall_threshold_N_m','three_cable_formation_rule')):\n            raise ValueError(key+' is outside its valid range')\n    n=p['cable_count'];d=p['cable_diameter_mm'];D=p['conduit_diameter_mm'];form=p['formation']\n    if n!=int(n):raise ValueError('Cable count must be an integer')\n    if not isinstance(p['assumptions_confirmed'],bool):raise ValueError('Assumptions confirmed must be true/false')\n    if D<=d or p['allowable_fill']>1:raise ValueError('Invalid conduit diameter or fill fraction')\n    allowed={'Single':n==1,'Trefoil':n in (2,3),'Cradled':n==3,'Diamond':n==4,'fourcables':n>4}\n    if not allowed.get(form,False):raise ValueError('Cable formation does not match cable count')\n    fill=n*(d/D)**2\n    if fill>p['allowable_fill']:raise ValueError('Cable fill %.2f%% exceeds configured allowance %.2f%%'%(100*fill,100*p['allowable_fill']))\n    minimum={1:1.,2:2.,3:1+2/math.sqrt(3),4:1+math.sqrt(2)}\n    if D/d<minimum.get(n,1):raise ValueError('Cables cannot geometrically fit the conduit')\n    r=d/(D-d)\n    if n==1:wc=1.;config='Single'\n    elif n==2:wc=1/math.sqrt(1-r*r);config='Two cables'\n    elif n==3:\n        # Project-supplied ratio rule; the middle band is not claimed as IEEE verified.\n        wc=(1/math.sqrt(1-r*r) if form=='Trefoil' else 1+4*r*r/3) if p['three_cable_formation_rule']>=.5 else (1/math.sqrt(1-r*r) if D/d<=2.5 else (1+2*r*r if D/d<=3 else 1+4*r*r/3))\n        config='Cradled' if form=='Cradled' else 'Triangular'\n    elif n==4:wc=1+2*r*r;config='Diamond'\n    else:wc=1.4;config='More than four (assumed Wc=1.4)'\n    c=1. if (n==1 or n>4) else (wc/2 if n==2 or config=='Triangular' else ((3*wc-2)/3 if config=='Cradled' else wc-1))\n    if p['manufacturer_swbp_factor']>0:c=p['manufacturer_swbp_factor']\n    p.update(weight_correction=wc,effective_friction=p['friction']*wc,\n             weight_N_m=n*p['cable_mass_kg_m']*p['gravity'],fill=fill,configuration=config,swbp_factor=c)\n    return p\n\ndef contact_force(T,alpha,kv,rh,p):\n    kh=math.cos(alpha)**2/rh if rh else 0.\n    return math.hypot(T*kh,T*kv-p['weight_N_m']*math.cos(alpha))\n\ndef derivative(T,alpha,kv,rh,p):\n    return p['effective_friction']*contact_force(T,alpha,kv,rh,p)+p['weight_N_m']*math.sin(alpha)\n\ndef pressure(T,alpha,kv,rh,p):\n    if p['swbp_factor'] is None:return None\n    k=math.hypot(math.cos(alpha)**2/rh if rh else 0.,kv)\n    return p['swbp_factor']*T*k\n\ndef integrate(seg,T,alpha,p,steps):\n    h=seg['length']/steps;kv=seg['kv'];rh=seg['rh']\n    peak=T;peak_p=pressure(T,alpha,kv,rh,p);peak_at=0.\n    for j in range(steps):\n        a=alpha+kv*j*h\n        k1=derivative(T,a,kv,rh,p)\n        u=T+h*k1/2;k2=derivative(u,a+kv*h/2,kv,rh,p)\n        v=T+h*k2/2;k3=derivative(v,a+kv*h/2,kv,rh,p)\n        z=T+h*k3;k4=derivative(z,a+kv*h,kv,rh,p)\n        out=T+h*(k1+2*k2+2*k3+k4)/6\n        if not math.isfinite(out):raise ValueError('Tension overflow: review geometry/friction')\n        if min(T,u,v,z,out)<-1e-8:\n            return dict(final=None,peak=peak,swbp=peak_p,peak_at=peak_at,slack=True,steps=steps)\n        T=max(0.,out);peak=max(peak,T)\n        q=pressure(T,a+kv*h,kv,rh,p)\n        if q is not None and (peak_p is None or q>peak_p):peak_p=q;peak_at=(j+1)*h\n    return dict(final=T,peak=peak,swbp=peak_p,peak_at=peak_at,slack=False,steps=steps)\n\ndef integrate_checked(seg,T,alpha,p):\n    n=max(1,int(math.ceil(seg['length']/p['max_step_m'])),\n          int(math.ceil(abs(seg['kv']*seg['length'])/math.radians(p['max_angle_step_deg']))),\n          int(math.ceil(seg['length']/(seg['rh'] or 1e100)/math.radians(p['max_angle_step_deg']))))\n    coarse=integrate(seg,T,alpha,p,n)\n    for _ in range(9):\n        if n>500000:raise ValueError('Integration too large: review step size or split route')\n        fine=integrate(seg,T,alpha,p,n*2)\n        if fine['slack'] and coarse['slack']:\n            fine['error']=None;return fine\n        keys=('final','peak','swbp')\n        if not fine['slack'] and not coarse['slack']:\n            delta=[abs(fine[k]-coarse[k]) for k in keys if fine[k] is not None]\n            if all(abs(fine[k]-coarse[k])<=.01+1e-7*abs(fine[k]) for k in keys if fine[k] is not None):\n                fine['error']=max(delta,default=0.);return fine\n        coarse=fine;n*=2\n    raise ValueError('Integration did not converge; reduce step limits')\n\nHEAD=['Section','Type','Station in (m)','Station out (m)','Length (m)','Angle in (deg)',\n      'Angle out (deg)','Plan radius (m)','Profile radius (m)','T1 (N)','T2 (N)',\n      'Peak T (N)','Peak SWBP (N/m)','SWBP station (m)','Step comparison max difference',\n      'Tension check','SWBP check','Review']\n\ndef section_params(p,T,alpha,s):\n    \"\"\"High sidewall friction: the whole section uses it when the sidewall force at its entry exceeds the threshold.\"\"\"\n    if p['friction_high']>0 and T is not None and (s['kv'] or s['rh']):\n        q=pressure(T,alpha,s['kv'],s['rh'],p)\n        if q is not None and q>p['sidewall_threshold_N_m']:\n            return dict(p,friction=p['friction_high'],effective_friction=p['friction_high']*p['weight_correction'])\n    return p\n\ndef solve_direction(segments,p,reverse=False):\n    order=list(reversed(segments)) if reverse else segments\n    T=p['initial_tension_N'];rows=[];unresolved=0;slack=False;maxerr=0.;switched=0\n    for i,s in enumerate(order):\n        a,b=(-s['a1'],-s['a0']) if reverse else (s['a0'],s['a1'])\n        si,so=(s['s1'],s['s0']) if reverse else (s['s0'],s['s1'])\n        joint=(order[i-1]['joint_angle'] if i else 0.) if reverse else s['joint_angle']\n        unresolved+=bool(joint)\n        if slack:\n            rows.append([s['id'],s['kind'],si,so,s['length'],math.degrees(a),math.degrees(b),s['rh'],\n                         abs(1/s['kv']) if s['kv'] else None,None,None,None,None,None,None,\n                         'UNAVAILABLE','UNAVAILABLE','Upstream loss of taut tension'])\n            continue\n        if joint:T*=math.exp(p['effective_friction']*joint)\n        tin=T\n        ps=section_params(p,T,a,s);switched+=(ps is not p)\n        v=integrate_checked(s,T,a,ps);slack=v['slack'];T=v['final']\n        maxerr=max(maxerr,v['error'] or 0.)\n        distance=v['peak_at'];kv=s['kv']\n        ds=(math.sin(a+kv*distance)-math.sin(a))/kv if kv else distance*math.cos(a)\n        station=si-ds if reverse else si+ds\n        curved=bool(s['rh'] or kv)\n        swbp=v['swbp'] if curved else 0.\n        note='Loss of taut tension; direction stopped' if slack else ('Joint radius missing' if joint else '')\n        rows.append([s['id'],s['kind'],si,so,s['length'],math.degrees(a),math.degrees(b),s['rh'],\n                     abs(1/kv) if kv else None,tin,T,v['peak'],swbp,station if curved and swbp is not None else None,\n                     v['error'],'FAIL' if v['peak']>p['allowable_tension_N'] else ('REVIEW' if slack else 'WITHIN LIMIT'),\n                     'UNAVAILABLE' if swbp is None else ('FAIL' if swbp>p['allowable_swbp_N_m'] else 'WITHIN LIMIT'),note])\n    peak=max([p['initial_tension_N']]+[r[11] for r in rows if r[11] is not None])\n    pp=[r[12] for r in rows if r[12] is not None];peakp=max(pp) if pp else None\n    complete=not slack\n    pressure_complete=complete and not unresolved and all(r[12] is not None for r in rows)\n    tc='FAIL' if peak>p['allowable_tension_N'] else ('WITHIN LIMIT' if complete else 'UNAVAILABLE')\n    pc='FAIL' if peakp is not None and peakp>p['allowable_swbp_N_m'] else ('WITHIN LIMIT' if pressure_complete else 'UNAVAILABLE')\n    status='FAIL' if 'FAIL' in (tc,pc) else 'REVIEW REQUIRED'\n    return dict(rows=rows,final=T,peak=peak,swbp=peakp if pressure_complete else None,\n                known_swbp=peakp,joints=unresolved,slack=slack,error=maxerr,tension_check=tc,swbp_check=pc,status=status,switched=switched)\n\nBEND_HEAD=['Section','Type','Station in (m)','Station out (m)','Plan radius (m)','Profile radius (m)',\n           'Effective bend radius (m)','Min radius installation (m)','Margin installation (m)','Installation check',\n           'Min radius installed (m)','Margin installed (m)','Installed check']\n\ndef bend_radius_check(segments,p):\n    \"\"\"HV cable minimum bending radius check.\n\n    Effective radius is the reciprocal of the same curvature the force balance uses,\n    kappa = sqrt((cos(a)^2/R_plan)^2 + kv^2), taken at the tightest point of each\n    curved section. A limit of 0 switches that check off.\n    \"\"\"\n    mbr=p['min_bend_install_m'];mbs=p['min_bend_static_m'];rows=[];issues=[];smallest=None;where=None\n    for s in segments:\n        rh=s['rh'];kv=s['kv']\n        if not rh and not kv:continue\n        c2=max(math.cos(s['a0'])**2,math.cos(s['a1'])**2)\n        if s['a0']*s['a1']<0:c2=1.\n        kappa=math.hypot(c2/rh if rh else 0.,kv)\n        if not kappa:continue\n        reff=1/kappa\n        if smallest is None or reff<smallest:smallest=reff;where=s['s0']\n        pull='NOT CHECKED' if mbr<=0 else ('FAIL' if reff<mbr else 'WITHIN LIMIT')\n        inst='NOT CHECKED' if mbs<=0 else ('FAIL' if reff<mbs else 'WITHIN LIMIT')\n        rows.append([s['id'],s['kind'],s['s0'],s['s1'],rh,abs(1/kv) if kv else None,reff,\n                     mbr if mbr>0 else None,reff-mbr if mbr>0 else None,pull,\n                     mbs if mbs>0 else None,reff-mbs if mbs>0 else None,inst])\n        if pull=='FAIL':\n            issues.append(['FAIL',s['s0'],'Bend radius below cable minimum (installation)',\n                           'Section %d (%s): effective radius %.3f m is below the %.3f m minimum bending radius during installation.'%(s['id'],s['kind'],reff,mbr)])\n        elif inst=='FAIL':\n            issues.append(['FAIL',s['s0'],'Bend radius below cable minimum (installed)',\n                           'Section %d (%s): effective radius %.3f m is below the %.3f m minimum installed bending radius.'%(s['id'],s['kind'],reff,mbs)])\n    joints=len([s for s in segments if s['joint_angle']])\n    def verdict(limit,key):\n        if limit<=0:return 'NOT CHECKED'\n        if any(r[key]=='FAIL' for r in rows):return 'FAIL'\n        return 'REVIEW' if joints else 'WITHIN LIMIT'\n    pull_check=verdict(mbr,9);static_check=verdict(mbs,12)\n    if smallest is None:text='%s: no curved sections'%pull_check\n    elif mbr<=0:text='NOT CHECKED (limit is 0); smallest radius %.3f m'%smallest\n    else:text='%s: smallest %.3f m vs %.3f m minimum'%(pull_check,smallest,mbr)\n    if joints and mbr>0:text+='; %d grade break(s) without radius cannot be verified'%joints\n    return dict(rows=rows,issues=issues,min_radius=smallest,min_station=where,pull_check=pull_check,\n                static_check=static_check,joints=joints,text=text)\n\ndef calculate(xy,z,settings=None):\n    p=validate_settings(settings);globals()['GRADE_BREAK_MIN_DEG']=p['grade_break_tol_deg'];segments,issues,meta=build_geometry(read_xlsx(xy),read_xlsx(z))\n    if not p['assumptions_confirmed']:issues.append(['REVIEW',None,'Cable assumptions','Confirm project values before use'])\n    if p['cable_count']>4 and p['manufacturer_swbp_factor']<=0:issues.append(['REVIEW',None,'SWBP factor for more than four cables','IEEE gives no factor; conservative c=1.0 used. Enter a manufacturer factor to override.'])\n    if p['cable_count']==2:issues.append(['REVIEW',None,'Two-cable SWBP factor','c=Wc/2 is not an IEEE case; confirm with manufacturer.'])\n    if p['cable_count']==3 and 2.8<=p['conduit_diameter_mm']/p['cable_diameter_mm']<=3.2:\n        issues.append(['REVIEW',None,'Three-cable jam ratio','D/d is within 2.8 to 3.2'])\n    if p['cable_count']==3 and p['formation']=='Trefoil' and 2.5<p['conduit_diameter_mm']/p['cable_diameter_mm']<=3:\n        issues.append(['REVIEW',None,'Three-cable arrangement','Project-supplied middle-band Wc=1+2r^2 used; differs from the verified IEEE 1185-2010 cradled rule'])\n    f=solve_direction(segments,p);r=solve_direction(segments,p,True)\n    bend=bend_radius_check(segments,p)\n    for item in bend['issues']:issues.append(item)\n    if f['switched'] or r['switched']:issues.append(['INFO',None,'High sidewall friction applied','%d section(s) forward and %d reverse used the high sidewall friction of %.3f because the sidewall force at section entry exceeded %.0f N/m.'%(f['switched'],r['switched'],p['friction_high'],p['sidewall_threshold_N_m'])])\n    for name,run in [('Forward',f),('Reverse',r)]:\n        if run['slack']:issues.append(['REVIEW',None,name+' lost taut tension','Direction stopped; subsequent values unavailable'])\n    meta.update(xy_path=os.path.abspath(xy),z_path=os.path.abspath(z),generated=datetime.now().isoformat())\n    return dict(settings=p,segments=segments,issues=issues,metadata=meta,forward=f,reverse=r,bend=bend)\n\ndef result_tables(r):\n    p=r['settings'];b=r['bend'];summary=[['Cable pull V16 - corrected numerical calculation'],\n      ['Snapshot: change inputs in Dynamo and rerun. General 3D engineering model; review required.'],[],\n      ['Direction','Exit T (N)','Peak T (N)','Peak SWBP (N/m)','Tension check','SWBP check','Status','Convergence difference']]\n    for key in ('forward','reverse'):\n        v=r[key];summary.append([key,v['final'],v['peak'],v['swbp'],v['tension_check'],v['swbp_check'],v['status'],v['error']])\n    summary.extend([[],['Allowable tension (N)',p['allowable_tension_N']],['Allowable SWBP (N/m)',p['allowable_swbp_N_m']],\n                    ['Cable fill (%)',p['fill']*100],['Allowable fill (%)',p['allowable_fill']*100],\n                    ['Minimum bend radius during installation (m)',p['min_bend_install_m']],\n                    ['Minimum bend radius installed (m)',p['min_bend_static_m']],\n                    ['Smallest effective bend radius on route (m)',b['min_radius']],\n                    ['Bend radius check (installation)',b['pull_check']],['Bend radius check (installed)',b['static_check']]])\n    return {'Summary':summary,'Inputs':[['Input / derived value','Value']]+[[k,v] for k,v in p.items()],\n            'Bend Radius':[BEND_HEAD]+b['rows'],\n            'Forward':[HEAD]+r['forward']['rows'],'Reverse':[HEAD]+r['reverse']['rows'],\n            'Review':[['Level','Station (m)','Item','Detail']]+r['issues'],\n            'Method':[['Item','Basis']]+METHOD,\n            'Sources':[['Item','Value']]+[[k,r['metadata'][k]] for k in ('xy_path','z_path','generated')]}\n\ndef export_snapshot(path,tables):\n    \"\"\"Dynamo runtime XLSX export. Typed snapshots; never overwrite source files.\n\n    Formula-leading source text is always inline text, never executable Excel.\n    This deliberately does not retain V15's now-invalid live bend formulas.\n    \"\"\"\n    from xml.sax.saxutils import escape,quoteattr\n    content=['<Types xmlns=\"http://schemas.openxmlformats.org/package/2006/content-types\"><Default Extension=\"rels\" ContentType=\"application/vnd.openxmlformats-package.relationships+xml\"/><Default Extension=\"xml\" ContentType=\"application/xml\"/><Override PartName=\"/xl/workbook.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml\"/><Override PartName=\"/xl/styles.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.styles+xml\"/>']\n    wb=['<workbook xmlns=\"'+NS+'\" xmlns:r=\"'+REL+'\"><sheets>'];rels=['<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\">']\n    parts={}\n    for k,(name,rows) in enumerate(tables.items(),1):\n        wb.append('<sheet name=%s sheetId=\"%d\" r:id=\"r%d\"/>'%(quoteattr(name),k,k))\n        rels.append('<Relationship Id=\"r%d\" Type=\"%s/worksheet\" Target=\"worksheets/sheet%d.xml\"/>'%(k,REL,k))\n        content.append('<Override PartName=\"/xl/worksheets/sheet%d.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml\"/>'%k)\n        freeze=4 if name=='Summary' else 1\n        cols=max(map(len,rows),default=1)\n        widths=[max(16,min(65,max((len(str(row[c])) for row in rows if c<len(row) and row[c] is not None),default=12)+2)) for c in range(cols)]\n        xml=['<worksheet xmlns=\"'+NS+'\"><sheetViews><sheetView workbookViewId=\"0\" showGridLines=\"0\"><pane ySplit=\"%d\" topLeftCell=\"A%d\" activePane=\"bottomLeft\" state=\"frozen\"/></sheetView></sheetViews><cols>'%(freeze,freeze+1)]\n        xml.extend('<col min=\"%d\" max=\"%d\" width=\"%d\" customWidth=\"1\"/>'%(j,j,v) for j,v in enumerate(widths,1))\n        xml.append('</cols><sheetData>')\n        for ri,row in enumerate(rows,1):\n            height=45 if name in ('Method','Review','Sources') else 30\n            xml.append('<row r=\"%d\" ht=\"%d\" customHeight=\"1\">'%(ri,height))\n            for ci,v in enumerate(row,1):\n                if v is None:continue\n                a=col_label(ci)+str(ri);style=1 if ri==freeze else 0\n                if isinstance(v,(int,float)) and not isinstance(v,bool):\n                    if not math.isfinite(v):raise ValueError('Nonfinite report value')\n                    xml.append('<c r=\"%s\" s=\"%d\"><v>%r</v></c>'%(a,2 if style==0 else style,v))\n                else:xml.append('<c r=\"%s\" s=\"%d\" t=\"inlineStr\"><is><t xml:space=\"preserve\">%s</t></is></c>'%(a,style,escape(str(v))))\n            xml.append('</row>')\n        xml.append('</sheetData></worksheet>');parts['xl/worksheets/sheet%d.xml'%k]=''.join(xml)\n    wb.append('</sheets></workbook>');rels.append('<Relationship Id=\"styles\" Type=\"'+REL+'/styles\" Target=\"styles.xml\"/></Relationships>');content.append('</Types>')\n    parts.update({'[Content_Types].xml':''.join(content),'xl/workbook.xml':''.join(wb),'xl/_rels/workbook.xml.rels':''.join(rels),\n      '_rels/.rels':'<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\"><Relationship Id=\"r1\" Type=\"'+REL+'/officeDocument\" Target=\"xl/workbook.xml\"/></Relationships>',\n      'xl/styles.xml':'<styleSheet xmlns=\"'+NS+'\"><fonts count=\"2\"><font><sz val=\"11\"/><name val=\"Arial\"/></font><font><b/><sz val=\"11\"/><color rgb=\"FFFFFFFF\"/><name val=\"Arial\"/></font></fonts><fills count=\"3\"><fill><patternFill patternType=\"none\"/></fill><fill><patternFill patternType=\"gray125\"/></fill><fill><patternFill patternType=\"solid\"><fgColor rgb=\"FF243B53\"/></patternFill></fill></fills><borders count=\"1\"><border/></borders><cellStyleXfs count=\"1\"><xf numFmtId=\"0\" fontId=\"0\" fillId=\"0\" borderId=\"0\"/></cellStyleXfs><cellXfs count=\"3\"><xf numFmtId=\"0\" fontId=\"0\" fillId=\"0\" borderId=\"0\" xfId=\"0\" applyAlignment=\"1\"><alignment vertical=\"center\" wrapText=\"1\"/></xf><xf numFmtId=\"0\" fontId=\"1\" fillId=\"2\" borderId=\"0\" xfId=\"0\" applyAlignment=\"1\"><alignment vertical=\"center\" wrapText=\"1\"/></xf><xf numFmtId=\"4\" fontId=\"0\" fillId=\"0\" borderId=\"0\" xfId=\"0\"/></cellXfs><cellStyles count=\"1\"><cellStyle name=\"Normal\" xfId=\"0\" builtinId=\"0\"/></cellStyles></styleSheet>'})\n    with zipfile.ZipFile(path,'x',zipfile.ZIP_DEFLATED) as z:\n        for name,data in parts.items():z.writestr(name,'<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>'+data)\n\ndef run_from_dynamo(values):\n    if len(values)!=20:raise ValueError('Expected 20 input ports')\n    settings=dict(zip(SETTING_KEYS,values[4:18]))\n    settings['manufacturer_swbp_factor']=values[18] or 0.\n    # Validate before browsing reports or exporting anything.\n    validate_settings(settings)\n    pairs=resolve_profile_pairs(values[0]) if same_file(values[0],values[1]) else [(str(values[0]),str(values[1]),'Route')]\n    folder=str(values[19] or '').strip()\n    if values[3] and (not folder or not os.path.isdir(folder)):\n        raise ValueError('Select an existing Excel export folder')\n    runs=[];tables={};summary=[['Route','Forward peak T (N)','Reverse peak T (N)','Forward SWBP (N/m)','Reverse SWBP (N/m)','Forward status','Reverse status','Error']]\n    for xy,z,name in pairs:\n        try:\n            result=calculate(xy,z,settings);f=result['forward'];r=result['reverse']\n            runs.append(dict(route=name,result=result))\n            summary.append([name,f['peak'],r['peak'],f['swbp'],r['swbp'],f['status'],r['status'],''])\n        except Exception as error:\n            if len(pairs)==1:raise\n            runs.append(dict(route=name,error=str(error)))\n            summary.append([name,None,None,None,None,'NOT CALCULATED','NOT CALCULATED',str(error)])\n    if len(runs)==1:tables=result_tables(runs[0]['result'])\n    else:\n        tables={'Batch Summary':summary}\n        for i,run in enumerate(runs,1):\n            if 'result' in run:\n                for key,data in result_tables(run['result']).items():tables['%d %s'%(i,key)]=data\n    path='Preview only'\n    if values[3]:\n        path=os.path.join(folder,'Civil3D_PullCal_V16_'+datetime.now().strftime('%Y%m%d_%H%M%S_%f')+'.xlsx')\n        export_snapshot(path,tables)\n    return ['V16: corrected 3D numerical calculation',path,summary,\n            ['Inputs',validate_settings(settings)],['Routes',runs],['Method',METHOD]]\n\n\ndef inspect_work(output,selectors):\n    # One-based selection: route, direction (1 forward / 2 reverse), section, step.\n    indices=[]\n    for value in selectors:\n        if isinstance(value,bool) or not isinstance(value,(int,float)) or not math.isfinite(value) or value<1 or value!=int(value):\n            raise ValueError('Formula inspector selectors must be positive whole numbers')\n        indices.append(int(value))\n    route,direction,section,step=indices\n    runs=output[4][1]\n    if route>len(runs) or direction not in (1,2):raise ValueError('Formula inspector route/direction is outside the available range')\n    run=runs[route-1]\n    if 'result' not in run:raise ValueError('Selected route was not calculated')\n    result=run['result'];p=result['settings'];reverse=direction==2\n    order=list(reversed(result['segments'])) if reverse else result['segments']\n    rows=result['reverse' if reverse else 'forward']['rows']\n    if section>len(rows):raise ValueError('Formula inspector section exceeds %d'%len(rows))\n    s=order[section-1];row=rows[section-1]\n    if row[9] is None:raise ValueError('Selected section is unavailable after loss of taut tension')\n    a=math.radians(row[5]);T=row[9];kv=s['kv'];rh=s['rh'];p=section_params(p,T,a,s)\n    checked=integrate_checked(s,T,a,p);n=checked['steps']\n    if step>n:raise ValueError('Formula inspector step exceeds %d'%n)\n    h=s['length']/n\n    for j in range(step):\n        alpha=a+kv*j*h\n        k1=derivative(T,alpha,kv,rh,p)\n        u=T+h*k1/2;k2=derivative(u,alpha+kv*h/2,kv,rh,p)\n        v=T+h*k2/2;k3=derivative(v,alpha+kv*h/2,kv,rh,p)\n        z=T+h*k3;k4=derivative(z,alpha+kv*h,kv,rh,p)\n        raw=T+h*(k1+2*k2+2*k3+k4)/6\n        if min(T,u,v,z,raw)<-1e-8:\n            raise ValueError('Selected step reaches loss of taut tension; inspect an earlier step')\n        if j==step-1:break\n        T=max(0.,raw)\n    joint=(order[section-2]['joint_angle'] if section>1 else 0.) if reverse else s['joint_angle']\n    previous=p['initial_tension_N'] if section==1 else rows[section-2][10]\n    cable=[p[k] for k in ('cable_count','cable_mass_kg_m','gravity','cable_diameter_mm','conduit_diameter_mm','friction')]\n    cable += [p['configuration']=='Triangular',p['weight_correction'],p['manufacturer_swbp_factor'],p['swbp_factor']]\n    state=[T,math.degrees(alpha),kv,rh or 0.,h,p['effective_friction'],p['weight_N_m'],p['swbp_factor'],max(0.,raw),pressure(max(0.,raw),alpha+kv*h,kv,rh,p)]\n    geometry=[row[9],s['length'],row[5],rh or 0.,abs(s['s1']-s['s0']),kv,row[10],previous,math.degrees(joint),row[11],row[12]]\n    info=[['Route',run['route']],['Direction','Reverse' if reverse else 'Forward'],['Section',section],['Type',s['kind']],['Station in/out',row[2:4]],['Step',step],['Accepted steps in section',n],['Selected step exit N',max(0.,raw)],['Whole section exit N',row[10]],['Whole section peak N',row[11]],['Whole section peak SWBP N/m',row[12]],['Step size m',h],['Note','Step exit is not whole-section exit unless the last step is selected. All four vertical bend orientations and compound curves use the same force-balance steps.']]\n    return [cable,state,geometry,info]\n\n\nEMBEDDED_TEMPLATE = ''\n\"\"\"Dynamo's standard-library adapter: preserve the supplied XLSX package assets.\n\nThe host-authored template is embedded in the graph. Excel formulas are emitted\nalongside independently computed caches; no Excel installation is needed to export.\n\"\"\"\nimport base64, io, copy\n\n_report_indices={}\nclass ExcelFormula:\n    def __init__(self,text,value):self.text=text;self.value=value\n\ndef report_cell(root,address,value,style=None):\n    data=root.find(tag('sheetData'))\n    rn=int(re.search(r'\\d+',address).group())\n    if root not in _report_indices:\n        _report_indices[root]=({int(r.get('r')):r for r in data},{c.get('r'):c for r in data for c in r})\n    rows,cells=_report_indices[root]\n    row=rows.get(rn)\n    if row is None:\n        row=ET.SubElement(data,tag('row'),{'r':str(rn)});rows[rn]=row\n    cell=cells.get(address)\n    if cell is None:cell=ET.SubElement(row,tag('c'),{'r':address});cells[address]=cell\n    for child in list(cell):cell.remove(child)\n    cell.attrib.pop('t',None)\n    if style is not None:cell.set('s',str(style))\n    if isinstance(value,ExcelFormula):\n        ET.SubElement(cell,tag('f')).text=value.text.lstrip('=');value=value.value\n        if isinstance(value,str):cell.set('t','str')\n        if value is not None:ET.SubElement(cell,tag('v')).text=str(value)\n    elif isinstance(value,(float,int)):\n        ET.SubElement(cell,tag('v')).text=repr(value)\n    elif value is not None:\n        cell.set('t','inlineStr');ET.SubElement(ET.SubElement(cell,tag('is')),tag('t')).text=str(value)\n\ndef report_xml(root):\n    root.attrib.pop('{http://schemas.openxmlformats.org/markup-compatibility/2006}Ignorable',None)\n    data=root.find(tag('sheetData'))\n    data[:]=sorted(data,key=lambda r:int(r.get('r')))\n    for row in data:row[:]=sorted(row,key=lambda c:col_number(re.sub(r'\\d','',c.get('r'))))\n    addresses=[c.get('r') for row in data for c in row if len(c)]\n    if addresses:\n        endcol=max(col_number(re.sub(r'\\d','',a)) for a in addresses);endrow=max(int(re.search(r'\\d+',a).group()) for a in addresses)\n        dimension=root.find(tag('dimension'))\n        if dimension is None:dimension=ET.Element(tag('dimension'));root.insert(0,dimension)\n        dimension.set('ref','A1:'+col_label(endcol)+str(endrow))\n    return ET.tostring(root,encoding='utf-8',xml_declaration=True)\n\ndef clear_report(root):\n    for cell in root.findall('.//'+tag('c')):\n        for ch in list(cell):cell.remove(ch)\n        cell.attrib.pop('t',None)\n    for name in ('conditionalFormatting','dataValidations','hyperlinks'):\n        for el in root.findall(tag(name)):root.remove(el)\n\ndef report_widths(root,changes):\n    cols=root.find(tag('cols'));mapping={}\n    if cols is None:\n        cols=ET.Element(tag('cols'));root.insert(list(root).index(root.find(tag('sheetData'))),cols)\n    for old in cols:\n        for i in range(int(old.get('min')),int(old.get('max'))+1):mapping[i]=dict(old.attrib)\n    for i,width in changes.items():mapping[i]=dict(mapping.get(i,{}),width=str(width),customWidth='1')\n    cols.clear()\n    for i,attrs in sorted(mapping.items()):ET.SubElement(cols,tag('col'),dict(attrs,min=str(i),max=str(i)))\n\ndef report_height(root,row,height):\n    data=root.find(tag('sheetData'));r=next((x for x in data if int(x.get('r'))==row),None)\n    if r is not None:r.set('ht',str(height));r.set('customHeight','1')\n\ndef report_merge(root,address):\n    merges=root.find(tag('mergeCells'))\n    if merges is None:\n        merges=ET.Element(tag('mergeCells'));root.insert(list(root).index(root.find(tag('sheetData')))+1,merges)\n    if not any(m.get('ref')==address for m in merges):ET.SubElement(merges,tag('mergeCell'),{'ref':address})\n    merges.set('count',str(len(merges)))\n\ndef fresh_sheet():\n    root=ET.Element(tag('worksheet'))\n    views=ET.SubElement(root,tag('sheetViews'));view=ET.SubElement(views,tag('sheetView'),{'workbookViewId':'0','showGridLines':'0'})\n    ET.SubElement(view,tag('pane'),{'xSplit':'2','ySplit':'3','topLeftCell':'C4','activePane':'bottomRight','state':'frozen'})\n    cols=ET.SubElement(root,tag('cols'));ET.SubElement(cols,tag('col'),{'min':'1','max':'29','width':'17','customWidth':'1'})\n    ET.SubElement(root,tag('sheetData'))\n    return root\n\ndef live_steps(segments,p,reverse,name,style,headerstyle=None,integerstyle=None):\n    \"\"\"One visible row per accepted RK4 step; all calculations remain Excel formulas.\"\"\"\n    root=fresh_sheet();put=lambda a,v:report_cell(root,a,v,style)\n    put('A1',name+' — RK4 working');put('A2','Fixed exported mesh. Change inputs in Dynamo and rerun to verify convergence. Negative taut tension stops the pull.')\n    headers=['Section','Step','h (m)','alpha (rad)','kv (1/m)','Rplan (m; 0=none)','T in (N)','kh start','Normal 1 (N/m)','k1 (N/m)','Trial T mid 1','alpha mid','kh mid','Normal 2','k2','Trial T mid 2','Normal 3','k3','Trial T end','alpha end','kh end','Normal 4','k4','Delta T (N)','T out (N)','P in (N/m)','P out (N/m)','Peak T in section','Peak P in section','Friction used (eff.)']\n    for c,v in enumerate(headers,1):report_cell(root,col_label(c)+'3',v,headerstyle or style)\n    root.find(tag('sheetData'))[-1].set('ht','60');root.find(tag('sheetData'))[-1].set('customHeight','1')\n    order=list(reversed(segments)) if reverse else segments\n    result=[];r=4;T=p['initial_tension_N'];prev=None\n    W=\"'IEEE Inputs'!$C$29\";f=\"'IEEE Inputs'!$C$27\";c=\"'IEEE Inputs'!$C$33\"\n    for i,s in enumerate(order):\n        a=-s['a1'] if reverse else s['a0'];kv=s['kv'];rh=s['rh'] or 0\n        joint=(order[i-1]['joint_angle'] if i else 0.) if reverse else s['joint_angle']\n        tin=T*math.exp(p['effective_friction']*joint) if T is not None else None\n        ps=section_params(p,tin,a,s)\n        n=integrate_checked(s,tin,a,ps)['steps'] if tin is not None else 2*max(1,int(math.ceil(s['length']/p['max_step_m'])),int(math.ceil(abs(kv*s['length'])/math.radians(p['max_angle_step_deg']))),int(math.ceil(s['length']/(rh or 1e100)/math.radians(p['max_angle_step_deg']))))\n        if r+n>1048576:raise ValueError('Excel step sheet exceeds row limit. Split this route.')\n        h=s['length']/n;first=r;peak=tin;peakp=pressure(tin,a,kv,rh,p) if tin is not None else None\n        if not (kv or rh) and tin is not None:peakp=0.\n        T=tin\n        for j in range(n):\n            angle=a+kv*j*h\n            vals={};forms={}\n            def v(col,value):vals[col]=value\n            def q(col,formula,value,guard=True):\n                forms[col]=('IF(ISNUMBER(G%d),%s,\"UNAVAILABLE\")'%(r,formula)) if guard else formula\n                vals[col]=value if value is not None else 'UNAVAILABLE'\n            for col,value in zip('ABCDEF',[s['id'],j+1,h,angle,kv,rh]):v(col,value)\n            start=\"'IEEE Inputs'!$C$12\" if prev is None else 'Y%d'%prev\n            q('G',('IF(ISNUMBER(%s),%s*EXP(%s*%.17g),\"UNAVAILABLE\")'%(start,start,f,joint)) if j==0 else 'Y%d'%(r-1),T,False)\n            if T is not None:\n                kh=math.cos(angle)**2/rh if rh else 0.;normal=contact_force(T,angle,kv,rh,p);k1=derivative(T,angle,kv,rh,ps)\n                u=T+h*k1/2;am=angle+kv*h/2;km=math.cos(am)**2/rh if rh else 0.;nm=contact_force(u,am,kv,rh,p);k2=derivative(u,am,kv,rh,ps)\n                tmid=T+h*k2/2;nn=contact_force(tmid,am,kv,rh,p);k3=derivative(tmid,am,kv,rh,ps)\n                z=T+h*k3;ae=angle+kv*h;ke=math.cos(ae)**2/rh if rh else 0.;ne=contact_force(z,ae,kv,rh,p);k4=derivative(z,ae,kv,rh,ps)\n                inc=h*(k1+2*k2+2*k3+k4)/6;out=max(0.,T+inc) if min(T,u,tmid,z,T+inc)>=-1e-8 else None\n                pi=pressure(T,angle,kv,rh,p) if (kv or rh) else 0.\n                po=(pressure(out,ae,kv,rh,p) if (kv or rh) else 0.) if out is not None else None\n            else:kh=normal=k1=u=am=km=nm=k2=tmid=nn=k3=z=ae=ke=ne=k4=inc=out=pi=po=None\n            def ref(col):return col+str(r)\n            G,H,I,J,K,L,M,N,O,P,Q,R,S,U,V,Wk,X,Y=[ref(x) for x in ['G','H','I','J','K','L','M','N','O','P','Q','R','S','U','V','W','X','Y']]\n            C,D,E,F,Te=[ref(x) for x in ['C','D','E','F','T']];AD=ref('AD')\n            q('H',f'IF({F}=0,0,COS({D})^2/{F})',kh)\n            q('I',f'SQRT(({G}*{H})^2+({G}*{E}-{W}*COS({D}))^2)',normal)\n            q('J',f'{AD}*{I}+{W}*SIN({D})',k1);q('K',f'{G}+{C}*{J}/2',u)\n            q('L',f'{D}+{E}*{C}/2',am);q('M',f'IF({F}=0,0,COS({L})^2/{F})',km)\n            q('N',f'SQRT(({K}*{M})^2+({K}*{E}-{W}*COS({L}))^2)',nm)\n            q('O',f'{AD}*{N}+{W}*SIN({L})',k2);q('P',f'{G}+{C}*{O}/2',tmid)\n            q('Q',f'SQRT(({P}*{M})^2+({P}*{E}-{W}*COS({L}))^2)',nn)\n            q('R',f'{AD}*{Q}+{W}*SIN({L})',k3);q('S',f'{G}+{C}*{R}',z)\n            q('T',f'{D}+{E}*{C}',ae);q('U',f'IF({F}=0,0,COS({Te})^2/{F})',ke)\n            q('V',f'SQRT(({S}*{U})^2+({S}*{E}-{W}*COS({Te}))^2)',ne)\n            q('W',f'{AD}*{V}+{W}*SIN({Te})',k4);q('X',f'{C}*({J}+2*{O}+2*{R}+{Wk})/6',inc)\n            q('Y',f'IF(MIN({G},{K},{P},{S},{G}+{X})<-0.00000001,\"UNAVAILABLE\",MAX(0,{G}+{X}))',out)\n            q('Z',f'IF(AND({E}=0,{F}=0),0,IF(ISNUMBER({c}),{c}*{G}*SQRT({H}^2+{E}^2),\"UNAVAILABLE\"))',pi)\n            q('AA',f'IF(ISNUMBER({Y}),IF(AND({E}=0,{F}=0),0,IF(ISNUMBER({c}),{c}*{Y}*SQRT({U}^2+{E}^2),\"UNAVAILABLE\")),\"UNAVAILABLE\")',po)\n            peak=max(x for x in (peak,T,out) if x is not None) if any(x is not None for x in (peak,T,out)) else None\n            if pi is not None:peakp=max(x for x in (peakp,pi,po) if x is not None)\n            q('AB',f'IF(ISNUMBER({G}),MAX({G},{Y}),\"UNAVAILABLE\")' if j==0 else f'IF(ISNUMBER(AB{r-1}),MAX(AB{r-1},IF(ISNUMBER({Y}),{Y},0)),\"UNAVAILABLE\")',peak,False)\n            if j==0 and T is None:forms['AB']='\"UNAVAILABLE\"'\n            q('AC',f'IF(ISNUMBER(Z{r}),MAX(Z{r},AA{r}'+(')' if j==0 else f',AC{r-1})')+(',\"UNAVAILABLE\")' if j==0 else f',AC{r-1})'),peakp,False)\n            q('AD',((\"IF(AND('IEEE Inputs'!$C$46>0,ISNUMBER(Z%d),Z%d>'IEEE Inputs'!$C$47),'IEEE Inputs'!$C$46*'IEEE Inputs'!$C$26,'IEEE Inputs'!$C$27)\"%(first,first)) if j==0 else 'AD%d'%first),ps['effective_friction'],False)\n            for col,value in vals.items():\n                if col in ('A','B'):report_cell(root,col+str(r),value,integerstyle or style)\n                else:put(col+str(r),ExcelFormula(forms[col],value) if col in forms else value)\n            T=out;prev=r;r+=1\n        result.append(dict(first=first,last=r-1,segment=s,joint=joint,tin=tin,tout=T,peak=peak,pressure=peakp,steps=n))\n    return root,result\n\n\"\"\"Normalize non-calculation Office metadata after ElementTree serialization.\"\"\"\ndef normalize_excel_metadata(parts):\n    main='http://schemas.openxmlformats.org/spreadsheetml/2006/main'\n    rel='http://schemas.openxmlformats.org/officeDocument/2006/relationships'\n    mc='http://schemas.openxmlformats.org/markup-compatibility/2006'\n    allowed={main,rel,'http://www.w3.org/XML/1998/namespace'}\n    def namespace(name):return name[1:].split('}',1)[0] if name.startswith('{') else ''\n    def clean(parent):\n        for attr in list(parent.attrib):\n            ns=namespace(attr)\n            if ns and ns not in allowed:del parent.attrib[attr]\n        for child in list(parent):\n            ns=namespace(child.tag)\n            if ns==mc and child.tag.endswith('AlternateContent'):\n                fallback=child.find('{'+mc+'}Fallback');index=list(parent).index(child)\n                parent.remove(child)\n                if fallback is not None:\n                    for element in list(fallback):clean(element);parent.insert(index,element);index+=1\n            elif ns and ns!=main:parent.remove(child)\n            elif child.tag=='{'+main+'}extLst':\n                # Only vendor metadata extensions occur in these generated sheets.\n                parent.remove(child)\n            else:clean(child)\n    for name in list(parts):\n        if name in ('xl/workbook.xml','xl/styles.xml') or (name.startswith('xl/worksheets/report') and name.endswith('.xml')):\n            root=ET.fromstring(parts[name]);clean(root)\n            parts[name]=ET.tostring(root,encoding='utf-8',xml_declaration=True)\n    return parts\n\n\nREFERENCE_ROUTE_COLS = '<ns0:cols xmlns:ns0=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\"><ns0:col min=\"2\" max=\"4\" width=\"4.85546875\" customWidth=\"1\" /><ns0:col min=\"8\" max=\"8\" width=\"9.42578125\" bestFit=\"1\" customWidth=\"1\" /><ns0:col min=\"10\" max=\"10\" width=\"9.42578125\" bestFit=\"1\" customWidth=\"1\" /><ns0:col min=\"12\" max=\"12\" width=\"9.7109375\" customWidth=\"1\" /><ns0:col min=\"13\" max=\"13\" width=\"11.140625\" bestFit=\"1\" customWidth=\"1\" /><ns0:col min=\"14\" max=\"16\" width=\"10\" customWidth=\"1\" /><ns0:col min=\"17\" max=\"17\" width=\"2.85546875\" customWidth=\"1\" /><ns0:col min=\"18\" max=\"19\" width=\"11.140625\" customWidth=\"1\" /><ns0:col min=\"20\" max=\"20\" width=\"10.42578125\" customWidth=\"1\" /><ns0:col min=\"21\" max=\"21\" width=\"9.28515625\" bestFit=\"1\" customWidth=\"1\" /><ns0:col min=\"22\" max=\"22\" width=\"11\" customWidth=\"1\" /><ns0:col min=\"23\" max=\"23\" width=\"9.7109375\" bestFit=\"1\" customWidth=\"1\" /><ns0:col min=\"24\" max=\"25\" width=\"9.42578125\" bestFit=\"1\" customWidth=\"1\" /><ns0:col min=\"26\" max=\"27\" width=\"10.140625\" customWidth=\"1\" /><ns0:col min=\"28\" max=\"28\" width=\"10.42578125\" customWidth=\"1\" /><ns0:col min=\"29\" max=\"29\" width=\"11.85546875\" customWidth=\"1\" /><ns0:col min=\"31\" max=\"33\" width=\"11.42578125\" bestFit=\"1\" customWidth=\"1\" /></ns0:cols>'\n\ndef route_one_reference_layout(report,base,directions,page,p,run):\n    \"\"\"Reference presentation only; results remain linked to the V19 solver.\"\"\"\n    oldcols=report.find(tag('cols'))\n    report.remove(oldcols)\n    report.insert(list(report).index(report.find(tag('sheetData'))),ET.fromstring(REFERENCE_ROUTE_COLS))\n    # Restore the symbol/input panel, without obsolete closed-form worked examples.\n    for cell in base.findall('.//'+tag('c')):\n        addr=cell.get('r');rn=int(re.search(r'\\d+',addr).group())\n        if col_number(re.sub(r'\\d','',addr))<12 and 6<=rn<=14:\n            target=_report_indices[report][1].get(addr)\n            if target is not None:\n                target.attrib.clear();target.attrib.update(cell.attrib)\n                target[:]=[copy.deepcopy(x) for x in cell]\n    # Refresh restored template caches from this run before applying display units.\n    for addr,source,value in [('H8','C29',p['weight_N_m']),('H9','C27',p['effective_friction']),('H14','C33',p['swbp_factor'] if p['swbp_factor'] is not None else 'UNAVAILABLE')]:\n        report_cell(report,addr,ExcelFormula(\"'IEEE Inputs'!\"+source,value))\n    report_cell(report,'D6','Tension at end of section (N)')\n    report_cell(report,'D7','Tension at beginning of section (N)')\n    report_cell(report,'D8','Cable weight per unit length (N/m)')\n    report_cell(report,'A15','Calculation method')\n    report_cell(report,'C16','See IEEE 1185-2019 Method and the forward/reverse step sheets.')\n    report_merge(report,'C16:K18')\n    report_cell(report,'AC1','Cable Pulling Force Calculations')\n    report_cell(report,'L2','V19 reference layout. Forces in N; sidewall pressure in N/m. Detailed geometry is on the step sheets.')\n    labels=['Cable Section','T1 (N)','Length (m)','Curve Length (m)','Vertical Curve (m)','','Cumulative length (m)','bend (deg)','Angle (included) rad','Radius (m)','Gradient rad','Straight Pull (N)','Uphill Pull (N)','Downhill Pull (N)','Bend Pull (N)','Vertical / 3D Pull (N)','T (N)','Side Wall Force (N/m)']\n    for reverse,(stepname,records) in enumerate(directions):\n        title,head,first,footer=(102,103,104,197) if reverse else (3,4,5,98)\n        for col,label in enumerate(labels,12):report_cell(report,col_label(col)+str(head),label)\n        report_height(report,head,66)\n        report_cell(report,'L'+str(title),'No of conductors:')\n        report_cell(report,'T'+str(title),'Pull direction')\n        report_cell(report,'V'+str(title),'Reverse' if reverse else 'Forward')\n        report_cell(report,'Z'+str(title),'True Duct Length (m)')\n        report_cell(report,'AC'+str(title),sum(rec['segment']['length'] for rec in records))\n        subset=records[page*93:(page+1)*93]\n        cumulative=sum(rec['segment']['length'] for rec in records[:page*93])\n        for offset,rec in enumerate(subset):\n            row=first+offset;s=rec['segment'];a=-s['a1'] if reverse else s['a0']\n            cumulative+=s['length']\n            angle=abs(s['kv']*s['length']) if s['kv'] else (s['length']/s['rh'] if s['rh'] else 0.)\n            values={'N':s['length'] if not(s['kv'] or s['rh']) else None,'O':s['length'] if s['rh'] and not s['kv'] else None,'P':s['length'] if s['kv'] else None,'Q':None,'R':cumulative,'S':math.degrees(angle) if angle else None,'T':angle if angle else None,'U':abs(1/s['kv']) if s['kv'] else s['rh'],'V':a}\n            for col,value in values.items():\n                addr=col+str(row)\n                # Reference numeric formatting, avoiding six decimals in narrow columns.\n                source=next((c for c in base.findall('.//'+tag('c')) if c.get('r')==col+'5'),None)\n                report_cell(report,addr,value,source.get('s','0') if source is not None else None)\n        # Joint geometry is still on the detailed calculation sheets, not in gradient V.\n        cell=_report_indices[report][1]['W'+str(footer)];formula=cell.find(tag('f'))\n        last=first+len(subset)-1\n        formula.text=formula.text.replace('SUM(V%d:V%d)'%(first,last),repr(sum(rec['joint'] for rec in subset)))\n    views=report.find(tag('sheetViews'))\n    if views is not None:\n        for view in views:\n            view.set('topLeftCell','L1');view.set('zoomScale','85')\n            for selection in view.findall(tag('selection')):\n                selection.set('activeCell','L1');selection.set('sqref','L1')\n\n\ndef route_section_type(segment,reverse=False):\n    # Curvature keeps its sign when reversing; slope changes sign.\n    a=-segment['a1'] if reverse else segment['a0']\n    b=-segment['a0'] if reverse else segment['a1']\n    slope=(a+b)/2.0\n    if segment['kv']:\n        shape='Concave' if segment['kv']>0 else 'Convex'\n        # For a symmetric crest/sag, use the entry slope to identify direction.\n        direction=slope if abs(slope)>1e-7 else a\n        return shape+(' Downward Bend' if direction<0 else ' Upward Bend')\n    if segment['rh']:return 'Horizontal Bend'\n    if slope>1e-7:return 'Slope Up'\n    if slope<-1e-7:return 'Slope Down'\n    return 'Straight or Horizontal'\n\ndef add_route_section_types(report,directions,page,wrap_style):\n    cols=report.find(tag('cols'));cur={}\n    for old in cols:\n        for i in range(int(old.get('min')),int(old.get('max'))+1):cur[i]=float(old.get('width','0'))\n    w={i:max(12.6,cur.get(i,0)) for i in range(12,34)};w[17]=28\n    report_widths(report,w)\n    for reverse,(stepname,records) in enumerate(directions):\n        head,first=(103,104) if reverse else (4,5)\n        report_cell(report,'Q'+str(head),'Section type')\n        for offset,rec in enumerate(records[page*93:(page+1)*93]):\n            row=first+offset\n            report_cell(report,'Q'+str(row),route_section_type(rec['segment'],bool(reverse)),wrap_style)\n            report_height(report,row,30)\n\ndef add_known_swbp_output(report,directions,page,wrap_style,numeric_style):\n    \"\"\"Expose calculated section peaks without asserting a complete joint check.\"\"\"\n    results=[]\n    for reverse,(stepname,records) in enumerate(directions):\n        first,footer=(104,197) if reverse else (5,98)\n        subset=records[page*93:(page+1)*93];last=first+len(subset)-1\n        values=[rec['pressure'] for rec in subset if rec['pressure'] is not None]\n        known=max(values) if values else 'UNAVAILABLE'\n        joints=sum(bool(rec['joint']) for rec in subset)\n        note=('%d joints: radius missing' % joints) if joints else 'No unresolved joints on page'\n        if any(rec['tout'] is None or rec['pressure'] is None for rec in subset):\n            note+='; section results incomplete'\n        row=footer+1\n        report_merge(report,'R%d:AC%d'%(row,row))\n        report_cell(report,'R'+str(row),'Peak covers calculated sections only. '+note,wrap_style)\n        report_height(report,row,36)\n        results.append((footer,row,known,joints,note))\n    return results\n\n\ndef report_display_units(sheets,inputs,p,wrap_style):\n    \"\"\"Only route/Summary presentation converts; inputs and RK4 remain in SI.\"\"\"\n    usekg=bool(p.get('report_kg_units',False));divisor=p['gravity'] if usekg else 1.\n    report_cell(inputs,'B40','Report units',wrap_style)\n    report_cell(inputs,'C40','kg' if usekg else 'N',wrap_style)\n    report_cell(inputs,'E40','Select N or kg. kg / kg/m mean force equivalents: N divided by configured gravity. Inputs and step sheets stay in SI.',wrap_style)\n    validation=inputs.find(tag('dataValidations'))\n    if validation is None:\n        validation=ET.Element(tag('dataValidations'))\n        # SpreadsheetML requires dataValidations before hyperlinks/print/page elements.\n        after={'hyperlinks','printOptions','pageMargins','pageSetup','headerFooter','rowBreaks','colBreaks','customProperties','cellWatches','ignoredErrors','smartTags','drawing','legacyDrawing','legacyDrawingHF','picture','oleObjects','controls','webPublishItems','tableParts','extLst'}\n        index=next((i for i,child in enumerate(inputs) if child.tag.rsplit('}',1)[-1] in after),len(inputs))\n        inputs.insert(index,validation)\n    dv=ET.SubElement(validation,tag('dataValidation'),{'type':'list','allowBlank':'0','showErrorMessage':'1','errorTitle':'Report units','error':'Choose N or kg','sqref':'C40'})\n    ET.SubElement(dv,tag('formula1')).text='\"N,kg\"'\n    validation.set('count',str(len(validation)))\n    divisorref=\"IF('IEEE Inputs'!$C$40=\\\"kg\\\",'IEEE Inputs'!$C$8,1)\"\n    def convert(root,address):\n        cell=_report_indices[root][1].get(address)\n        if cell is None:return\n        f=cell.find(tag('f'));v=cell.find(tag('v'))\n        if f is None or v is None:return\n        expression=f.text\n        value=v.text if cell.get('t')=='str' else float(v.text)\n        formula='IF(ISNUMBER(%s),(%s)/(%s),%s)'%(expression,expression,divisorref,expression)\n        report_cell(root,address,ExcelFormula(formula,value/divisor if isinstance(value,(int,float)) else value))\n    def convert_cache(root,address):\n        cell=_report_indices[root][1].get(address)\n        if cell is None or cell.get('t')=='str':return\n        value=cell.find(tag('v'))\n        if value is not None:value.text=repr(float(value.text)/divisor)\n    def labels(root):\n        for address,cell in list(_report_indices[root][1].items()):\n            s=cell.find(tag('is'))\n            if s is None:continue\n            text=''.join(s.itertext())\n            if '(N)' in text or '(N/m)' in text:\n                alternate=text.replace('(N/m)','(kg/m)').replace('(N)','(kg)')\n                formula='IF(\\'IEEE Inputs\\'!$C$40=\"kg\",%s,%s)'%(json.dumps(alternate),json.dumps(text))\n                report_cell(root,address,ExcelFormula(formula,alternate if usekg else text))\n    for name,root,_ in sheets:\n        if name.startswith('Route '):\n            # Route 1 restores a symbol panel; cable weight is a displayed force.\n            if re.match(r'^Route 1(?: p\\d+)?$',name):convert(root,'H8')\n            for reverse in (False,True):\n                first,footer=(104,197) if reverse else (5,98)\n                # Snapshot SI expressions so each category switches independently\n                # and every force is divided only once.\n                for row in range(first,first+93):\n                    exitcell=_report_indices[root][1].get('AB'+str(row))\n                    exitformula=exitcell.find(tag('f')) if exitcell is not None else None\n                    if exitformula is not None:\n                        for col in ('W','X','Y','Z','AA'):\n                            categorycell=_report_indices[root][1].get(col+str(row))\n                            categoryformula=categorycell.find(tag('f')) if categorycell is not None else None\n                            if categoryformula is not None and categoryformula.text=='AB'+str(row):\n                                categoryformula.text=exitformula.text\n                for row in range(first,first+93):\n                    for col in ('M','AB','AC','W','X','Y','Z','AA'):convert(root,col+str(row))\n                for col in ('M','S','AC'):convert(root,col+str(footer))\n                convert_cache(root,'W'+str(footer))\n                report_cell(root,'V'+str(footer),'MAX Peak Sidewall (N/m)',wrap_style)\n            labels(root)\n            report_cell(root,'L2','Sidewall force is shown on bends; straight rows are blank. Page result is MAX of bend values; missing joint radii remain flagged.',wrap_style)\n        elif name=='Summary':\n            for address in list(_report_indices[root][1]):\n                if address[0] in ('E','F') and address[1:].isdigit() and int(address[1:])>=7:convert(root,address)\n            for address in list(_report_indices[root][1]):\n                if address[0] in ('G','H') and address[1:].isdigit() and int(address[1:])>=7:convert_cache(root,address)\n            labels(root)\n            report_cell(root,'H6',ExcelFormula('IF(\\'IEEE Inputs\\'!$C$40=\"kg\",\"MAX Peak Sidewall (kg/m)\",\"MAX Peak Sidewall (N/m)\")','MAX Peak Sidewall (kg/m)' if usekg else 'MAX Peak Sidewall (N/m)'),wrap_style)\n\n\ndef import_separate_calculations(parts,sheets,embedded):\n    \"\"\"Copy the supplied calculation sheets, formulas, styles and artwork.\"\"\"\n    styles=ET.fromstring(parts['xl/styles.xml'])\n    ct='{http://schemas.openxmlformats.org/package/2006/content-types}'\n    types=ET.fromstring(parts['[Content_Types].xml'])\n    imported_names={}\n    def section(name):\n        el=styles.find(tag(name))\n        if el is None:\n            el=ET.Element(tag(name));order=['numFmts','fonts','fills','borders','cellStyleXfs','cellXfs','cellStyles','dxfs','tableStyles','colors','extLst'];rank=order.index(name)\n            pos=next((i for i,x in enumerate(styles) if x.tag.rsplit('}',1)[-1] in order and order.index(x.tag.rsplit('}',1)[-1])>rank),len(styles));styles.insert(pos,el)\n        return el\n    for index,(title,payload) in enumerate(embedded,1):\n        with zipfile.ZipFile(io.BytesIO(base64.b64decode(payload))) as z:source={name:z.read(name) for name in z.namelist()}\n        srcstyles=ET.fromstring(source['xl/styles.xml']);offsets={}\n        numformats=section('numFmts');nummap={}\n        existing={x.get('formatCode'):int(x.get('numFmtId')) for x in numformats}\n        nextid=max([163]+[int(x.get('numFmtId')) for x in numformats])+1\n        srcnum=srcstyles.find(tag('numFmts'))\n        for old in srcnum if srcnum is not None else []:\n            fmt=old.get('formatCode');fid=existing.get(fmt)\n            if fid is None:fid=nextid;nextid+=1;existing[fmt]=fid;x=copy.deepcopy(old);x.set('numFmtId',str(fid));numformats.append(x)\n            nummap[int(old.get('numFmtId'))]=fid\n        numformats.set('count',str(len(numformats)))\n        for kind in ['fonts','fills','borders','cellStyleXfs','cellXfs','dxfs']:\n            dest=section(kind);offsets[kind]=len(dest);src=srcstyles.find(tag(kind))\n            for item in src if src is not None else []:\n                item=copy.deepcopy(item)\n                if kind in ('cellStyleXfs','cellXfs','dxfs'):\n                    for key,bucket in [('fontId','fonts'),('fillId','fills'),('borderId','borders')]:\n                        if item.get(key) is not None:item.set(key,str(int(item.get(key))+offsets[bucket]))\n                    if item.get('numFmtId') is not None:item.set('numFmtId',str(nummap.get(int(item.get('numFmtId')),int(item.get('numFmtId')))))\n                    if kind=='cellXfs' and item.get('xfId') is not None:item.set('xfId',str(int(item.get('xfId'))+offsets['cellStyleXfs']))\n                dest.append(item)\n            dest.set('count',str(len(dest)))\n        archive=zipfile.ZipFile(io.BytesIO(base64.b64decode(payload)));srcname,srcpath=next(iter(sheet_paths(archive).items()));archive.close()\n        root=ET.fromstring(source[srcpath]);strings=[]\n        if 'xl/sharedStrings.xml' in source:strings=list(ET.fromstring(source['xl/sharedStrings.xml']))\n        for cell in root.findall('.//'+tag('c')):\n            if cell.get('s') is not None:cell.set('s',str(int(cell.get('s'))+offsets['cellXfs']))\n            if cell.get('t')=='s':\n                value=cell.find(tag('v'));item=strings[int(value.text)];cell.remove(value);cell.set('t','inlineStr');inline=ET.SubElement(cell,tag('is'))\n                for child in item:inline.append(copy.deepcopy(child))\n        for col in root.findall('.//'+tag('col')):\n            if col.get('style') is not None:col.set('style',str(int(col.get('style'))+offsets['cellXfs']))\n        for row in root.findall('.//'+tag('row')):\n            if row.get('s') is not None:row.set('s',str(int(row.get('s'))+offsets['cellXfs']))\n        for rule in root.findall('.//'+tag('cfRule')):\n            if rule.get('dxfId') is not None:rule.set('dxfId',str(int(rule.get('dxfId'))+offsets['dxfs']))\n        prefix='xl/separate%d/'%index\n        mapped=lambda path:prefix+path[3:] if path.startswith('xl/') else prefix+path\n        sheetrel=posixpath.dirname(srcpath)+'/_rels/'+posixpath.basename(srcpath)+'.rels'\n        for name,blob in source.items():\n            if not (name==sheetrel or name.startswith(('xl/drawings/','xl/media/','xl/printerSettings/'))):continue\n            if name.endswith('.rels'):\n                relroot=ET.fromstring(blob)\n                owner=posixpath.join(posixpath.dirname(posixpath.dirname(name)),posixpath.basename(name)[:-5])\n                for rel in relroot:\n                    if rel.get('TargetMode')=='External':continue\n                    target=rel.get('Target');absolute=target.lstrip('/') if target.startswith('/') else posixpath.normpath(posixpath.join(posixpath.dirname(owner),target))\n                    rel.set('Target','/'+mapped(absolute))\n                blob=ET.tostring(relroot,encoding='utf-8',xml_declaration=True)\n            parts[mapped(name)]=blob\n        sourcetypes=ET.fromstring(source['[Content_Types].xml'])\n        for item in sourcetypes:\n            if item.tag==ct+'Default':\n                if not any(x.tag==ct+'Default' and x.get('Extension')==item.get('Extension') for x in types):types.append(copy.deepcopy(item))\n            elif item.tag==ct+'Override':\n                old=item.get('PartName').lstrip('/')\n                if old.startswith(('xl/drawings/','xl/media/','xl/printerSettings/')):\n                    el=copy.deepcopy(item);el.set('PartName','/'+mapped(old));types.append(el)\n        workbook=ET.fromstring(source['xl/workbook.xml']);names=workbook.find(tag('definedNames'))\n        for item in names if names is not None else []:\n            if item.get('name') in ('_xlnm.Print_Area','_xlnm.Print_Titles'):\n                imported_names.setdefault(title,[]).append((item.get('name'),item.text.replace(\"'\"+srcname+\"'!\",\"'\"+title+\"'!\")))\n        sheets.append((title,root,mapped(srcpath)))\n    parts['xl/styles.xml']=ET.tostring(styles,encoding='utf-8',xml_declaration=True)\n    parts['[Content_Types].xml']=ET.tostring(types,encoding='utf-8',xml_declaration=True)\n    return imported_names\n\n\nSEPARATE_CALCULATIONS = [('Duct Fill Calculation', ''), ('Cable Jamming Calculation', '')]\n\ndef link_duct_calculations(sheets,p):\n    \"\"\"Use authoritative Dynamo/IEEE Inputs for both calculation panels.\"\"\"\n    for title,root,_ in sheets:\n        if title not in ('Duct Fill Calculation','Cable Jamming Calculation'):continue\n        existing={c.get('r'):c for c in root.findall('.//'+tag('c'))}\n        def put(addr,value,stylefrom=None):\n            source=existing.get(stylefrom or addr)\n            report_cell(root,addr,value,source.get('s') if source is not None else None)\n        put('S1','Dynamo cable pulling calculation')\n        put('AJ1','-')\n        put('K11','Dynamo cable settings')\n        put('AD11','Dynamo duct settings')\n        # Cross-sectional conductor size, material and nominal duct size/type\n        # are absent from the existing graph, so never reuse template values.\n        put('K12','Not supplied')\n        put('D13','Arrangement')\n        put('K13',ExcelFormula(\"'IEEE Inputs'!C36\",p['formation']))\n        put('AD12','Not supplied')\n        put('AD13','Not supplied')\n        put('K14',ExcelFormula(\"'IEEE Inputs'!C9\",p['cable_diameter_mm']))\n        put('K15',ExcelFormula(\"'IEEE Inputs'!C6\",p['cable_count']))\n        put('AD14',ExcelFormula(\"'IEEE Inputs'!C10\",p['conduit_diameter_mm']))\n        descriptor='Duct fill calculation' if title=='Duct Fill Calculation' else 'Cable jam ratio calculation'\n        put('S2',ExcelFormula('\"%s - \"&K15&\" cables\"'%descriptor,descriptor+' - %g cables'%p['cable_count']))\n        if title=='Duct Fill Calculation':\n            put('W15','Fill limit (%)','W14')\n            put('S3','CME');put('Z3','NA');put('AG3',datetime.now().strftime('%d/%m/%Y'))\n            put('AD15',ExcelFormula(\"'IEEE Inputs'!C15*100\",p['allowable_fill']*100),'AD14')\n            report_merge(root,'AD15:AG15')\n            put('D17','Reference fill limits (%)')\n            put('G35',ExcelFormula('K14',p['cable_diameter_mm']))\n            put('L35',ExcelFormula('K15',p['cable_count']))\n            put('G36',ExcelFormula('AD14',p['conduit_diameter_mm']))\n            cablearea=math.pi*(p['cable_diameter_mm']/2)**2*p['cable_count']\n            ductarea=math.pi*(p['conduit_diameter_mm']/2)**2\n            put('R35',ExcelFormula('IF(AND(ISNUMBER(K14),K14>0,ISNUMBER(K15),K15=INT(K15),K15>=1),PI()*(K14/2)^2*K15,\"UNAVAILABLE\")',cablearea))\n            put('R36',ExcelFormula('IF(AND(ISNUMBER(AD14),AD14>0),PI()*(AD14/2)^2,\"UNAVAILABLE\")',ductarea))\n            fill=cablearea/ductarea*100\n            put('K40',ExcelFormula('IF(AND(ISNUMBER(R35),ISNUMBER(R36),R36>0),R35/R36*100,\"UNAVAILABLE\")',fill))\n            put('D43','Check against Dynamo fill limit')\n            put('D45',ExcelFormula('IF(AND(ISNUMBER(K40),ISNUMBER(AD15),AD15>0,AD15<=100),IF(K40<=AD15,\"PASS\",\"FAIL\"),\"UNAVAILABLE\")','PASS' if fill<=p['allowable_fill']*100 else 'FAIL'))\n        else:\n            put('S3','CME');put('Z3','NA');put('AG3',datetime.now().strftime('%d/%m/%Y'))\n            put('D19','Jamming check applies to three equal-size single cables.')\n            put('D20','Uses adjusted JR = 1.05 x duct ID / cable OD.')\n            put('D21','Critical adjusted JR range: 2.8 to 3.2 (inclusive).')\n            put('G37',ExcelFormula('AD14',p['conduit_diameter_mm']))\n            put('G38',ExcelFormula('K14',p['cable_diameter_mm']))\n            ratio=1.05*p['conduit_diameter_mm']/p['cable_diameter_mm']\n            put('K42',ExcelFormula('IF(AND(ISNUMBER(G37),G37>0,ISNUMBER(G38),G38>0),1.05*G37/G38,\"UNAVAILABLE\")',ratio))\n            put('D45','Check for three equal cables')\n            status='N/A' if p['cable_count']!=3 else ('PASS' if ratio<2.8 or ratio>3.2 else 'FAIL')\n            put('D47',ExcelFormula('IF(AND(ISNUMBER(K15),K15=INT(K15),K15>=1,ISNUMBER(K42)),IF(K15<>3,\"N/A\",IF(OR(K42<2.8,K42>3.2),\"PASS\",\"FAIL\")),\"UNAVAILABLE\")',status))\n            put('D49','N/A: three-cable criterion does not apply to this count.','D21')\n            report_cell(root,'D49',ExcelFormula('IF(AND(ISNUMBER(K15),K15>=1,K15<>3),\"N/A: three-cable criterion does not apply to this count.\",\"\")','N/A: three-cable criterion does not apply to this count.' if p['cable_count']!=3 else ''),existing['D21'].get('s'))\n\n\nHELP_ROWS = [('H', 'A. Inputs and cable factors', '', '', ''), ('R', 'Cable weight per metre', 'W = n x m x g', 'W [N/m]; n = number of cables; m = cable mass [kg/m]; g = gravity [m/s2] (9.8). Gravity is applied once.', 'IEEE Inputs C29; Dynamo engine weight_N_m'), ('R', 'Duct / cable ratio', 'r = d / (D - d)    ;    D/d', 'd = cable outside diameter [mm]; D = duct inside diameter [mm]. Cables must fit: D/d >= 1 (1 cable), 2 (2), 1+2/sqrt(3) (3), 1+sqrt(2) (4).', 'IEEE Inputs C18:C20'), ('R', 'Weight correction factor Wc - single cable', 'Wc = 1', 'IEEE 1185-2019 clause 4.13 (workbook eq. 16-18).', 'IEEE Inputs C26'), ('R', 'Wc - two cables (three cables follow the project rule below)', 'Wc = 1 / sqrt(1 - r^2)', 'Triangular arrangement; requires r < 1. Three cables use the D/d rule in the next row.', 'IEEE Inputs C26; Dynamo validate_settings'), ('R', 'Wc - three cables, cradled', 'Wc = 1 + (4/3) x r^2', 'Cradled arrangement.', 'IEEE Inputs C26'), ('R', 'Wc - four cables, diamond', 'Wc = 1 + 2 x r^2', 'Diamond arrangement.', 'IEEE Inputs C26'), ('R', 'Wc - three-cable project rule', 'D/d <= 2.5: 1/sqrt(1-r^2);   2.5 < D/d <= 3.0: 1 + 2 r^2;   D/d > 3.0: 1 + (4/3) r^2', 'The middle band (2.5 to 3.0) is a project-supplied rule and is NOT verified against IEEE 1185. Review before use.', 'Dynamo validate_settings (3 cables, trefoil)'), ('R', 'Wc - more than four cables', 'Wc = 1.4 (assumed)', 'Project assumption, not an IEEE value. Confirm for the project.', 'Dynamo validate_settings'), ('R', 'Effective friction coefficient', \"f' = f x Wc\", \"f = coefficient of friction (cable to duct). f' replaces f in every tension equation below.\", 'IEEE Inputs C27'), ('R', 'Conduit fill', 'fill = n x (d / D)^2', 'Compared with the allowable fill (for example 0.40 for three or more cables).', 'Duct Fill Calculation sheet; Dynamo validate_settings'), ('R', 'Jamming check (three equal cables)', 'Jam ratio JR = D / d ;  jam factor = 1.05 x D / d', 'A D/d between 2.8 and 3.2 is flagged for review (jamming likely). Applies to three equal cables only.', 'Cable Jamming Calculation sheet; Dynamo calculate()'), ('H', 'B. Closed-form section equations (IEEE 1185-2019, as transcribed in the IEEE-1185-2019 Method workbook)', '', '', ''), ('R', 'Straight horizontal pull (eq. 5)', \"T2 = T1 + W x f' x L\", 'T1 = tension at start of section [N]; T2 = tension at end [N]; L = length of section [m].', 'Dynamo test node: straight; Method sheet'), ('R', 'Straight inclined pull - uphill (eq. 6a)', \"T2 = T1 + W x L x ( f' x cos(a) + sin(a) )\", 'a = slope angle [deg]; L = length along the duct [m]. Friction f appears once.', 'Dynamo test node: slope up'), ('R', 'Straight inclined pull - downhill (eq. 6b)', \"T2 = T1 + W x L x ( f' x cos(a) - sin(a) )\", 'Tension can fall to zero on a steep downhill; if it would go negative the pull is slack (see section D).', 'Dynamo test node: slope down'), ('R', 'Horizontal bend, level (eq. 6 / 8)', \"T2 = T1 x cosh(f' x th) + sinh(f' x th) x sqrt( T1^2 + (W x R)^2 )\", \"th = bend angle [rad]; R = bend radius [m]. Friction does not appear inside the square root. For large T1 this tends to T1 x e^(f' x th).\", 'Dynamo test node: level bend; engine contact_force()'), ('R', 'Vertical bends - common terms (eq. 9 to 12)', \"E = e^(f' x th) ;   B = W x R / (1 + f'^2)\", 'th in radians (converted once: th = degrees x pi / 180). e = exp(1) exactly.', 'Method sheet; Dynamo test nodes'), ('R', 'Convex (crest) bend, pulling upward (eq. 9)', \"T2 = T1 x E + B x [ 2 f' E sin(th) + (1 - f'^2) (1 - E cos(th)) ]\", 'Inclination falls from +th to 0 (pull up a slope and over the crest).', 'Dynamo test node 1ffa5d'), ('R', 'Concave (sag) bend, pulling upward (eq. 10)', \"T2 = T1 x E - B x [ 2 f' sin(th) - (1 - f'^2) (E - cos(th)) ]\", 'Inclination rises from 0 to +th. Valid while T/R >= W cos(a) (cable stays on the roof).', 'Dynamo test node 56865c'), ('R', 'Convex (crest) bend, pulling downward (eq. 11)', \"T2 = T1 x E + B x [ 2 f' sin(th) - (1 - f'^2) (E - cos(th)) ]\", 'Inclination falls from 0 to -th.', 'Dynamo test node 00c6a3'), ('R', 'Concave (sag) bend, pulling downward (eq. 12)', \"T2 = T1 x E - B x [ 2 f' E sin(th) + (1 - f'^2) (1 - E cos(th)) ]\", 'Inclination rises from -th to 0. Valid while T/R >= W cos(a).', 'Dynamo test node 3a4384'), ('H', 'C. General 3D solver used for the route (Dynamo engine, RK4)', '', '', ''), ('R', 'Force balance along the duct', \"dT/dl = f' x N + W x sin(a)\", 'l = distance along the duct [m]; a = inclination of the duct [rad]; N = contact force per metre [N/m]. +sin(a) when pulling uphill.', 'Engine derivative() ; step sheets column J'), ('R', 'Contact force per metre', 'N = sqrt( (T x kh)^2 + (T x kv - W x cos(a))^2 )', 'Absolute resultant handles floor and roof contact continuously. Same balance for straights, horizontal, vertical and compound curves.', 'Engine contact_force() ; step sheets column I'), ('R', 'Curvatures', 'kh = cos(a)^2 / R_plan ;   kv = da/dl', 'R_plan = plan radius [m] (kh = 0 on a straight). kv > 0 sag (concave), kv < 0 crest (convex); |kv| = 1 / R_profile.', 'Engine; step sheets columns E, F, H'), ('R', 'Total curvature of the cable path (kappa)', 'kappa = sqrt( kh^2 + kv^2 )   [1/m]', 'kappa = 1 / (radius the cable is actually bending around). 0 on a straight; 0.5 for a 2 m radius bend. Plain horizontal or vertical bend: kappa = 1/R. Compound bend: both kh and kv contribute.', 'Sidewall pressure; step sheets columns Z, AA'), ('R', 'Runge-Kutta 4 step', 'k1 = f(T, a);  k2 = f(T + h k1/2, a + kv h/2);  k3 = f(T + h k2/2, a + kv h/2);  k4 = f(T + h k3, a + kv h);   T_next = T + h (k1 + 2 k2 + 2 k3 + k4) / 6', 'h = step length [m]; a advances by kv x h. One visible row per step on the R# F/R steps sheets.', 'Step sheets columns J to Y'), ('R', 'Step refinement', 'Halve h until exit tension, peak tension and peak SWBP change by <= 0.01 + 1e-7 x value', 'Limits: maximum integration step [m] and maximum angle step [deg] are Dynamo inputs.', 'Engine integrate_checked()'), ('R', 'Profile geometry (vertical circular arc)', 'sin(a) = sin(a0) + kv x ds ;   z = z0 + ( cos(a0) - cos(a) ) / kv', 'ds = horizontal (station) distance. Arc from chord c and radius R: total turn = 2 x asin( c / (2 R) ). Section length = ds / cos(a) for a tangent, |a1 - a0| / |kv| for an arc.', 'Engine read_profile_entities(), build_geometry()'), ('R', 'Parabolic profile curves', 'Replaced by the circular arc with the same end points and total turn', 'Elevation difference is sub-millimetre. Equivalent R = chord / total turn is reported in the Review sheet.', 'Engine read_profile_entities()'), ('R', 'Grade break with no radius (zero-length joint)', \"T1(next) = T_prev x e^( f' x delta )\", 'delta = change of direction [rad]. Joint SWBP is unavailable without a radius; a REVIEW line is raised.', 'Engine solve_direction()'), ('R', 'Reverse pull', 'Sections taken in reverse order; inclination a becomes -a; curvature sign is kept', 'Reverse results are a separate calculation, not a reversal of the forward numbers.', 'Engine solve_direction(reverse=True)'), ('H', 'D. Limits and checks', '', '', ''), ('R', 'Slack (loss of taut tension)', 'If T would become < 0 the direction stops', 'Later sections show UNAVAILABLE. A braking / contact model is then required.', 'Engine integrate()'), ('R', 'Sidewall bearing pressure (SWBP), general', 'P = c x T x kappa ;   kappa = sqrt( kh^2 + kv^2 )', 'P [N/m]. For a single cable on a bend of radius R this reduces to P = T2 / R (eq. 19).', 'Step sheets columns Z, AA; route sheets'), ('R', 'SWBP factor c', 'single: c = 1;  two cables or trefoil: c = Wc / 2;  cradled: c = (3 Wc - 2) / 3;  diamond (four): c = Wc - 1;  more than four: c = 1.0', 'Eq. 19 to 21. More than four cables has no IEEE factor, so the conservative value 1.0 is used and a REVIEW line is raised. A positive manufacturer factor overrides all of these.', 'IEEE Inputs C33; Dynamo validate_settings'), ('R', 'Pass / fail', 'Peak T <= allowable tension ;   Peak P <= allowable SWBP', 'Typical SWBP guidelines (IEEE Table 7): 7300 N/m for 600 V multi-conductor and 5 to 15 kV shielded power cable; 4380 N/m for 25 to 35 kV or armoured. Manufacturer values take precedence.', 'Summary and route sheets'), ('R', 'Maximum allowable pulling tension', 'three or fewer conductors: Tm = K x n x CMA ;   four or more: Tm = 0.8 x K x n x CMA', 'K = 0.008 lbf per circular mil (copper) or 0.006 (aluminium); n = number of conductors; CMA = conductor area in circular mils. Convert: 1 lbf = 4.4482216 N. Manufacturer limits take precedence.', 'IEEE 1185-2019 Method workbook, rows 287-305'), ('H', 'E. Units and conventions', '', '', ''), ('R', 'Angles', 'radians = degrees x pi / 180 (applied once)', 'Dynamo Math.Sin / Math.Cos take DEGREES; Python and Excel SIN / COS take radians.', 'All'), ('R', 'Force units', 'N; weight in N/m; SWBP in N/m. kg force = N / g', 'Display option on the report converts N to kg using the configured gravity; calculations stay in SI.', 'Summary; IEEE Inputs'), ('R', 'Verification', 'Closed forms (eq. 9 to 12) agree with the RK4 solution to 0.0000 N for constant-radius bends with cable in contact', 'The RK4 solver is the reference; the closed forms are checks. Where the cable lifts off the duct wall the closed forms do not apply.', 'Dynamo inspector panel'), ('H', 'F. Symbols and abbreviations', '', '', ''), ('S', 'Symbol / abbreviation', 'Meaning', 'Units / notes', 'Appears in'), ('R', 'T, T1, T2', 'Cable pulling tension; T1 = at the start of a section, T2 = at its end', 'N (1 kg force = g newtons)', 'All tension equations'), ('R', 'Peak T', 'Highest tension reached anywhere in a section or route', 'N; compared with the allowable tension', 'Summary, route sheets'), ('R', 'W', 'Total cable weight per metre of duct', 'N/m', 'Sections A to C'), ('R', 'n', 'Number of cables pulled together in the duct', 'whole number', 'Weight, Wc, fill, SWBP factor'), ('R', 'm', 'Cable mass per metre (one cable)', 'kg/m', 'Weight'), ('R', 'g', 'Gravity constant', 'm/s2 (9.8)', 'Weight'), ('R', 'd, D', 'd = cable outside diameter (OD); D = duct inside diameter (ID)', 'mm', 'Wc, fill, jamming'), ('R', 'r', 'Clearance ratio d / (D - d)', 'no units', 'Wc equations'), ('R', 'D/d', 'Duct to cable diameter ratio', 'no units', 'Wc bands, jam ratio'), ('R', 'JR', 'Jam ratio (D/d); jam factor = 1.05 x D/d', 'no units; 2.8 to 3.2 is flagged', 'Jamming check'), ('R', 'Wc', 'Weight correction factor for cable formation (single, triangular/trefoil, cradled, diamond)', 'no units', 'Section A'), ('R', 'f', 'Coefficient of friction between cable and duct', 'no units (for example 0.2 lubricated)', 'All tension equations'), ('R', \"f'\", 'Effective friction coefficient = f x Wc', 'no units', 'All tension equations'), ('R', 'L, l, ds', 'L = length of a section; l = distance along the duct; ds = horizontal (station) distance', 'm', 'Section B and C'), ('R', 'h', 'Integration step length', 'm', 'RK4'), ('R', 'R, R_plan, R_profile', 'Bend radius; R_plan = radius in plan (horizontal curve); R_profile = radius of a vertical curve (sag or crest)', 'm', 'Bend equations, curvature'), ('R', 'th (theta)', 'Bend angle', 'radians inside formulas; degrees as inputs', 'Bend equations'), ('R', 'a (alpha), a0, a1', 'Inclination of the duct from horizontal; a0 = at start, a1 = at end. Positive = rising in the pull direction', 'radians (degrees in Dynamo)', 'Slopes, vertical bends, solver'), ('R', 'delta', 'Change of direction at a grade break (joint with no radius)', 'radians', 'Joint capstan'), ('R', 'E', \"e^(f' x th), the capstan factor\", 'no units', 'Eq. 9 to 12'), ('R', 'e', 'Base of natural logarithms, exp(1) = 2.718281828...', 'no units', 'Capstan factor'), ('R', 'B', \"W x R / (1 + f'^2)\", 'N', 'Eq. 9 to 12'), ('R', 'N', 'Contact force per metre between cable and duct wall', 'N/m', 'Section C'), ('R', 'kh', 'Plan curvature = cos(a)^2 / R_plan', '1/m', 'Section C'), ('R', 'kv', 'Profile curvature = da/dl; positive sag, negative crest', '1/m', 'Section C'), ('R', 'kappa', 'Total curvature = sqrt(kh^2 + kv^2), the reciprocal of the effective bend radius', '1/m', 'Sidewall pressure'), ('R', 'k1, k2, k3, k4', 'The four slope estimates (dT/dl) used in one RK4 step', 'N/m', 'Step sheets'), ('R', 'SWBP (P)', 'Sidewall bearing pressure: force per metre of bend radius pressing the cable on the duct wall', 'N/m', 'Sidewall checks'), ('R', 'c', 'SWBP factor for the cable formation (single 1, trefoil Wc/2, cradled (3Wc-2)/3, diamond Wc-1)', 'no units', 'Sidewall pressure'), ('R', 'MAPT / Tm', 'Maximum allowable pulling tension of the cable', 'N', 'Limits'), ('R', 'K, n, CMA', 'K = pulling constant (0.008 lbf per circular mil copper, 0.006 aluminium); CMA = conductor area in circular mils', 'lbf per cmil; cmil', 'MAPT'), ('R', 'RK4', 'Fourth-order Runge-Kutta numerical integration', '-', 'Solver'), ('R', 'IEEE 1185', 'IEEE Std 1185-2019, Recommended Practice for Cable Installation in Generating Stations and Industrial Facilities', '-', 'Equation source'), ('R', 'XY / Z report', 'Civil 3D (or Revit-extracted) plan-point report (station, easting, northing, elevation, plan radius) and profile-entity report (tangents, sag and crest curves)', '-', 'Dynamo inputs'), ('R', 'Sag / Crest', 'Sag = vertical curve that is concave up (kv > 0); Crest = convex up (kv < 0). Concave / Convex bend uses the same meaning', '-', 'Vertical bends'), ('R', 'Forward / Reverse', 'Pull from the first section to the last, or from the last to the first', '-', 'Route sheets'), ('R', 'Taut / Slack', 'Taut: tension stays above zero. Slack: tension would go below zero, so the cable is not under tension and the pull needs a different model', '-', 'Solver'), ('R', 'WITHIN LIMIT / FAIL / REVIEW REQUIRED / UNAVAILABLE', 'Check results: inside the allowable value; over it; needs engineer review (assumptions not confirmed or review items raised); not calculated (for example after slack)', '-', 'Summary, route sheets')]\n\ndef help_equations_sheet(wrap_style, headerstyle):\n    \"\"\"Plain-text help sheet listing every equation used in the calculation.\"\"\"\n    root = fresh_sheet()\n    view = root.find(tag('sheetViews'))[0]\n    pane = view.find(tag('pane'))\n    for key in ('xSplit',):\n        pane.attrib.pop(key, None)\n    pane.set('ySplit', '3'); pane.set('topLeftCell', 'A4'); pane.set('activePane', 'bottomLeft')\n    widths = {1: 6, 2: 34, 3: 72, 4: 62, 5: 38}\n    report_widths(root, widths)\n    put = lambda a, v, s=None: report_cell(root, a, v, s if s is not None else wrap_style)\n    put('A1', 'Help - equations used in this calculation', headerstyle)\n    put('A2', 'Units: N, N/m, m, kg/m, degrees for inputs, radians inside formulas. Equation numbers refer to the IEEE-1185-2019 Method workbook. th = bend angle in radians.', wrap_style)\n    report_merge(root, 'A1:E1'); report_merge(root, 'A2:E2'); report_height(root, 2, 32)\n    for c, h in enumerate(['No.', 'Topic', 'Equation', 'Symbols, limits and notes', 'Used in'], 1):\n        put(col_label(c) + '3', h, headerstyle)\n    row = 4; number = 0\n    for kind, topic, eq, notes, used in HELP_ROWS:\n        if kind == 'H':\n            put('A%d' % row, topic, headerstyle); report_merge(root, 'A%d:E%d' % (row, row)); report_height(root, row, 22)\n        elif kind == 'S':\n            number = 0\n            for c, h in enumerate(['No.', topic, eq, notes, used], 1):\n                put(col_label(c) + str(row), h, headerstyle)\n            report_height(root, row, 20)\n        else:\n            number += 1\n            put('A%d' % row, number); put('B%d' % row, topic); put('C%d' % row, eq); put('D%d' % row, notes); put('E%d' % row, used)\n            lines = max(int(math.ceil(len(topic) / 32.0)), int(math.ceil(len(eq) / 68.0)), int(math.ceil(len(notes) / 58.0)), int(math.ceil(len(used) / 34.0)), 1)\n            report_height(root, row, 15 * lines + 4)\n        row += 1\n    return root\n\nDYNAMO_TEXT=[\n ('Rerun Dynamo after input changes to recheck convergence','Rerun the calculation after input changes to recheck convergence'),\n ('Rerun Dynamo after input changes to check convergence','Rerun the calculation after input changes to check convergence'),\n ('Rerun Dynamo after route input changes','Rerun the calculation after route input changes'),\n ('rerun Dynamo to verify changed inputs','rerun the calculation to verify changed inputs'),\n ('INVALID - rerun Dynamo','INVALID - rerun the calculation'),\n ('Change inputs in Dynamo and rerun to verify convergence','Change the inputs and rerun to verify convergence'),\n ('Dynamo cable settings; confirm for this project','Cable settings; confirm for this project'),\n ('Dynamo cable settings and Civil 3D route reports','Cable settings and Civil 3D route reports'),\n ('Dynamo cable settings','Cable settings'),\n ('Dynamo duct settings','Duct settings'),\n ('Dynamo cable pulling calculation','Cable pulling calculation'),\n ('Fill and jamming tabs use Dynamo cable/duct inputs','Fill and jamming tabs use the cable/duct inputs'),\n ('Dynamo inputs. Formulas update','Inputs. Formulas update'),\n ('replaced by Dynamo inputs','replaced by the calculation inputs'),\n ('are Dynamo inputs','are calculation inputs'),\n ('-Dynamo inputs','-calculation inputs'),\n ('Check against Dynamo fill limit','Check against the fill limit'),\n ('(as FRD2A Civil 3D PullCal Dynamo graph)','(as FRD2A Civil 3D PullCal graph)'),\n ('(as the Dynamo graph)','(as the calculation graph)'),\n ('As Dynamo graph','As calculation graph'),\n ('PullCal Dynamo graph','PullCal graph'),\n ('Same steps as the Dynamo','Same steps as the'),\n ('(Dynamo engine, RK4)','(calculation engine, RK4)'),\n ('Dynamo engine ','calculation engine '),\n ('Dynamo test nodes','Test nodes'),\n ('Dynamo test node','Test node'),\n ('Dynamo inspector panel','Inspector panel'),\n ('Dynamo Math.Sin / Math.Cos','Math.Sin / Math.Cos'),\n ('(degrees in Dynamo)','(degrees in the graph)'),\n ('Dynamo validate_settings','validate_settings'),\n ('Dynamo calculate()','calculate()')]\n\ndef scrub_dynamo(parts):\n    \"\"\"Remove the word Dynamo from every text part of the exported workbook.\"\"\"\n    for name,content in list(parts.items()):\n        if not name.endswith('.xml') or b'Dynamo' not in content:continue\n        text=content.decode('utf-8')\n        for old,new in DYNAMO_TEXT:text=text.replace(old,new)\n        text=re.sub(r'\\bDynamo\\b','calculation',text)\n        parts[name]=text.encode('utf-8')\n\nHMV_LOGO_SHA256={'3290bd1f502b27d0653f06752af9929dd33002d3cca4cbdbfba8a1a6a3c3e0e2'}\n\ndef remove_logo(parts):\n    \"\"\"Remove the H&MV Engineering logo from the workbook: the picture, its relationship and the image file itself.\n    The picture is found by the SHA-256 of its image data, so the MWP logo, the method diagrams and the jamming chart\n    are never touched. Drawings are searched both at xl/drawings and in the imported xl/separateN/drawings folders.\"\"\"\n    import hashlib\n    anchors=re.compile(r'<((?:\\w+:)?)(twoCellAnchor|oneCellAnchor|absoluteAnchor)\\b.*?</\\1\\2>',re.S)\n    relitem=re.compile(r'<Relationship\\b[^>]*?/>')\n    dropped=set()\n    for name,content in list(parts.items()):\n        m=re.match(r'(xl/(?:separate\\d+/)?drawings)/(drawing\\d+)\\.xml$',name)\n        if not m:continue\n        relname=m.group(1)+'/_rels/'+m.group(2)+'.xml.rels'\n        if relname not in parts:continue\n        relxml=parts[relname].decode('utf-8');ids=set()\n        for item in relitem.findall(relxml):\n            rid=re.search(r'\\bId=\"([^\"]+)\"',item);tgt=re.search(r'\\bTarget=\"([^\"]+)\"',item)\n            if not rid or not tgt:continue\n            target=tgt.group(1)\n            media=target.lstrip('/') if target.startswith('/') else posixpath.normpath(posixpath.join(m.group(1),target))\n            data=parts.get(media)\n            if data is not None and hashlib.sha256(data).hexdigest() in HMV_LOGO_SHA256:ids.add(rid.group(1));dropped.add(media)\n        if not ids:continue\n        text=content.decode('utf-8')\n        parts[name]=anchors.sub(lambda mm:'' if any('\"%s\"'%i in mm.group(0) for i in ids) else mm.group(0),text).encode('utf-8')\n        parts[relname]=relitem.sub(lambda mm:'' if re.search(r'\\bId=\"([^\"]+)\"',mm.group(0)).group(1) in ids else mm.group(0),relxml).encode('utf-8')\n    for media in dropped:\n        base=posixpath.basename(media).encode('utf-8')\n        if not any(n.endswith('.rels') and base in c for n,c in parts.items()):parts.pop(media,None)\n\ndef elek_style_sheet(res,reverse,p):\n    \"\"\"Section list laid out like the ELEK Cable Pulling section list (No., Type, Specification, Length, Tension, SWBP, Result).\"\"\"\n    def fmt(x):return ('%.2f'%x).rstrip('0').rstrip('.')\n    root=fresh_sheet();put=lambda a,v:report_cell(root,a,v)\n    run=res['reverse' if reverse else 'forward'];order=list(reversed(res['segments'])) if reverse else res['segments']\n    put('A1','Section list, '+('reverse' if reverse else 'forward')+' pull, same columns as the ELEK Cable Pulling section list')\n    put('A2','Values at export. Pass = peak tension within the allowable pulling tension and peak sidewall force within the allowable sidewall pressure (IEEE Inputs). Tension is at the end of the section. Rerun the calculation after input changes.')\n    for c,h in enumerate(['No.','Type','Specification','Length (m)','Tension (N)','SWBP (N/m)','Result'],1):report_cell(root,col_label(c)+'3',h)\n    for i,(s,row) in enumerate(zip(order,run['rows']),1):\n        r=3+i;kind=route_section_type(s,reverse);length=s['length']\n        a0=-s['a1'] if reverse else s['a0'];a1=-s['a0'] if reverse else s['a1']\n        if s['kv']:spec='Radius = %s m, Angle = %s deg'%(fmt(abs(1/s['kv'])),fmt(math.degrees(abs(a1-a0))))\n        elif s['rh']:spec='Radius = %s m, Angle = %s deg'%(fmt(s['rh']),fmt(math.degrees(length/s['rh'])))\n        elif kind in ('Slope Up','Slope Down'):spec='Length = %s m, Angle = %s deg'%(fmt(length),fmt(math.degrees(abs((a0+a1)/2))))\n        else:spec='Length = %s m'%fmt(length)\n        t_end=row[10];peak=row[11];swbp=row[12]\n        curved=bool(s['kv'] or s['rh'])\n        if t_end is None:result='n/a'\n        elif peak>p['allowable_tension_N'] or (swbp is not None and swbp>p['allowable_swbp_N_m']):result='Fail'\n        elif swbp is None and curved:result='Review'\n        else:result='Pass'\n        report_cell(root,'A'+str(r),i);report_cell(root,'B'+str(r),kind);report_cell(root,'C'+str(r),spec);report_cell(root,'D'+str(r),round(length,2))\n        report_cell(root,'E'+str(r),None if t_end is None else round(t_end));report_cell(root,'F'+str(r),0 if not curved else (None if swbp is None else round(swbp)));report_cell(root,'G'+str(r),result)\n    report_widths(root,{1:7,2:28,3:44,4:12,5:14,6:14,7:10})\n    return root\n\ndef cable_data_sheet(p):\n    \"\"\"HV cable datasheet (Prysmian 76/132 kV 1C 1200 mm2 Al, submittal 9800-E-0021-PD) beside the values this calculation used.\"\"\"\n    root=fresh_sheet();put=lambda a,v:report_cell(root,a,v)\n    put('A1','Cable data');put('A2','Datasheet: HDL1A 9800-E-0021-PD, Prysmian 76/132 (145) kV, 1 core 1200 mm2 Al Milliken, XLPE, HDPE sheath, IEC 60840. Used = value in this calculation.')\n    for c,h in enumerate(['Item','Datasheet','Used','Unit','Check'],1):report_cell(root,col_label(c)+'3',h)\n    rows=[('Overall diameter',96.9,p['cable_diameter_mm'],'mm','eq'),('Weight per metre',10.3,p['cable_mass_kg_m'],'kg/m','eq'),\n          ('Minimum bending radius, installation',2.907,p.get('min_bend_install_m'),'m','eq'),('Minimum bending radius, installed',1.938,p.get('min_bend_static_m'),'m','eq'),\n          ('Maximum pulling tension, grip on sheath',28000.,p['allowable_tension_N'],'N','le'),('Maximum pulling tension, eye on conductor',36000.,p['allowable_tension_N'],'N','le'),\n          ('Maximum sidewall pressure',7500.,p['allowable_swbp_N_m'],'N/m','le')]\n    for i,(name,ds,used,unit,mode) in enumerate(rows,4):\n        ok='n/a' if used is None else (('Matches' if abs(used-ds)<1e-6 else 'Differs') if mode=='eq' else ('Within datasheet' if used<=ds+1e-6 else 'Exceeds datasheet'))\n        for col,v in zip('ABCDE',(name,ds,used,unit,ok)):report_cell(root,col+str(i),v)\n    for i,(name,v) in enumerate([('Conductor diameter (mm)',42.0),('Insulation diameter (mm)',78.6),('Screen diameter (mm)',86.2),('Sheath thickness (mm)','4.0 + 0.3'),\n        ('Rated temperature normal / emergency / short circuit (C)','90 / 105 / 250'),('Short circuit rating','40 kA, 0.5 s'),('Drum length (m)','800 or 1100')],12):\n        report_cell(root,'A'+str(i),name);report_cell(root,'B'+str(i),v)\n    report_cell(root,'A11','Allowable tension used as a fraction of the 28 kN grip limit (ELEK tension reduction factor)');report_cell(root,'C11',round(p['allowable_tension_N']/(28000.*p['cable_count']),4))\n    report_widths(root,{1:52,2:16,3:14,4:8,5:20})\n    return root\n\ndef export_live_template(path,runs,p):\n    raw=base64.b64decode(EMBEDDED_TEMPLATE)\n    with zipfile.ZipFile(io.BytesIO(raw)) as archive:parts={n:archive.read(n) for n in archive.namelist()}\n    workbook=ET.fromstring(parts['xl/workbook.xml']);rels=ET.fromstring(parts['xl/_rels/workbook.xml.rels'])\n    sheetels=workbook.find(tag('sheets'));source_paths=sheet_paths(zipfile.ZipFile(io.BytesIO(raw)))\n    # sheet_paths is a list of (name, path) in the parser.\n    source_paths=dict(source_paths)\n    inputs=ET.fromstring(parts[source_paths['IEEE Inputs']]);method=ET.fromstring(parts[source_paths['IEEE 1185-2019 Method']])\n    base=ET.fromstring(parts[source_paths['SS JB1']]);summary=ET.fromstring(parts[source_paths['Summary']])\n    clear_report(summary)\n    style=next(c.get('s','0') for c in base.findall('.//'+tag('c')) if c.get('r')=='M5')\n    styles=ET.fromstring(parts['xl/styles.xml']);xfs=styles.find(tag('cellXfs'));formats=styles.find(tag('numFmts'))\n    if formats is None:formats=ET.Element(tag('numFmts'));styles.insert(0,formats)\n    fmtid=max([163]+[int(x.get('numFmtId')) for x in formats])+1\n    ET.SubElement(formats,tag('numFmt'),{'numFmtId':str(fmtid),'formatCode':'0.000000'});formats.set('count',str(len(formats)))\n    precise=copy.deepcopy(xfs[int(style)]);precise.set('numFmtId',str(fmtid));precise.set('applyNumberFormat','1');precision_style=len(xfs);xfs.append(precise)\n    wrapped=copy.deepcopy(xfs[int(style)]);wrapped.set('numFmtId','0');alignment=wrapped.find(tag('alignment'))\n    if alignment is None:alignment=ET.SubElement(wrapped,tag('alignment'))\n    alignment.set('wrapText','1');alignment.set('vertical','center');wrapped.set('applyAlignment','1');wrap_style=len(xfs);xfs.append(wrapped)\n    xfs.set('count',str(len(xfs)));parts['xl/styles.xml']=ET.tostring(styles)\n    def ip(a,x):report_cell(inputs,a,x)\n    inputkeys={6:'cable_count',7:'cable_mass_kg_m',8:'gravity',9:'cable_diameter_mm',10:'conduit_diameter_mm',11:'friction',12:'initial_tension_N',13:'allowable_tension_N',14:'allowable_swbp_N_m',15:'allowable_fill',36:'formation',37:'manufacturer_swbp_factor'}\n    for row,key in inputkeys.items():ip('C'+str(row),p[key])\n    for row in range(6,16):ip('E'+str(row),'Dynamo cable settings; confirm for this project')\n    for a,v in {'A24':'Wc_diamond','B23':'Triangular candidate: 1 / sqrt(1 - r²)','B24':'Four cables in diamond: 1 + 2 r²','B25':'Cradled candidate: 1 + 4 r² / 3','B26':'Wc: cable count and project D/d rule','B33':'SWBP c: MWP formation factor; positive manufacturer override','A36':'formation','B36':'Cable arrangement','A37':'c_mfr','B37':'Manufacturer SWBP override (0 = MWP formation factor)','A38':'valid','B38':'Input validity'}.items():ip(a,v)\n    ratio=p['cable_diameter_mm']/(p['conduit_diameter_mm']-p['cable_diameter_mm'])\n    data={18:('C10-C9',p['conduit_diameter_mm']-p['cable_diameter_mm']),19:('C10/C9',p['conduit_diameter_mm']/p['cable_diameter_mm']),20:('C9/C18',ratio),21:('C20^2',ratio**2),22:('1-C21',1-ratio**2),23:('IF(C22>0,1/SQRT(C22),\"UNAVAILABLE\")',1/math.sqrt(1-ratio**2) if ratio<1 else 'UNAVAILABLE'),24:('1+2*C21',1+2*ratio**2),25:('1+4*C21/3',1+4*ratio**2/3),26:('IF(C6=1,1,IF(C6=2,C23,IF(C6=3,IF(C48>=0.5,IF(C36=\"Cradled\",C25,C23),IF(C19<=2.5,C23,IF(C19<=3,C24,C25))),IF(C6=4,C24,1.4))))',p['weight_correction']),27:('C11*C26',p['effective_friction']),28:('C6*C7',p['cable_count']*p['cable_mass_kg_m']),29:('C28*C8',p['weight_N_m']),30:('C9/C10',p['cable_diameter_mm']/p['conduit_diameter_mm']),31:('C30^2',(p['cable_diameter_mm']/p['conduit_diameter_mm'])**2),32:('C6*C31',p['fill']),33:('IF(C37>0,C37,IF(C6=1,1,IF(C6=2,C26/2,IF(C6=3,IF(C36=\"Cradled\",(3*C26-2)/3,C26/2),C26-1))))',p['swbp_factor'] if p['swbp_factor'] is not None else 'UNAVAILABLE'),34:('IF(C32<=C15,\"WITHIN LIMIT\",\"FAIL\")','WITHIN LIMIT')}\n    for row,(formula,value) in data.items():ip('C'+str(row),ExcelFormula(formula,value));ip('E'+str(row),'='+formula)\n    validity='IF(AND(C6=INT(C6),C6>=1,C7>0,C8>0,C9>0,C10>C9,C11>=0,C12>=0,C13>0,C14>0,C15>0,C15<=1,C32<=C15,C37>=0,OR(AND(C6=1,C36=\"Single\"),AND(OR(C6=2,C6=3),C36=\"Trefoil\"),AND(C6=3,C36=\"Cradled\"),AND(C6=4,C36=\"Diamond\"),AND(C6>4,C36=\"fourcables\")),ISNUMBER(C26)),\"VALID\",\"INVALID - rerun Dynamo\")'\n    validity=validity.replace('ISNUMBER(C26))','ISNUMBER(C26),C19>=IF(C6=2,2,IF(C6=3,1+2/SQRT(3),IF(C6=4,1+SQRT(2),1))))')\n    ip('C38',ExcelFormula(validity,'VALID'))\n    report_cell(inputs,'B43','Minimum bend radius during installation (m)');ip('C43',p['min_bend_install_m']);ip('E43','HV cable datasheet. 0 switches the bend radius check off.')\n    report_cell(inputs,'B44','Minimum bend radius installed (m)');ip('C44',p['min_bend_static_m']);ip('E44','HV cable datasheet. 0 switches the bend radius check off.')\n    report_cell(inputs,'B45','Grade break tolerance (deg)');ip('C45',p['grade_break_tol_deg']);ip('E45','Profile angle changes at or below this are treated as export approximation (parabola written as an arc), not a kink. 0 counts every break.')\n    report_cell(inputs,'B46','High sidewall friction coefficient (0 = off)');ip('C46',p['friction_high']);ip('E46','Applied to a whole section when the sidewall force at the start of that section exceeds the threshold below.')\n    report_cell(inputs,'B47','Sidewall pressure threshold (N/m)');ip('C47',p['sidewall_threshold_N_m']);ip('E47','Above this the high sidewall friction replaces the normal friction for that section.')\n    report_cell(inputs,'B50','Maximum tension per cable (N)');ip('C50',p.get('tension_per_cable_N',0.));ip('E50','HV cable datasheet: 28 kN pulling grip, 36 kN pulling eye. 0 = use the total allowable pulling tension input instead.')\n    report_cell(inputs,'B51','Tension reduction factor');ip('C51',p.get('tension_reduction',1.));ip('E51','Allowable pulling tension (C13) = number of cables x maximum tension per cable x this factor, as in ELEK Cable Pulling.')\n    report_cell(inputs,'B48','Three-cable factor rule (0 = project ratio rule, 1 = selected formation, IEEE)');ip('C48',p['three_cable_formation_rule']);ip('E48','1 uses the standard triangular factor for Trefoil and the cradled factor for Cradled, whatever the duct to cable ratio.')\n    report_cell(inputs,'B39','Wc rule source',wrap_style)\n    report_cell(inputs,'E39','Project-supplied three-cable D/d bands. Middle band 1+2r^2 is not the verified IEEE 1185-2010 rule. SWBP follows selected formation.',wrap_style)\n    report_height(inputs,39,70)\n    report_cell(inputs,'E26','Project three-cable ratio rule: <=2.5 triangular; 2.5<D/d<=3 uses 1+2r^2; >3 uses 1+4r^2/3. Middle band differs from verified IEEE 1185-2010.',wrap_style)\n    ip('E37','MWP PullCal_V9: Single=1; Trefoil=Wc/2; Cradled=(3Wc-2)/3; Diamond=Wc-1; fourcables=1.0 (conservative). Positive override takes priority.')\n    report_cell(inputs,'E37','MWP PullCal_V9: Single=1; Trefoil=Wc/2; Cradled=(3Wc-2)/3; Diamond=Wc-1; fourcables=1.0 (conservative). Positive override takes priority.',wrap_style)\n    report_height(inputs,37,60)\n    for row in (26,33,34):\n        report_cell(inputs,'E'+str(row),'='+data[row][0],wrap_style);report_height(inputs,row,55)\n    report_height(inputs,3,36);report_merge(inputs,'A3:E3')\n    report_cell(inputs,'A3','Live Excel formulas use a fixed exported mesh. Rerun Dynamo after input changes to check convergence.',wrap_style)\n    # Remove obsolete worked examples outside the method's print area. Retain diagrams.\n    for cell in method.findall('.//'+tag('c')):\n        addr=cell.get('r');row=int(re.search(r'\\d+',addr).group());col=col_number(re.sub(r'\\d','',addr))\n        if (col>11 or row>=60) and addr not in ('A77','A79','A81'):report_cell(method,addr,None)\n    for addr,formula,value in [('H8',\"'IEEE Inputs'!C7\",p['cable_mass_kg_m']),('H9',\"'IEEE Inputs'!C26\",p['weight_correction']),('H10',\"'IEEE Inputs'!C29\",p['weight_N_m']),('H11',\"'IEEE Inputs'!C11\",p['friction']),('H12',\"'IEEE Inputs'!C27\",p['effective_friction']),('H16',\"'IEEE Inputs'!C8\",p['gravity']),('H41',\"'IEEE Inputs'!C13\",p['allowable_tension_N']),('H47',\"'IEEE Inputs'!C14\",p['allowable_swbp_N_m']),('H51',\"'IEEE Inputs'!C12\",p['initial_tension_N'])]:report_cell(method,addr,ExcelFormula(formula,value))\n    for addr,formula,value in [('H42','H41/1000',p['allowable_tension_N']/1000),('H43','H41/H16',p['allowable_tension_N']/p['gravity']),('H48','H47/1000',p['allowable_swbp_N_m']/1000),('H49','H47/H16',p['allowable_swbp_N_m']/p['gravity'])]:report_cell(method,addr,ExcelFormula(formula,value))\n    for a,v in {'B18':'IEEE cable factors with general 3D force-balance integration. Units: N and N/m.','B20':'Straight','B21':'Level bend','B22':'Curved pull','B23':'Curvature','B24':'Contact force','B25':'Force balance','B26':'RK4 step','B27':'Joint','C30':'Î±'}.items():report_cell(method,a,v,wrap_style)\n    report_merge(method,'B18:K18');report_height(method,18,32)\n    report_cell(method,'K1','V21.5')\n    for row in range(20,28):report_merge(method,'B%d:D%d'%(row,row));report_merge(method,'E%d:K%d'%(row,row));report_height(method,row,42)\n    for row in (32,34):report_merge(method,'F%d:K%d'%(row,row));report_height(method,row,40)\n    for row in (36,37,38,39):report_merge(method,'B%d:K%d'%(row,row));report_height(method,row,32)\n    for row in (53,55,57,59):report_merge(method,'A%d:K%d'%(row,row));report_height(method,row,32)\n    for cell in method.findall('.//'+tag('c')):\n        if cell.find(tag('is')) is not None and int(re.search(r'\\d+',cell.get('r')).group())>=20:cell.set('s',str(wrap_style))\n    report_cell(summary,'A2','Cable pulling calculations — V21.5')\n    report_cell(summary,'A3','Template report with live formula working. Fixed mesh; rerun Dynamo after changing inputs.')\n    headings=['Route','Report page','Direction','Duct length (m)','Allowable T (N)','Allowable P (N/m)','Peak T (N)','Peak P (N/m)','Status']\n    for c,v in enumerate(headings,1):report_cell(summary,col_label(c)+'6',v)\n    report_widths(summary,{1:31,2:18,3:16,4:20,5:20,6:21,7:20,8:22,9:26})\n    for address,label in [('J6','Joints without radius'),('K6','SWBP coverage'),('L6','Smallest bend radius (m)'),('M6','Bend radius check')]:report_cell(summary,address,label,wrap_style)\n    report_widths(summary,{10:22,11:45,12:20,13:40});report_height(summary,6,36)\n    report_merge(summary,'A2:I2');report_merge(summary,'A3:I3');report_height(summary,3,36)\n    sheets=[('Summary',summary,source_paths['Summary']),('IEEE Inputs',inputs,source_paths['IEEE Inputs']),('IEEE 1185-2019 Method',method,source_paths['IEEE 1185-2019 Method'])];sr=7\n    for ri,run in enumerate(runs,1):\n        if 'result' not in run:\n            report_cell(summary,'A'+str(sr),run['route']);report_cell(summary,'I'+str(sr),'NOT CALCULATED: '+run['error']);sr+=1;continue\n        res=run['result'];directions=[]\n        for rev in (False,True):\n            headerstyle=next(c.get('s','0') for c in base.findall('.//'+tag('c')) if c.get('r')=='M4')\n            name='R%d %s steps'%(ri,'R' if rev else 'F');root,records=live_steps(res['segments'],p,rev,name,precision_style,headerstyle,wrap_style)\n            directions.append((name,records));sheets.append((name,root,None))\n        for rev in (False,True):sheets.append(('R%d %s list'%(ri,'R' if rev else 'F'),elek_style_sheet(res,rev,p),None))\n        if ri==1:sheets.append(('Cable data',cable_data_sheet(p),None))\n        pages=int(math.ceil(len(res['segments'])/93.))\n        for page in range(pages):\n            report=copy.deepcopy(base);clear_report(report);name='Route %d'%ri+(' p%d'%(page+1) if pages>1 else '')\n            put=lambda a,v:report_cell(report,a,v)\n            put('L1',run['route']);put('AC1','V21.5')\n            report_merge(report,'L2:AC2');report_merge(report,'M99:Q99');report_merge(report,'M198:Q198')\n            merges=report.find(tag('mergeCells'))\n            for m in list(merges):\n                if m.get('ref')=='X197:AB197':merges.remove(m)\n            merges.set('count',str(len(merges)))\n            cols=report.find(tag('cols'))\n            # Q was a two-character dropdown column in the source template.\n            for col in list(cols):\n                if int(col.get('min'))<=17<=int(col.get('max')):\n                    lo,hi=int(col.get('min')),int(col.get('max'));cols.remove(col)\n                    if lo<17:before=copy.deepcopy(col);before.set('max','16');cols.append(before)\n                    if hi>17:after=copy.deepcopy(col);after.set('min','18');cols.append(after)\n            ET.SubElement(cols,tag('col'),{'min':'17','max':'17','width':'22','customWidth':'1'})\n            cols[:]=sorted(cols,key=lambda col:int(col.get('min')))\n            put('L2','Working: use R%d F steps and R%d R steps. Angles signed in pulling direction.'%(ri,ri))\n            for reverse,(stepname,records) in enumerate(directions):\n                title,head,first,footer=(102,103,104,197) if reverse else (3,4,5,98)\n                put('L'+str(title),'Reverse' if reverse else 'Forward');put('N'+str(title),ExcelFormula(\"'IEEE Inputs'!C6\",p['cable_count']))\n                put('O'+str(title),run['route']);put('Z'+str(title),'Page %d/%d'%(page+1,pages))\n                labels=['Section','T1 (N)','Length (m)','R plan (m)','R profile (m)','Type','Station out (m)','Angle in (deg)','Angle out (deg)','kv (1/m)','Joint (rad)','Straight T2','Uphill T2','Downhill T2','Horizontal T2','Vertical/3D T2','T2 (N)','Side Wall Force (N/m)']\n                for col,label in enumerate(labels,12):put(col_label(col)+str(head),label)\n                subset=records[page*93:(page+1)*93];peakrefs=[];pref=[];jointcount=0\n                for offset,rec in enumerate(subset):\n                    row=first+offset;s=rec['segment'];a=-s['a1'] if reverse else s['a0'];b=-s['a0'] if reverse else s['a1'];jointcount+=bool(rec['joint']);q=\"'%s'!\"%stepname\n                    vals={'L':s['id'],'M':ExcelFormula(q+'G'+str(rec['first']),rec['tin'] if rec['tin'] is not None else 'UNAVAILABLE'),'N':s['length'],'O':s['rh'],'P':abs(1/s['kv']) if s['kv'] else None,'Q':s['kind'],'R':s['s0'] if reverse else s['s1'],'S':math.degrees(a),'T':math.degrees(b),'U':s['kv'],'V':rec['joint'],'AB':ExcelFormula(q+'Y'+str(rec['last']),rec['tout'] if rec['tout'] is not None else 'UNAVAILABLE'),'AC':ExcelFormula(q+'AC'+str(rec['last']),rec['pressure'] if rec['pressure'] is not None else 'UNAVAILABLE')}\n                    if not (s['kv'] or s['rh']):vals['AC']=ExcelFormula('\"\"','')\n                    category='AA' if s['kv'] else ('Z' if s['rh'] else ('X' if a>1e-7 else ('Y' if a<-1e-7 else 'W')))\n                    vals[category]=ExcelFormula('AB'+str(row),rec['tout'] if rec['tout'] is not None else 'UNAVAILABLE')\n                    for col,v in vals.items():put(col+str(row),v)\n                    for col in ('S','T','U','V'):report_cell(report,col+str(row),vals[col],precision_style)\n                    peakrefs.append(q+'AB'+str(rec['last']));pref.append(q+'AC'+str(rec['last']))\n                last=first+len(subset)-1;peak=max([r['peak'] for r in subset if r['peak'] is not None],default='UNAVAILABLE');pressure_complete=any(r['pressure'] is not None for r in subset)\n                pv=max((r['pressure'] for r in subset if r['pressure'] is not None),default=0.) if pressure_complete else 'UNAVAILABLE'\n                put('L'+str(footer),'Peak T (page)');put('M'+str(footer),ExcelFormula('IF(COUNT('+','.join(peakrefs)+')=0,\"UNAVAILABLE\",MAX('+','.join(peakrefs)+'))',peak))\n                put('R'+str(footer),'Allowable T');put('S'+str(footer),ExcelFormula(\"'IEEE Inputs'!C13\",p['allowable_tension_N']))\n                put('V'+str(footer),'Peak SWBP (page)');put('W'+str(footer),ExcelFormula('IF(COUNT(AC%d:AC%d)>0,MAX(AC%d:AC%d),\"UNAVAILABLE\")'%(first,last,first,last),pv))\n                put('AB'+str(footer),'Allowable SWBP');put('AC'+str(footer),ExcelFormula(\"'IEEE Inputs'!C14\",p['allowable_swbp_N_m']))\n                knownp=max((r['pressure'] for r in subset if r['pressure'] is not None),default=0.)\n                status='FAIL' if isinstance(peak,(float,int)) and peak>p['allowable_tension_N'] or knownp>p['allowable_swbp_N_m'] else 'REVIEW REQUIRED'\n                sf='IF(\\'IEEE Inputs\\'!C38<>\"VALID\",\"INVALID INPUT\",IF(OR(IF(ISNUMBER(M%d),M%d>S%d,FALSE),MAX(AC%d:AC%d)>AC%d),\"FAIL\",\"REVIEW REQUIRED\"))'%(footer,footer,footer,first,last,footer)\n                put('L'+str(footer+1),'Check');put('M'+str(footer+1),ExcelFormula(sf,status))\n                summaryvals=[run['route'],name,'Reverse' if reverse else 'Forward',sum(x['segment']['length'] for x in subset),ExcelFormula(\"'IEEE Inputs'!C13\",p['allowable_tension_N']),ExcelFormula(\"'IEEE Inputs'!C14\",p['allowable_swbp_N_m']),ExcelFormula(\"'%s'!M%d\"%(name,footer),peak),ExcelFormula(\"'%s'!W%d\"%(name,footer),pv),ExcelFormula(\"'%s'!M%d\"%(name,footer+1),status)]\n                for c,v in enumerate(summaryvals,1):report_cell(summary,col_label(c)+str(sr),v)\n                sr+=1\n            if ri == 1:route_one_reference_layout(report,base,directions,page,p,run)\n            add_route_section_types(report,directions,page,wrap_style)\n            for footer,row,known,joints,note in add_known_swbp_output(report,directions,page,wrap_style,style):\n                summaryrow=sr-2+(footer==197)\n                report_cell(summary,'J'+str(summaryrow),joints,wrap_style)\n                report_cell(summary,'K'+str(summaryrow),note,wrap_style)\n                report_cell(summary,'L'+str(summaryrow),res['bend']['min_radius'],wrap_style)\n                report_cell(summary,'M'+str(summaryrow),res['bend']['text'],wrap_style)\n                report_height(summary,summaryrow,36)\n            for _d in report.findall(tag('drawing')):report.remove(_d)\n            sheets.insert(3,(name,report,source_paths['SS JB1']))\n    hstyle=next((x.get('s','0') for x in base.findall('.//'+tag('c')) if x.get('r')=='M4'),'0')\n    sheets.insert(3,('Help - Equations',help_equations_sheet(wrap_style,hstyle),None))\n    report_display_units(sheets,inputs,p,wrap_style)\n    imported_names=import_separate_calculations(parts,sheets,SEPARATE_CALCULATIONS)\n    link_duct_calculations(sheets,p)\n    report_cell(summary,'A3','Fill and jamming tabs use Dynamo cable/duct inputs. Jamming criterion applies to three equal cables. Rerun Dynamo after route input changes.',wrap_style)\n    report_height(summary,3,54)\n    try:\n        _mu=float(p['friction'])\n    except Exception:\n        _mu=None\n    if _mu is None:\n        _fnote='Friction basis: confirm the friction coefficient used for this run.'\n    elif _mu<=0.3:\n        _fnote=('FRICTION NOTE: friction coefficient %.2f used for this run. This is a LUBRICATED pull value. '\n                'Cable outer sheath is HDPE (cable data sheet 9800-E-0021-PD); published lubricated polyethylene-jacket/duct values are about 0.05 to 0.15. '\n                'Pulling lubricant is REQUIRED: without lubricant friction is typically 0.35 to 0.5 and the pull exceeds the cable limits. '\n                'Confirm the friction value and lubricant compatibility with the cable and lubricant suppliers.') % _mu\n    else:\n        _fnote=('FRICTION NOTE: friction coefficient %.2f used for this run. This is an UNLUBRICATED or conservative value. '\n                'Lubricated pulls typically use about 0.2 or lower; compare with the lubricated case and confirm with the cable and lubricant suppliers.') % _mu\n    report_cell(summary,'A4',_fnote,wrap_style)\n    report_merge(summary,'A4:M4')\n    report_height(summary,4,66)\n    report_cell(method,'E21','Level horizontal reference: T2=T1*cosh(f_eff*theta)+sqrt(T1^2+(f_eff*W*g*R)^2)*sinh(f_eff*theta)',wrap_style)\n    report_cell(method,'E24','Level horizontal uses reference Eq.8; other 3D sections use resultant contact force.',wrap_style)\n    report_cell(method,'B59','Angles converted once; exact EXP; slope friction once; sidewall divides by radius. Fill and jamming sheets use the same cable count and diameters as the route.',wrap_style)\n    # Rebuild the workbook's sheet registry; preserve styles, drawings and media bytes.\n    sheetels.clear()\n    for relationship in list(rels):\n        if relationship.get('Type','').endswith(('/worksheet','/calcChain')):rels.remove(relationship)\n    for item in list(workbook):\n        if item.tag in (tag('definedNames'),tag('calcPr')):workbook.remove(item)\n    ET.SubElement(workbook,tag('calcPr'),{'calcId':'191029','fullCalcOnLoad':'1','forceFullCalc':'1','calcMode':'auto'})\n    types=ET.fromstring(parts['[Content_Types].xml']);ct='{http://schemas.openxmlformats.org/package/2006/content-types}'\n    for item in list(types):\n        if item.get('ContentType','').endswith(('worksheet+xml','calcChain+xml')):types.remove(item)\n    names=ET.SubElement(workbook,tag('definedNames'))\n    for index,(name,root,oldpath) in enumerate(sheets,1):\n        part='xl/worksheets/report%d.xml'%index;rid='report%d'%index\n        ET.SubElement(sheetels,tag('sheet'),{'name':name,'sheetId':str(index),'{'+REL+'}id':rid})\n        ET.SubElement(rels,'{http://schemas.openxmlformats.org/package/2006/relationships}Relationship',{'Id':rid,'Type':REL+'/worksheet','Target':'worksheets/report%d.xml'%index})\n        ET.SubElement(types,ct+'Override',{'PartName':'/'+part,'ContentType':'application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml'})\n        if oldpath:\n            oldrel=posixpath.dirname(oldpath)+'/_rels/'+posixpath.basename(oldpath)+'.rels'\n            if oldrel in parts:parts['xl/worksheets/_rels/report%d.xml.rels'%index]=parts[oldrel]\n        parts[part]=report_xml(root)\n        if name.startswith('Route '):ET.SubElement(names,tag('definedName'),{'name':'_xlnm.Print_Area','localSheetId':str(index-1)}).text=\"'%s'!$L$1:$AC$198\"%name\n        for key,value in imported_names.get(name,[]):ET.SubElement(names,tag('definedName'),{'name':key,'localSheetId':str(index-1)}).text=value\n    # Defined names precede calcPr in SpreadsheetML.\n    workbook.remove(names);workbook.insert(list(workbook).index(workbook.find(tag('calcPr'))),names)\n    workbook.attrib.pop('{http://schemas.openxmlformats.org/markup-compatibility/2006}Ignorable',None)\n    ET.register_namespace('',NS);ET.register_namespace('r',REL)\n    parts['xl/workbook.xml']=ET.tostring(workbook)\n    ET.register_namespace('','http://schemas.openxmlformats.org/package/2006/relationships')\n    parts['xl/_rels/workbook.xml.rels']=ET.tostring(rels)\n    ET.register_namespace('','http://schemas.openxmlformats.org/package/2006/content-types')\n    parts['[Content_Types].xml']=ET.tostring(types)\n    ET.register_namespace('',NS)\n    parts.pop('xl/calcChain.xml',None)\n    normalize_excel_metadata(parts)\n    remove_logo(parts)\n    scrub_dynamo(parts)\n    with zipfile.ZipFile(path,'x',zipfile.ZIP_DEFLATED) as archive:\n        for name,content in parts.items():archive.writestr(name,content)\n    _report_indices.clear()\n\n_snapshot_runner=run_from_dynamo\ndef run_from_dynamo(values):\n    EXTRA_SETTINGS.clear()\n    for k,v in zip(('min_bend_install_m','min_bend_static_m','grade_break_tol_deg','friction_high','sidewall_threshold_N_m','three_cable_formation_rule'),values[21:27]):\n        if isinstance(v,(int,float)) and not isinstance(v,bool):EXTRA_SETTINGS[k]=float(v)\n    preview=list(values[:20]);preview[3]=False\n    _per=values[27] if len(values)>27 else 0.;_fac=values[28] if len(values)>28 else 1.\n    _num=lambda x:isinstance(x,(int,float)) and not isinstance(x,bool)\n    if not _num(_per) or _per<0:raise ValueError('Maximum tension per cable must be zero or positive')\n    if not _num(_fac) or not 0<_fac<=1:raise ValueError('Tension reduction factor must be above 0 and at most 1')\n    EXTRA_SETTINGS['tension_per_cable_N']=float(_per);EXTRA_SETTINGS['tension_reduction']=float(_fac)\n    if _per>0:preview[11]=float(preview[4])*float(_per)*float(_fac)\n    out=_snapshot_runner(preview)\n    out[0]='V21.5: audited formulas; HV cable bend radius check added'\n    if values[3]:\n        folder=str(values[19] or '').strip()\n        if not os.path.isdir(folder):raise ValueError('Select an existing Excel export folder')\n        path=os.path.join(folder,'Civil3D_PullCal_V21_5_'+datetime.now().strftime('%Y%m%d_%H%M%S_%f')+'.xlsx')\n        reportsettings=dict(out[3][1]);reportsettings['report_kg_units']=bool(values[20]) if len(values)>20 else False\n        export_live_template(path,out[4][1],reportsettings);out[1]=path\n    return out\n\nif 'IN' in globals():\n    OUT=run_from_dynamo(IN[:20]+[IN[24] if len(IN)>24 else False]+[IN[25] if len(IN)>25 else 2.907,IN[26] if len(IN)>26 else 1.938,IN[27] if len(IN)>27 else 0.3,IN[28] if len(IN)>28 else 0.,IN[29] if len(IN)>29 else 2185.,IN[30] if len(IN)>30 else 0.,IN[31] if len(IN)>31 else 0.,IN[32] if len(IN)>32 else 1.])\n    OUT.append(inspect_work(OUT,IN[20:24]))\n",
