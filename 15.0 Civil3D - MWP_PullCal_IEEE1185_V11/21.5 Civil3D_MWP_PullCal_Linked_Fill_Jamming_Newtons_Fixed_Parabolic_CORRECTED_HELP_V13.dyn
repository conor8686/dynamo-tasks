        },
        {
          "Id": "9d2d3b7c63004f29af53ac68e898ca96",
          "Name": "kh",
          "Description": "kh = ((Rh == 0 ? 0 : ((DSCore.Math.Cos(exitAngle)) * (DSCore.Math.Cos(exitAngle))) / safeRadius))",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "58be6ef0b3ac4644882b84d14efdc113",
          "Name": "kappa",
          "Description": "kappa = DSCore.Math.Sqrt((kh * kh) + (kv * kv))",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "ada37989e6a24ef2a2a3582c08cc0c02",
          "Name": "P",
          "Description": "P = ((c == null ? null : (c * T2) * kappa))",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "cc69e9a6f2924c49a3f785007c88b5b0",
          "Name": "differenceP",
          "Description": "differenceP = ((c == null ? null : P - expectedP))",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "df9783c372a74fbb93ea918608f6df17",
          "Name": "pressureMatches",
          "Description": "pressureMatches = ((c == null ? null : (differenceP > -1E-06) && (differenceP < 1E-06)))",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "// P = c T kappa. Null c means manufacturer factor required.\nexitAngle = alpha + Math.RadiansToDegrees(kv*h);\nsafeRadius = Rh == 0 ? 1 : Rh;\nkh = Rh == 0 ? 0 : Math.Cos(exitAngle)*Math.Cos(exitAngle)/safeRadius;\nkappa = Math.Sqrt(kh*kh + kv*kv);\nP = c == null ? null : c*T2*kappa;\ndifferenceP = c == null ? null : P-expectedP;\npressureMatches = c == null ? null : (differenceP > -0.000001 && differenceP < 0.000001);\n// Whole-section peak is in Selected calculation / selection."
    },
