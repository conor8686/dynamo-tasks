          "Description": "h",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "5e1d2797296743f4af994e6223e18c39",
          "Name": "T",
          "Description": "T",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "2b315b9877ae4f3f9f492a312dd3f337",
          "Name": "expectedT",
          "Description": "expectedT",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "08acdcf3c6f84f209d8c62e2ae00687d",
          "Name": "weightedRate",
          "Description": "weightedRate = ((k1 + (2 * k2)) + (2 * k3)) + k4",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "9d44c7f0093f4741939d77b61dc86509",
          "Name": "increment",
          "Description": "increment = (h * weightedRate) / 6",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "41bb2af25451492286faeff09fd70d04",
          "Name": "rawT2",
          "Description": "rawT2 = T + increment",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "15e252d5576644119ca4fd9361fa0aa6",
          "Name": "T2",
          "Description": "T2 = ((rawT2 < 0 ? 0 : rawT2))",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "dd4a182e0b6647f9a25f38ef82d84ff6",
          "Name": "differenceN",
          "Description": "differenceN = T2 - expectedT",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "816757dc3e604cfa8fffb1a5b5e80379",
          "Name": "stepMatches",
          "Description": "stepMatches = (differenceN > -1E-06) && (differenceN < 1E-06)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "// Weighted RK4 increment. This is ONE selected step.\nweightedRate = k1 + 2*k2 + 2*k3 + k4;\nincrement = h * weightedRate / 6;\nrawT2 = T + increment;\nT2 = rawT2 < 0 ? 0 : rawT2;\ndifferenceN = T2 - expectedT;\n// Bounds avoid Dynamo's ambiguous Abs(int)/Abs(double) overload.\nstepMatches = differenceN > -0.000001 && differenceN < 0.000001;"
    },
