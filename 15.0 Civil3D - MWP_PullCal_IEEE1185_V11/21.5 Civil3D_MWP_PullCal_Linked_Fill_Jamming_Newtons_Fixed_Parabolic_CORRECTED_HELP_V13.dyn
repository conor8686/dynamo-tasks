        }
      ],
      "Outputs": [
        {
          "Id": "0eac53909fb74f66b075177c2085e120",
          "Name": "valid",
          "Description": "valid = (((((T1 >= 0) && (W >= 0)) && (f >= 0)) && (L >= 0)) && (angleDeg >= 0)) && (angleDeg <= 90)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "4aba50ac92c2431a98367b83ef81eaba",
          "Name": "cosAngle",
