        },
        {
          "Id": "db6484ee10f94f4091151ef0744f1cbd",
          "Name": "increment",
          "Description": "increment = (W * L) * (frictionTerm + gravityTerm)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "f4d3ded06da744e6b4da96f8b0db7d7c",
          "Name": "rawT2",
          "Description": "rawT2 = T1 + increment",
