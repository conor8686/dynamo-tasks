          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "954edb1dddd54535b853e1f413c59439",
          "Name": "T2",
          "Description": "T2 = ((valid && (rawT2 >= 0) ? rawT2 : null))",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "8ead01d81c2748f4b1c9292649464f59",
          "Name": "status",
          "Description": "status = ((valid ? (rawT2 >= 0 ? \"Taut solution\" : \"Loss of taut tension - use general solver\") : \"Invalid input\"))",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "// L is actual cable length along the section.\nvalid = T1 >= 0 && W >= 0 && f >= 0 && L >= 0 && angleDeg >= 0 && angleDeg <= 90;\ncosAngle = Math.Cos(angleDeg);\nsinAngle = Math.Sin(angleDeg);\nfrictionTerm = f * cosAngle;\ngravityTerm = sinAngle;\nincrement = W * L * (frictionTerm + gravityTerm);\nrawT2 = T1 + increment;\nT2 = valid && rawT2 >= 0 ? rawT2 : null;\nstatus = valid ? (rawT2 >= 0 ? \"Taut solution\" : \"Loss of taut tension - use general solver\") : \"Invalid input\";"
    },
