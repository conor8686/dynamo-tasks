        },
        {
          "Id": "2c675f673a274b1ca9e18103c906a41d",
          "Name": "Three_cable_factor_rule",
          "Description": "0 = project ratio rule, 1 = standard factor for the selected formation (Trefoil triangular, Cradled cradled).",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "3ce9759849044be1950ea453eb229d3f",
          "Name": "Max_tension_per_cable_N",
          "Description": "Maximum pulling tension of one cable (N), e.g. 28000 pulling grip or 36000 pulling eye. Allowable tension = cables x this x reduction factor. 0 = use the total allowable pulling tension input.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
