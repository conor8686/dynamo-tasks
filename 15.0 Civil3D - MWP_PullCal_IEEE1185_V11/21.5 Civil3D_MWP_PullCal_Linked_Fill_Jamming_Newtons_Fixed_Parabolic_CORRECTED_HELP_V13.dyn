      "Code": "T1 = q[0];\nL = q[1];\nangle = q[2];\nRh = q[3];\nplanLength = q[4];\nkv = q[5];\nsectionExit = q[6];\npreviousT = q[7];\njointDegrees = q[8];\npeakT = q[9];\npeakP = q[10];\njointRadians = Math.DegreesToRadians(jointDegrees);\njointT1 = previousT*Math.Exp(f*jointRadians);\njointDifference = jointT1-T1;"
    },
