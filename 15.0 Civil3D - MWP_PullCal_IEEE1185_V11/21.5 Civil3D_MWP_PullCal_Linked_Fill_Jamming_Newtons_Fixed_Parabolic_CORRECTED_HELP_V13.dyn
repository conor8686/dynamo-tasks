  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import builtins\nimport json\nimport clr\nkey = '_mwp_profile_selection_7fa3c8bb58de4a81ba6c217654ff0a12'\nif bool(IN[0]):\n    # Clear before browsing: cancel never silently exports the previous route.\n    setattr(builtins, key, None)\n    clr.AddReference('System.Windows.Forms')\n    from System.Windows.Forms import OpenFileDialog, DialogResult\n    from System.Threading import Thread, ThreadStart, ApartmentState\n    response = {'files': None, 'error': None}\n    def browse():\n        dialog = OpenFileDialog()\n        try:\n            dialog.Title = 'Select the XY profile AND Z entity Excel report for each route (Ctrl-click; several routes = batch run, same cable inputs)'\n            dialog.Filter = 'Excel reports (*.xlsx)|*.xlsx'\n            dialog.Multiselect = True\n            dialog.CheckFileExists = True\n            dialog.RestoreDirectory = True\n            if dialog.ShowDialog() == DialogResult.OK:\n                response['files'] = [str(p) for p in dialog.FileNames]\n        except Exception as error:\n            response['error'] = str(error)\n        finally:\n            dialog.Dispose()\n    worker = Thread(ThreadStart(browse))\n    worker.SetApartmentState(ApartmentState.STA)\n    worker.Start()\n    worker.Join()\n    if response['error']:\n        raise ValueError(response['error'])\n    files = response['files']\n    if files is None:\n        raise ValueError('Selection cancelled. No calculation/export was made.')\n    if len(files) < 2 or len(files) % 2:\n        raise ValueError('Select an XY report and a Z entity report for every route '\n                         '(%d files selected). Several routes = batch run.' % len(files))\n    setattr(builtins, key, json.dumps(files))\nOUT = getattr(builtins, key, None)\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "7fa3c8bb58de4a81ba6c217654ff0a12",
