      ],
      "Outputs": [
        {
          "Id": "00df3e441feb4a11a4a9dc69a83af5cf",
          "Name": "exitAngle",
          "Description": "exitAngle = alpha + (DSCore.Math.RadiansToDegrees(kv * h))",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "00fc8b4673574d18bfee83aaf2bfd701",
          "Name": "safeRadius",
