    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "Id": "900f2812763b4b5dbd97a55ce9ef449b",
      "NodeType": "CodeBlockNode",
      "Inputs": [
        {
          "Id": "d2cd29b1d4b3452898425e91b729e618",
          "Name": "result",
          "Description": "result",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "c15f60ed9fd7480abf0871356957d7a3",
          "Name": "data",
          "Description": "data = DesignScript.Builtin.Get.ValueAtIndex(result, 6)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "e5095c49636140b89dbfbd611f0f04cd",
          "Name": "cable",
          "Description": "cable = DesignScript.Builtin.Get.ValueAtIndex(data, 0)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "0342a7a1c5df49d5aeb157a8a3ec48ca",
          "Name": "step",
          "Description": "step = DesignScript.Builtin.Get.ValueAtIndex(data, 1)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "6b755a57ac504c97bb171b63145a5e34",
          "Name": "geometry",
          "Description": "geometry = DesignScript.Builtin.Get.ValueAtIndex(data, 2)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "e18c83525d18472284e61504f6659a0b",
          "Name": "selection",
          "Description": "selection = DesignScript.Builtin.Get.ValueAtIndex(data, 3)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "// Change the four Inspect inputs then Run.\ndata = result[6];\ncable = data[0];\nstep = data[1];\ngeometry = data[2];\nselection = data[3];"
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "Id": "3f1f62edfd3641bca5527d2065656339",
      "NodeType": "CodeBlockNode",
      "Inputs": [
        {
          "Id": "ddb4cb75428e4346a4192fa755e70059",
          "Name": "x",
          "Description": "x",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "f339368365bc443d8fe91fb33116e9eb",
          "Name": "n",
          "Description": "n = DesignScript.Builtin.Get.ValueAtIndex(x, 0)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "35d1b041c5b8421e9e618ad86f80414d",
          "Name": "m",
          "Description": "m = DesignScript.Builtin.Get.ValueAtIndex(x, 1)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "6f5a4dd294304e8ea82c99c0094eb301",
          "Name": "g",
          "Description": "g = DesignScript.Builtin.Get.ValueAtIndex(x, 2)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "e551ca4da3844576b87975e6909111df",
          "Name": "d",
          "Description": "d = DesignScript.Builtin.Get.ValueAtIndex(x, 3)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "9a15e311c71e499fb038c972aeca89d8",
          "Name": "D",
          "Description": "D = DesignScript.Builtin.Get.ValueAtIndex(x, 4)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "0e8cc3484b0a4f458ece2b9eb43e5c51",
          "Name": "mu",
          "Description": "mu = DesignScript.Builtin.Get.ValueAtIndex(x, 5)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "bc1f72ab8f77456782bfe20e43b9018f",
          "Name": "triangular",
          "Description": "triangular = DesignScript.Builtin.Get.ValueAtIndex(x, 6)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "4c312d28557040229711cd5b28202797",
          "Name": "r",
          "Description": "r = d / (D - d)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "c7f0db8ed62145fa96cb0c9e52ccff90",
          "Name": "safeRoot",
          "Description": "safeRoot = DSCore.Math.Sqrt((n == 1 ? 1 : 1 - (r * r)))",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "7543fb78e0a8459b801bde8342d225d0",
          "Name": "WcTriangle",
          "Description": "WcTriangle = 1 / safeRoot",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "5f7a831265f647d68378a8607e82e09a",
          "Name": "WcCradle",
          "Description": "WcCradle = 1 + (((4 / 3) * r) * r)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "6c2773c4c69a40ca80bb606cef7a0dbd",
          "Name": "WcDiamond",
          "Description": "WcDiamond = 1 + ((2 * r) * r)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "1793f2fcb38f45a392f3ddc714abd7a7",
          "Name": "Wc",
          "Description": "Wc = ((n == 1 ? 1 : (n == 2 ? WcTriangle : (n == 3 ? ((D / d) <= 2.5 ? WcTriangle : ((D / d) <= 3 ? WcDiamond : WcCradle)) : (n == 4 ? WcDiamond : 1.4)))))",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "2fa3807dec2e4d69bff9f40281b80a4f",
          "Name": "W",
          "Description": "W = (n * m) * g",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "022e479e3d694fad95d1c0d26a5480f5",
          "Name": "f",
          "Description": "f = mu * Wc",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "7c5761cd79a04ef19e596c80debe2534",
          "Name": "fill",
          "Description": "fill = (n * (d / D)) * (d / D)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "b0b6c4e7493b4448a7187a8e53b2c19a",
          "Name": "WcDifference",
          "Description": "WcDifference = Wc - (DesignScript.Builtin.Get.ValueAtIndex(x, 7))",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "14567ea8bff34158881d6f5789f206ea",
          "Name": "manufacturerC",
          "Description": "manufacturerC = DesignScript.Builtin.Get.ValueAtIndex(x, 8)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "13afc1a27e754e3abee78fc19e0c5955",
          "Name": "ieeeC",
          "Description": "ieeeC = ((n == 1 ? 1 : (n == 2 ? Wc / 2 : (n == 3 ? (triangular ? Wc / 2 : ((3 * Wc) - 2) / 3) : (n == 4 ? Wc - 1 : 1)))))",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "6af9ac5885824666a613c898c68343e8",
          "Name": "c",
          "Description": "c = ((manufacturerC > 0 ? manufacturerC : ieeeC))",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "// kg/m -> N/m: gravity is included ONCE.\nn = x[0];\nm = x[1];\ng = x[2];\nd = x[3];\nD = x[4];\nmu = x[5];\ntriangular = x[6];\nr = d / (D - d);\nsafeRoot = Math.Sqrt(n == 1 ? 1 : 1-r*r);\nWcTriangle = 1 / safeRoot;\nWcCradle = 1 + (4.0/3.0)*r*r;\nWcDiamond = 1 + 2*r*r;\nWc = n == 1 ? 1 : (n == 2 ? WcTriangle : (n == 3 ? (D/d <= 2.5 ? WcTriangle : (D/d <= 3 ? WcDiamond : WcCradle)) : (n == 4 ? WcDiamond : 1.4)));\nW = n * m * g;\nf = mu * Wc;\nfill = n * (d/D) * (d/D);\nWcDifference = Wc - x[7];\nmanufacturerC = x[8];\nieeeC = n == 1 ? 1 : (n == 2 ? Wc/2 : (n == 3 ? (triangular ? Wc/2 : (3*Wc-2)/3) : (n == 4 ? Wc-1 : 1)));\nc = manufacturerC > 0 ? manufacturerC : ieeeC;"
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "Id": "bc192a1be2f44871974f50caaf629a1f",
      "NodeType": "CodeBlockNode",
      "Inputs": [
        {
          "Id": "e5674b4707c3488c9e8bc67a926e2769",
          "Name": "s",
          "Description": "s",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "bc9b739731c34dca87a6ad0b9886650b",
          "Name": "T",
          "Description": "T = DesignScript.Builtin.Get.ValueAtIndex(s, 0)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "9040a28915be48faaaa7a0b2629afca9",
          "Name": "alpha",
          "Description": "alpha = DesignScript.Builtin.Get.ValueAtIndex(s, 1)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "1be122257ac24150a0cda5bf96a771c9",
          "Name": "kv",
          "Description": "kv = DesignScript.Builtin.Get.ValueAtIndex(s, 2)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
