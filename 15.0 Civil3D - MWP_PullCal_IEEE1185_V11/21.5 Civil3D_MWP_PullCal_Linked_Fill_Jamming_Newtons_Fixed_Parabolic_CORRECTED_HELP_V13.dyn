          "KeepListStructure": false
        },
        {
          "Id": "1e1d068417894224bbfc700ddd5ff28e",
          "Name": "horizontalContact",
          "Description": "horizontalContact = stageT * kh",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "1a8ba4c4fed14ed39e7cb4e4ee19d87a",
          "Name": "verticalContact",
          "Description": "verticalContact = (stageT * kv) - (W * (DSCore.Math.Cos(stageAngle)))",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "1ece23108c4c4ec3a645047b3c253523",
          "Name": "normalForce",
          "Description": "normalForce = DSCore.Math.Sqrt((horizontalContact * horizontalContact) + (verticalContact * verticalContact))",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "e4b79d7254e047e68ae9b3569226f5ff",
          "Name": "frictionForce",
          "Description": "frictionForce = f * normalForce",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "0fbf3d03e4cd40d6857cb0299781dd8e",
          "Name": "gravityForce",
          "Description": "gravityForce = W * (DSCore.Math.Sin(stageAngle))",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "9c1f54cdbc294f44bb7178e1bf1ea37d",
          "Name": "rate",
          "Description": "rate = frictionForce + gravityForce",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "// dT/dl: same balance for straight, vertical and compound bends.\nstageT = T + h*k;\nstageAngle = alpha + Math.RadiansToDegrees(kv*h);\nsafeRadius = Rh == 0 ? 1 : Rh;\nkh = Rh == 0 ? 0 : Math.Cos(stageAngle)*Math.Cos(stageAngle)/safeRadius;\nhorizontalContact = stageT * kh;\nverticalContact = stageT * kv - W * Math.Cos(stageAngle);\nnormalForce = Math.Sqrt(horizontalContact*horizontalContact + verticalContact*verticalContact);\nfrictionForce = f * normalForce;\ngravityForce = W * Math.Sin(stageAngle);\nrate = frictionForce + gravityForce;"
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "Id": "0f79413684744f65a15fee0689df498f",
      "NodeType": "CodeBlockNode",
      "Inputs": [
        {
