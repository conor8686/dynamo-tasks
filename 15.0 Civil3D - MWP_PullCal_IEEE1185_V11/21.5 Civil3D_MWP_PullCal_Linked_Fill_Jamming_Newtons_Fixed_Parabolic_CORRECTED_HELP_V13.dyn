    "Annotations": [
      {
        "Id": "3b2445507d8a4816a51368a725437ff9",
        "Title": "1 | Route reports and Excel export",
        "DescriptionText": "Choose the XY and Z Civil 3D reports and where the Excel report is saved.\n- Select reports | True then Run: True opens the file browser for the XY and Z Civil 3D reports.\n- Browse | select XY and Z reports: File dialog. Pick one XY and one Z report per route (several routes = batch run).\n- Browse for Excel export folder: True opens the folder browser for the Excel output.\n- Browse | choose Excel export folder: Folder dialog. Returns the export folder path.\n- Write new Excel report: True writes a new Excel workbook for the run.",
        "IsExpanded": true,
        "WidthAdjustment": 0.0,
        "HeightAdjustment": 0.0,
        "Nodes": [
          "7fa3c8bb58de4a81ba6c217654ff0a12",
          "2f5b4fbdc67c4098864b539aeb44e989",
          "ba090b129c294201ad2359769f546aad",
          "4bc7b98a7fee45b196c4d8bd4f74bc0b",
          "8d091a5cb042463aa01103e37baaa654"
        ],
        "HasNestedGroups": false,
        "Left": -569.5894,
        "Top": -124.1908,
        "Width": 1230.0,
        "Height": 1006.3257,
        "FontSize": 36.0,
        "GroupStyleId": "00000000-0000-0000-0000-000000000000",
        "InitialTop": 80.2092,
        "InitialHeight": 771.9257,
        "TextblockHeight": 194.4,
        "Background": "#FFB9F9E7"
      },
      {
        "Id": "1cc11f0fdbe74eadadad0253c81f8273",
        "Title": "2 | Cable, duct and limits",
        "DescriptionText": "HDL1A 132 kV cable in a 160 OD duct, and the pull limits.\n- Number of cables: Cables pulled together in one duct (1 for the HV cable).\n- Allowable pulling tension, total: Total tension limit in N. Used only when max tension per cable is 0.\n- Mass per cable: Cable mass in kg/m (10.3 for the HV cable).\n- Maximum tension per cable: Per-cable limit in N (28000 grip). Allowable = cables x this x reduction factor.\n- Cable outside diameter: Cable outside diameter in mm (96.9).\n- Tension reduction factor: Fraction of the max tension used as the limit (ELEK default 0.8).\n- Conduit inside diameter: Duct bore in mm (144.8 for 160 OD SDR21).\n- Allowable sidewall pressure: Maximum sidewall bearing pressure in N/m.\n- Friction coefficient: Normal friction between cable and duct.\n- Allowable conduit fill: Largest cable fill of the duct (0.53 for a single cable).\n- Gravity: Converts kg/m to N/m.\n- Cable formation: Single, Trefoil, Cradled, Diamond or more than four cables.\n- Starting pulling tension: Reel back tension at the start of the pull (N).\n- Project cable assumptions confirmed: Set True once the cable data is checked, otherwise the report flags REVIEW.",
        "IsExpanded": true,
        "WidthAdjustment": 0.0,
        "HeightAdjustment": 0.0,
        "Nodes": [
          "44606c2e65e441328bfb5e4300bbb3c6",
          "7181b1a5ccb6439aa0f846a9e8db8aa3",
          "4d3d834a60f346a4a2206a9e91929551",
          "7a1fc1a70f054a59b0ec468bf2e4fc03",
          "c3de552106d844bfbb80b9fe0aef6995",
          "d23f292950f24d35b575a2eee0361643",
          "2fbe20b11abd4002b59a134192d48b61",
          "4cbc22d4249b42f68efef01ca3720e97",
          "2a28f8587068451980737588764f40ea",
          "12c4e87b2ee64822bf865cffe7f2f0af",
          "b3d54a7783594fc9a2ec56de0f79a41c",
          "93df01b6454441db9adb94564a641a9e",
          "dc18075aca7544649425bd4e25a31361",
          "6435b6ad2aa04e6197716c92853ee299"
        ],
        "HasNestedGroups": false,
        "Left": 1220.0,
        "Top": -402.4,
        "Width": 1180.0,
        "Height": 1517.4,
        "FontSize": 36.0,
        "GroupStyleId": "00000000-0000-0000-0000-000000000000",
        "InitialTop": 0.0,
        "InitialHeight": 1085.0,
        "TextblockHeight": 392.4,
        "Background": "#FFFFC999"
      },
      {
        "Id": "9a580d42d01b407aa1974e8dee9ed4a8",
        "Title": "3 | Solver settings and bend radius",
        "DescriptionText": "Step sizes, friction switch, bend radius limits and units.\n- Maximum integration step: Longest RK4 step along the route (m).\n- Maximum angle step: Largest angle change per integration step (deg).\n- Grade break tolerance: Profile angle changes at or below this (deg) are not treated as grade breaks.\n- Minimum bend radius during installation: Cable minimum bending radius while pulling (m). 0 switches the check off.\n- Minimum bend radius installed: Cable minimum bending radius once installed (m). 0 switches the check off.\n- High sidewall friction coefficient: Friction used where sidewall pressure is above the threshold (0 = off).\n- Sidewall pressure threshold: Sidewall pressure above which the high friction applies (N/m).\n- Three-cable factor rule: 0 = project ratio rule, 1 = selected formation (IEEE).\n- Manufacturer SWBP override: Manufacturer sidewall factor. 0 uses the MWP formation factor.\n- Report units: True = kg / kg per m; False = N / N per m: False = N and N/m. True = kg and kg/m.",
        "IsExpanded": true,
        "WidthAdjustment": 0.0,
        "HeightAdjustment": 0.0,
        "Nodes": [
          "54c1222a9a944a6ba8fcbad67329e03a",
          "5bbc9930b9f747b092c1b46658c35ab8",
          "48ee195dbda2470e855c9f0731847d3c",
          "6fe0469a2af6481f8f289185db48e13b",
          "af374772295e4a16ae3296d976b6ce59",
          "9f6734a08fb54055aaa776ac054c0885",
          "edea4a05f6544c4cbd68fd03071f79e2",
          "9cdc53a0b4534de0a6581dfe6cc71b19",
          "ecba1281187f4cc28e1083dffa06fcbb",
          "6abf3fe607694b94bb061f8877760a58"
        ],
        "HasNestedGroups": false,
        "Left": -352.0,
        "Top": 969.6,
        "Width": 900.0,
        "Height": 2200.4,
