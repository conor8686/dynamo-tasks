      "InputValue": "N:\\24974\\01 WIP\\01 - Drawings and Models\\01 - Civil\\03 - Sketch SK\\05 - Grid Team\\01 - GIS SKETCH WORK\\03 - SHPs\\Water_Sewer_SHP"
    },
    {
      "ConcreteType": "CoreNodeModels.Input.Directory, CoreNodeModels",
      "Id": "4a0dfd57ed5d480c997bbc227e1bd63f",
      "NodeType": "ExtensionNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "bfaeb0329f324029a412e209c5eecc38",
          "Name": "",
          "Description": "Directory Path",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows you to select a directory on the system and returns its path",
      "HintPath": "C:\\Users\\Conor.mcenery\\Documents",
      "InputValue": "C:\\Users\\Conor.mcenery\\Documents"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import struct\nimport os\nimport glob\nimport csv\n\nfolder = IN[0]\nout_folder = IN[1] if IN[1] else folder\n\ndef read_dbf(path):\n    with open(path, 'rb') as f:\n        data = f.read()\n\n    num_records = struct.unpack('<I', data[4:8])[0]\n    header_size = struct.unpack('<H', data[8:10])[0]\n    record_size = struct.unpack('<H', data[10:12])[0]\n\n    fields = []\n    pos = 32\n    while data[pos:pos+1] != b'\\r':\n        name = data[pos:pos+11].split(b'\\x00')[0].decode('latin-1')\n        ftype = data[pos+11:pos+12].decode('latin-1')\n        flen = data[pos+16]\n        fields.append((name, ftype, flen))\n        pos += 32\n\n    records = []\n    rec_start = header_size\n    for _ in range(num_records):\n        rec = data[rec_start:rec_start+record_size]\n        rec_start += record_size\n        if rec[0:1] == b'*':\n            continue\n        row = {}\n        offset = 1\n        for name, ftype, flen in fields:\n            raw = rec[offset:offset+flen].decode('latin-1', errors='replace').strip()\n            offset += flen\n            if ftype in ('N', 'F'):\n                try:\n                    row[name] = float(raw) if raw not in ('', '.') else None\n                except ValueError:\n                    row[name] = raw\n            else:\n                row[name] = raw\n        records.append(row)\n    return [f[0] for f in fields], records\n\nshp_paths = sorted(glob.glob(os.path.join(folder, '*.shp')))\n\nall_headers = []\nseen = set()\ntagged_records = []\n\nfor shp_path in shp_paths:\n    dbf_path = os.path.splitext(shp_path)[0] + '.dbf'\n    layer_name = os.path.splitext(os.path.basename(shp_path))[0]\n    if not os.path.exists(dbf_path):\n        continue\n    headers, records = read_dbf(dbf_path)\n    for h in headers:\n        if h not in seen:\n            seen.add(h)\n            all_headers.append(h)\n    for r in records:\n        tagged_records.append((layer_name, r))\n\nfinal_headers = ['SOURCE_LAYER'] + all_headers\ntable = [final_headers]\nfor layer_name, r in tagged_records:\n    table.append([layer_name] + [r.get(h) for h in all_headers])\n\ncsv_path = os.path.join(out_folder, 'combined_shapefile_table.csv')\nwith open(csv_path, 'w', newline='', encoding='utf-8-sig') as f:\n    writer = csv.writer(f)\n    for row in table:\n        writer.writerow(['' if v is None else v for v in row])\n\nOUT = table, csv_path",
      "Engine": "CPython3",
      "VariableInputPorts": true,
