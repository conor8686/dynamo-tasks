{
  "Uuid": "0cb37038-b579-4974-9449-2625b04e4569",
  "IsCustomNode": false,
  "Description": "Point at a folder containing several shapefiles and get one combined table back (header row + one row per feature across all .shp layers, tagged by SOURCE_LAYER), plus a saved combined_shapefile_table.csv written into a separate folder you choose. No external libraries required.",
  "Name": "MultiShapefileDBF_to_Table",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "CoreNodeModels.Input.Directory, CoreNodeModels",
