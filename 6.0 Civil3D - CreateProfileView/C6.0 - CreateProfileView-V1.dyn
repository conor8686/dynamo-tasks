  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# CreateProfileView v3.21\r\nimport sys\r\nimport math\r\nimport System\r\nimport clr\r\nclr.AddReference('AcMgd')\r\nclr.AddReference('AcDbMgd')\r\nclr.AddReference('AcCoreMgd')\r\nclr.AddReference('AeccDbMgd')\r\n\r\nimport Autodesk.AutoCAD.ApplicationServices as AcAppServ\r\nimport Autodesk.AutoCAD.DatabaseServices as AcDb\r\nimport Autodesk.AutoCAD.EditorInput as AcEd\r\nimport Autodesk.Civil.ApplicationServices as CivAppServ\r\nimport Autodesk.Civil.DatabaseServices as CivDb\r\nimport Autodesk.Civil.DatabaseServices.Styles as CivDbStyles\r\nimport Autodesk.AutoCAD.Geometry as AcGe\r\n\r\nsurfaceName = IN[0]\r\nprofileViewStyleName = IN[1]\r\nband_Profile2LevelsStyle = IN[2]\r\nband_Profile1LevelsStyle = IN[3]\r\nband_LevelDifferenceStyle = IN[4]\r\nband_ChainageStyle = IN[5]\r\nprofileStyleName = IN[6]\r\noffsetDistance = IN[7]\r\nweedingDistance = IN[8]\r\nangleThresholdDegInput = IN[9]\r\ncurveRadiusInputParam = IN[10]\r\nnewProfileNameInput = IN[11] if len(IN) > 11 else None\r\n\r\ndoc = AcAppServ.Application.DocumentManager.MdiActiveDocument\r\ndb = doc.Database\r\ned = doc.Editor\r\n\r\ndef _safeCall(obj, methodName, args=None):\r\n    try:\r\n        m = getattr(obj, methodName)\r\n        return m(*(args or []))\r\n    except AttributeError:\r\n        mi = obj.GetType().GetMethod(methodName)\r\n        if mi is None:\r\n            return None\r\n        if args:\r\n            return mi.Invoke(obj, System.Array[object](args))\r\n        return mi.Invoke(obj, None)\r\n\r\ndef _safeProp(obj, propName):\r\n    try:\r\n        return getattr(obj, propName)\r\n    except AttributeError:\r\n        pi = obj.GetType().GetProperty(propName)\r\n        if pi is None:\r\n            raise\r\n        return pi.GetValue(obj, None)\r\n\r\ndef _safeIndex(obj, i):\r\n    try:\r\n        return obj[i]\r\n    except (AttributeError, TypeError):\r\n        mi = obj.GetType().GetMethod(\"get_Item\")\r\n        if mi is None:\r\n            raise\r\n        return mi.Invoke(obj, System.Array[object]([i]))\r\n\r\nprofileName = None\r\nprofileViewName = None\r\nprofileViewId = None\r\nerrorMsg = None\r\n\r\npeo = AcEd.PromptEntityOptions(\"\\nSelect an alignment to create a profile view for: \")\r\npeo.SetRejectMessage(\"\\nMust be an Alignment.\")\r\npeo.AddAllowedClass(clr.GetClrType(CivDb.Alignment), True)\r\n\r\nresult = ed.GetEntity(peo)\r\n\r\nif result.Status == AcEd.PromptStatus.OK:\r\n    newProfileName = None\r\n    if newProfileNameInput is not None and str(newProfileNameInput).strip() != \"\":\r\n        newProfileName = str(newProfileNameInput).strip()\r\n    else:\r\n        pso = AcEd.PromptStringOptions(\"\\nEnter a name for the new profile: \")\r\n        pso.AllowSpaces = True\r\n        pso.DefaultValue = \"MWP-Road Design\"\r\n        pso.UseDefaultValue = True\r\n        nameResult = ed.GetString(pso)\r\n        if nameResult.Status == AcEd.PromptStatus.OK:\r\n            newProfileName = nameResult.StringResult\r\n\r\n    if newProfileName:\r\n        ppo = AcEd.PromptPointOptions(\"\\nSpecify profile view origin: \")\r\n        pointResult = ed.GetPoint(ppo)\r\n\r\n        if pointResult.Status == AcEd.PromptStatus.OK:\r\n            insertPoint = pointResult.Value\r\n            with doc.LockDocument():\r\n                with db.TransactionManager.StartTransaction() as tr:\r\n                    try:\r\n                        civilDoc = CivAppServ.CivilApplication.ActiveDocument\r\n                        alignmentId = result.ObjectId\r\n\r\n                        surfaceIds = civilDoc.GetSurfaceIds()\r\n                        surfaceId = AcDb.ObjectId.Null\r\n                        surfaceMatched = False\r\n                        if surfaceName:\r\n                            for sid in surfaceIds:\r\n                                sObj = tr.GetObject(sid, AcDb.OpenMode.ForRead)\r\n                                if sObj.Name.strip().lower() == str(surfaceName).strip().lower():\r\n                                    surfaceId = sid\r\n                                    surfaceMatched = True\r\n                                    break\r\n                        if surfaceId.IsNull and surfaceIds.Count > 0:\r\n                            surfaceId = surfaceIds[0]\r\n\r\n                        if surfaceId.IsNull:\r\n                            errorMsg = \"No surfaces found in the drawing.\"\r\n                        else:\r\n                            styleId = AcDb.ObjectId.Null\r\n                            styleMatched = False\r\n                            if profileStyleName:\r\n                                try:\r\n                                    candidateStyleId = civilDoc.Styles.ProfileStyles[str(profileStyleName)]\r\n                                    if not candidateStyleId.IsNull:\r\n                                        styleId = candidateStyleId\r\n                                        styleMatched = True\r\n                                except:\r\n                                    pass\r\n                            if styleId.IsNull and civilDoc.Styles.ProfileStyles.Count > 0:\r\n                                styleId = civilDoc.Styles.ProfileStyles[0]\r\n\r\n                            labelSetId = AcDb.ObjectId.Null\r\n                            if civilDoc.Styles.LabelSetStyles.ProfileLabelSetStyles.Count > 0:\r\n                                labelSetId = civilDoc.Styles.LabelSetStyles.ProfileLabelSetStyles[0]\r\n\r\n                            layerId = db.Clayer\r\n\r\n                            baseProfileName = newProfileName\r\n                            profileNameSuffix = 1\r\n                            while True:\r\n                                try:\r\n                                    profileId = CivDb.Profile.CreateFromSurface(\r\n                                        newProfileName, alignmentId, surfaceId, layerId, styleId, labelSetId\r\n                                    )\r\n                                    break\r\n                                except Exception as ex:\r\n                                    exMsg = str(ex).lower()\r\n                                    if not (\"already exists\" in exMsg or \"duplicate\" in exMsg) or profileNameSuffix > 50:\r\n                                        raise\r\n                                    profileNameSuffix += 1\r\n                                    newProfileName = \"{0}_{1}\".format(baseProfileName, profileNameSuffix)\r\n\r\n                            profileEntity = tr.GetObject(profileId, AcDb.OpenMode.ForRead)\r\n                            profileName = profileEntity.Name\r\n\r\n                            profileLabelErrors = []\r\n                            labelGroupDiag = []\r\n\r\n                            def _processLabelGroups(sourceLabel, entity):\r\n                                if entity is None:\r\n                                    return\r\n                                try:\r\n                                    groupIds = _safeCall(entity, \"GetLabelGroupIds\")\r\n                                    if groupIds is not None:\r\n                                        for lgId in groupIds:\r\n                                            try:\r\n                                                lgObj = tr.GetObject(lgId, AcDb.OpenMode.ForWrite)\r\n                                                typeName = lgObj.GetType().Name\r\n                                                typeNameLower = typeName.lower()\r\n                                                erased = False\r\n                                                if \"tangent\" in typeNameLower or \"straight\" in typeNameLower or \"line\" in typeNameLower:\r\n                                                    lgObj.Erase()\r\n                                                    erased = True\r\n                                                labelGroupDiag.append(\"{0}: {1}{2}\".format(sourceLabel, typeName, \" (ERASED)\" if erased else \"\"))\r\n                                            except Exception as ex:\r\n                                                profileLabelErrors.append(\"Failed to process {0} label group {1}: {2}\".format(sourceLabel, lgId, ex))\r\n                                except Exception as ex:\r\n                                    profileLabelErrors.append(\"{0} label group cleanup skipped: {1}\".format(sourceLabel, ex))\r\n\r\n                            _processLabelGroups(\"Profile\", profileEntity)\r\n                            try:\r\n                                alignmentEntity = tr.GetObject(alignmentId, AcDb.OpenMode.ForRead)\r\n                                _processLabelGroups(\"Alignment\", alignmentEntity)\r\n                            except Exception as ex:\r\n                                profileLabelErrors.append(\"Alignment label group cleanup failed: {0}\".format(ex))\r\n\r\n                            offsetProfileErrors = []\r\n                            offsetProfileId = AcDb.ObjectId.Null\r\n                            offsetProfileName = None\r\n                            try:\r\n                                if offsetDistance is not None:\r\n                                    offsetProfileNameBase = newProfileName + \" Offset\"\r\n                                    offsetProfileNameFinal = offsetProfileNameBase\r\n                                    offsetSuffix = 1\r\n                                    while True:\r\n                                        try:\r\n                                            offsetProfileId = CivDb.Profile.CreateByLayout(\r\n                                                offsetProfileNameFinal, alignmentId, layerId, styleId, labelSetId\r\n                                            )\r\n                                            break\r\n                                        except Exception as ex:\r\n                                            exMsg = str(ex).lower()\r\n                                            if not (\"already exists\" in exMsg or \"duplicate\" in exMsg) or offsetSuffix > 50:\r\n                                                raise\r\n                                            offsetSuffix += 1\r\n                                            offsetProfileNameFinal = \"{0}_{1}\".format(offsetProfileNameBase, offsetSuffix)\r\n\r\n                                    offsetProfileEntity = tr.GetObject(offsetProfileId, AcDb.OpenMode.ForWrite)\r\n                                    offsetProfileName = offsetProfileEntity.Name\r\n\r\n                                    srcPVIs = _safeProp(profileEntity, \"PVIs\")\r\n                                    pviCount = _safeProp(srcPVIs, \"Count\")\r\n                                    dstPVIs = _safeProp(offsetProfileEntity, \"PVIs\")\r\n\r\n                                    minSpacing = float(weedingDistance) if weedingDistance else 0.0\r\n                                    curveRadiusInput = float(curveRadiusInputParam) if curveRadiusInputParam is not None else 100.0\r\n                                    angleThresholdDeg = float(angleThresholdDegInput) if angleThresholdDegInput is not None else 10.0\r\n\r\n                                    keptPoints = []\r\n                                    lastKeptStation = None\r\n                                    for i in range(pviCount):\r\n                                        try:\r\n                                            pviObj = _safeIndex(srcPVIs, i)\r\n                                            station = float(_safeProp(pviObj, \"Station\"))\r\n                                            elevation = float(_safeProp(pviObj, \"Elevation\"))\r\n                                            isEndpoint = (i == 0 or i == pviCount - 1)\r\n                                            if not isEndpoint and lastKeptStation is not None and (station - lastKeptStation) < minSpacing:\r\n                                                continue\r\n                                            keptPoints.append((station, elevation))\r\n                                            lastKeptStation = station\r\n                                        except Exception as ex:\r\n                                            offsetProfileErrors.append(\"Failed to read PVI {0}: {1}\".format(i, ex))\r\n\r\n                                    # SINGLE-PASS PVI ADDITION (RADIUS BASED)\r\n                                    addedCount = len(keptPoints)\r\n                                    curveCount = 0\r\n                                    maxAngleSeen = 0.0\r\n\r\n                                    for k in range(addedCount):\r\n                                        station, elevation = keptPoints[k]\r\n                                        targetElevation = elevation + float(offsetDistance)\r\n                                        isEndpoint = (k == 0 or k == addedCount - 1)\r\n\r\n                                        if isEndpoint:\r\n                                            dstPVIs.AddPVI(station, targetElevation)\r\n                                        else:\r\n                                            prevStation, prevElevation = keptPoints[k - 1]\r\n                                            nextStation, nextElevation = keptPoints[k + 1]\r\n\r\n                                            grade1 = (elevation - prevElevation) / (station - prevStation) if (station - prevStation) != 0 else 0.0\r\n                                            grade2 = (nextElevation - elevation) / (nextStation - station) if (nextStation - station) != 0 else 0.0\r\n                                            angleDeg = abs(math.degrees(math.atan(grade2) - math.atan(grade1)))\r\n\r\n                                            if angleDeg > maxAngleSeen:\r\n                                                maxAngleSeen = angleDeg\r\n\r\n                                            if angleDeg > angleThresholdDeg:\r\n                                                maxAllowedLen = min(station - prevStation, nextStation - station) * 0.80\r\n                                                angleRad = math.radians(angleDeg)\r\n                                                maxAllowedRadius = (maxAllowedLen / angleRad) if angleRad > 0 else curveRadiusInput\r\n                                                targetRadius = min(curveRadiusInput, maxAllowedRadius)\r\n\r\n                                                if targetRadius >= 0.5:\r\n                                                    try:\r\n                                                        dstPVIs.AddPVIArc(station, targetElevation, targetRadius)\r\n                                                        curveCount += 1\r\n                                                    except Exception:\r\n                                                        dstPVIs.AddPVI(station, targetElevation)\r\n                                                else:\r\n                                                    dstPVIs.AddPVI(station, targetElevation)\r\n                                            else:\r\n                                                dstPVIs.AddPVI(station, targetElevation)\r\n\r\n                                    offsetProfileErrors.append(\"Offset profile '{0}' PVIs added: {1}/{2} (weeded to {3}m spacing, {4} arc curves >{5} deg, max angle {6:.2f} deg)\".format(\r\n                                        offsetProfileName, addedCount, pviCount, minSpacing, curveCount, angleThresholdDeg, maxAngleSeen))\r\n                            except Exception as ex:\r\n                                offsetProfileErrors.append(\"Offset profile creation failed: {0}\".format(ex))\r\n\r\n                            pvStyleId = AcDb.ObjectId.Null\r\n                            pvStyleMatched = False\r\n                            if profileViewStyleName:\r\n                                try:\r\n                                    candidatePvStyleId = civilDoc.Styles.ProfileViewStyles[str(profileViewStyleName)]\r\n                                    if not candidatePvStyleId.IsNull:\r\n                                        pvStyleId = candidatePvStyleId\r\n                                        pvStyleMatched = True\r\n                                except:\r\n                                    pass\r\n                            if pvStyleId.IsNull and civilDoc.Styles.ProfileViewStyles.Count > 0:\r\n                                pvStyleId = civilDoc.Styles.ProfileViewStyles[0]\r\n\r\n                            pvBandSetId = AcDb.ObjectId.Null\r\n                            if civilDoc.Styles.ProfileViewBandSetStyles.Count > 0:\r\n                                pvBandSetId = civilDoc.Styles.ProfileViewBandSetStyles[0]\r\n\r\n                            baseProfileViewName = newProfileName + \" Profile View\"\r\n                            newProfileViewName = baseProfileViewName\r\n                            profileViewNameSuffix = 1\r\n                            while True:\r\n                                try:\r\n                                    profileViewId = CivDb.ProfileView.Create(\r\n                                        alignmentId, insertPoint, newProfileViewName, pvBandSetId, pvStyleId\r\n                                    )\r\n                                    break\r\n                                except Exception as ex:\r\n                                    exMsg = str(ex).lower()\r\n                                    if not (\"already exists\" in exMsg or \"duplicate\" in exMsg) or profileViewNameSuffix > 50:\r\n                                        raise\r\n                                    profileViewNameSuffix += 1\r\n                                    newProfileViewName = \"{0}_{1}\".format(baseProfileViewName, profileViewNameSuffix)\r\n\r\n                            profileViewEntity = tr.GetObject(profileViewId, AcDb.OpenMode.ForWrite)\r\n                            profileViewName = profileViewEntity.Name\r\n\r\n                            _processLabelGroups(\"ProfileView\", profileViewEntity)\r\n\r\n                            bandRequests = [\r\n                                (\"Profile 2 Levels\", band_Profile2LevelsStyle),\r\n                                (\"Profile 1 Levels\", band_Profile1LevelsStyle),\r\n                                (\"Level Difference\", band_LevelDifferenceStyle),\r\n                                (\"Chainage\", band_ChainageStyle),\r\n                            ]\r\n                            bandErrors = []\r\n                            bandsResolved = []\r\n                            for bandType, bandStyleName in bandRequests:\r\n                                if not bandStyleName:\r\n                                    continue\r\n                                try:\r\n                                    civilDoc.Styles.BandStyles.ProfileViewProfileDataBandStyles[str(bandStyleName)]\r\n                                    bandsResolved.append(bandType)\r\n                                except Exception as ex:\r\n                                    bandErrors.append(\"{0}: style '{1}' not found: {2}\".format(bandType, bandStyleName, ex))\r\n\r\n                            bandsAdded = []\r\n                            try:\r\n                                currentBottom = profileViewEntity.Bands.GetBottomBandItems()\r\n                                originalBottomCount = currentBottom.Count\r\n\r\n                                bandTypeEnumType = None\r\n                                for m in currentBottom.GetType().GetMethods():\r\n                                    if m.Name == \"Add\" and len(m.GetParameters()) == 2:\r\n                                        bandTypeEnumType = m.GetParameters()[0].ParameterType\r\n                                        break\r\n                                profileDataBandType = None\r\n                                if bandTypeEnumType is not None:\r\n                                    enumNames = list(System.Enum.GetNames(bandTypeEnumType))\r\n                                    matchedName = None\r\n                                    for n in enumNames:\r\n                                        if n.lower().replace(\" \", \"\") == \"profiledata\":\r\n                                            matchedName = n\r\n                                            break\r\n                                    if matchedName is not None:\r\n                                        profileDataBandType = System.Enum.Parse(bandTypeEnumType, matchedName)\r\n\r\n                                for bandType, bandStyleName in bandRequests:\r\n                                    if bandType not in bandsResolved:\r\n                                        continue\r\n                                    try:\r\n                                        if profileDataBandType is None:\r\n                                            raise Exception(\"Could not resolve BandType enum\")\r\n                                        currentBottom.Add(profileDataBandType, str(bandStyleName))\r\n                                        newItem = currentBottom[currentBottom.Count - 1]\r\n                                        try:\r\n                                            newItem.Gap = 0.0\r\n                                        except Exception as ex:\r\n                                            bandErrors.append(\"{0}: gap error: {1}\".format(bandType, ex))\r\n                                        bandsAdded.append(bandType)\r\n                                    except Exception as ex:\r\n                                        bandErrors.append(\"{0}: add failed: {1}\".format(bandType, ex))\r\n\r\n                                for i in range(originalBottomCount - 1, -1, -1):\r\n                                    try:\r\n                                        currentBottom.RemoveAt(i)\r\n                                    except Exception as ex:\r\n                                        bandErrors.append(\"Failed to remove original band {0}: {1}\".format(i, ex))\r\n\r\n                                profileViewEntity.Bands.SetBottomBandItems(currentBottom)\r\n                            except Exception as ex:\r\n                                bandErrors.append(\"Bottom band update failed: {0}\".format(ex))\r\n\r\n                            try:\r\n                                currentTop = profileViewEntity.Bands.GetTopBandItems()\r\n                                if currentTop is not None and currentTop.Count > 0:\r\n                                    topCountBefore = currentTop.Count\r\n                                    for i in range(topCountBefore - 1, -1, -1):\r\n                                        try:\r\n                                            currentTop.RemoveAt(i)\r\n                                        except Exception as ex:\r\n                                            bandErrors.append(\"Failed to remove top band {0}: {1}\".format(i, ex))\r\n                                    profileViewEntity.Bands.SetTopBandItems(currentTop)\r\n                            except Exception as ex:\r\n                                bandErrors.append(\"Top band clear failed: {0}\".format(ex))\r\n\r\n                            warnings = []\r\n                            if surfaceName and not surfaceMatched:\r\n                                warnings.append(\"surface '{0}' not found, used default\".format(surfaceName))\r\n                            if profileStyleName and not styleMatched:\r\n                                warnings.append(\"profile style '{0}' not found, used default\".format(profileStyleName))\r\n                            if profileViewStyleName and not pvStyleMatched:\r\n                                warnings.append(\"profile view style '{0}' not found, used default\".format(profileViewStyleName))\r\n                            if bandsAdded:\r\n                                warnings.append(\"bands added: \" + \", \".join(bandsAdded))\r\n                            if bandErrors:\r\n                                warnings.append(\"band errors: \" + \" | \".join(bandErrors))\r\n                            if profileLabelErrors:\r\n                                warnings.append(\"label cleanup errors: \" + \" | \".join(profileLabelErrors))\r\n                            if labelGroupDiag:\r\n                                warnings.append(\"label groups removed: \" + \" | \".join(labelGroupDiag))\r\n                            if offsetProfileErrors:\r\n                                warnings.append(\"offset profile: \" + \" | \".join(offsetProfileErrors))\r\n                            if warnings:\r\n                                errorMsg = \"Warning: \" + \"; \".join(warnings)\r\n\r\n                        tr.Commit()\r\n                    except Exception as ex:\r\n                        excType, excValue, excTb = sys.exc_info()\r\n                        lineNo = excTb.tb_lineno if excTb is not None else -1\r\n                        errorMsg = \"Line {0}: {1}: {2}\".format(lineNo, excType, excValue)\r\n                        tr.Abort()\r\n        else:\r\n            errorMsg = \"No insertion point specified.\"\r\n    else:\r\n        errorMsg = \"No profile name entered.\"\r\nelse:\r\n    errorMsg = \"No alignment selected.\"\r\n\r\nOUT = profileName, profileViewName, profileViewId, errorMsg",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
      "Id": "10430c4fddde47119265789b9d6fc461",
