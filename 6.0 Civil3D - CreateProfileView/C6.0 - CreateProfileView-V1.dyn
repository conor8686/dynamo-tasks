{
  "Uuid": "f7afe65a-1af8-44d8-b617-252aee89bb52",
  "IsCustomNode": false,
  "Description": "v2.0 - Prompts the user to pick an Alignment, looks up a Surface and Profile View style by name, a profile name, and a point in the drawing; creates a Surface Profile from the alignment/surface, then a Profile View there in that style. Clears the Profile View's default bottom bands and replaces them with four Profile Data bands (Profile 2 Levels, Profile 1 Levels, Level Difference, Chainage) by style name, linked to the created profile.",
  "Name": "C6.02 - CreateProfileView",
  "ElementResolver": {
    "ResolutionMap": {}
  },
