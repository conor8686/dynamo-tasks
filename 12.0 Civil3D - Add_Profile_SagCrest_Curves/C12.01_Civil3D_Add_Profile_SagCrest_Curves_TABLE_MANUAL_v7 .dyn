  ],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "\"\"\"\nDynamo for Civil 3D - Python Script node (engine: IronPython2)\n\nNOTE: IronPython2, not CPython3 - touching Application.DocumentManager /\nAutodesk.Civil.DatabaseServices pulls in Autodesk.AutoCAD.Interop, which\nDynamo's CPython3 (pythonnet) engine cannot load in this Civil3D build\n(\"Could not load type ... AcWindowState ...\"). IronPython2's native CLR\nhosting resolves it fine - same reason every other Civil3D-API script in\nthis repo (Add_MWP-NEZ_ChainageLevel_Labels.py, Diagnose_Civil3D_Styles.py)\nuses IronPython2.\n\nPrompts you to select one or more Profile Views on screen. For every design\n(layout) profile plotted in each selected view, walks every PVI that is\ncurrently a plain tangent-tangent break (no curve yet) and inserts a\nsymmetric parabolic vertical curve there - EditSagCurve() where the grade\nincreases through the PVI (valley), EditCrestCurve() where it decreases\n(hilltop) - sized from a single curve radius R (m):\n\n    curve length L = R x |grade_out - grade_in|\n\nwith grade_out/grade_in as decimal fractions (e.g. 0.03 for 3%). That is R\nas used for \"VC RAD\" on Irish/UK road longitudinal-section drawings, not an\nAASHTO K value expressed in percent (K = R / 100 in that convention).\nConfirmed against Civil3D's own native Insert PVI / Curve Settings dialog\n(entering a Radius and reading back the resulting Length/K value).\n\nIf that ideal length won't fit between the PVI and its neighbour (i.e. the\nPVI's tangent on that side is shorter than L/2), the length is CLIPPED to\n2 x the shorter available tangent, matching what Civil3D's own dialog does\nin the same situation (confirmed against a native example where Radius 3.4\nproduced Length 3.310 - not R x delta - because the neighbouring PVI didn't\nleave enough room; Civil3D shows K Value 0.000 for a curve clipped like\nthis, since it no longer corresponds to the requested radius). A clipped\ncurve is still added and counted as a success, just flagged in the report\nwith the ideal length it couldn't reach.\n\nPVIs where the grade doesn't actually break (|delta grade| below\nminGradeBreak) are left alone and reported as skipped. Every other interior\nPVI just gets Profile.Entities.AddFreeSymmetricParabolaByRadius called on it directly, inside its\nown try/except - a PVI that's already curved, or can't fit the requested\nradius (curve longer than the available tangent to its neighbour), throws\nfrom that call and is reported as a failure with Civil3D's own message,\nrather than pre-checked. (Deliberate: this OEM build's ProfilePVI.PVIType\ngetter returns null for an ordinary uncurved PVI instead of throwing or\nreturning TangentWithoutCurve, the same broken-managed-property pattern as\nthe .Name getters documented in Add_MWP-NEZ_ChainageLevel_Labels_HELP.md -\nso pre-checking PVIType here misclassified every plain PVI as \"already\ncurved\" and skipped the whole profile. Letting the Profile entity API itself\ndecide sidesteps that.)\n\nInputs:\n  Runtime dropdown: duct/cable selection from P02_Detail Summary.xlsx Profile Elements Table; its Curve Radius is used.\n  IN[0] : manual curve radius in metres (used when IN[2] = True)\n  IN[1] : minimum grade break to treat as a real PVI, decimal fraction\n          (number, default 0.0001 = 0.01%)\n  IN[2] : manual radius override (Boolean): False = TABLE dropdown, True = IN[0]\n\nOutput:\n  OUT   : list[str] run report - one line per PVI processed/skipped, plus\n          per-profile and grand totals\n\"\"\"\nimport clr\nfrom System import Array\n\nclr.AddReference('AcMgd')\nclr.AddReference('AcCoreMgd')\nclr.AddReference('AcDbMgd')\nclr.AddReference('AeccDbMgd')\nclr.AddReference('System.Windows.Forms')\nclr.AddReference('System.Drawing')\n\nfrom Autodesk.AutoCAD.ApplicationServices import Application\nfrom Autodesk.AutoCAD.DatabaseServices import OpenMode\nfrom Autodesk.AutoCAD.EditorInput import PromptSelectionOptions\nfrom Autodesk.Civil.ApplicationServices import CivilDocument\nfrom Autodesk.Civil.DatabaseServices import ProfileView, Profile, VerticalCurveType\nfrom System.Windows.Forms import Form, Label, ComboBox, Button, DialogResult, FormStartPosition, ComboBoxStyle\nfrom System.Drawing import Point, Size\n\n# Embedded lookup updated from P02_Detail Summary.xlsx -> Profile Elements Table.\n# Tuple: (No., Duct / Cable, PRACTICAL Curve Radius in metres).\n#\n# TABLE NOTE - Profile Elements recommended practical design radii:\n#  01  40mm E-DUCT                                      R = 1.500 m\n#  02  50mm E-DUCT / E-DUCT_EARTH                      R = 1.500 m\n#  03  63mm E-DUCT_SDR17.6                              R = 2.000 m\n#  04  110mm E-DUCT_SDR17.6 / COMMS_SDR17.6             R = 3.000 m\n#  05  125mm E-DUCT_SDR17.6 / COMMS / ECC_SDR17.6       R = 3.500 m\n#  06  125mm E-DUCT_HDD_SDR11                            R = 3.500 m\n#  07  140mm E-DUCT_COMMS_HDD_SDR11                      R = 3.500 m\n#  08  160mm E-DUCT_SDR21                                R = 4.500 m\n#  09  180mm E-DUCT_HDD_SDR11                            R = 4.500 m\n#  10  200mm E-DUCT_SDR21                                R = 5.500 m\n#  11-14 Project direct-buried HV cable rows             R = 2.500 m\n#  15-21 Generic direct-buried cable rows                R = NOT SET (0.000 m)\n#\n# Source notes carried into this script:\n# - Use the PRACTICAL design radius; do not enter a smaller radius in Civil 3D.\n# - K Value = Curve Radius / 100.\n# - Profile Curve Length in the spreadsheet is only a representative placeholder;\n#   Civil 3D derives the actual length from radius and the real PVI grade change.\n# - Profile Curve Type and asymmetric lengths are per-PVI values.\n# - Generic/reference rows with radius 0 must be confirmed before use.\nPROFILE_RADIUS_TABLE = [\n    (1,  '40mm E-DUCT', 1.500),\n    (2,  '50mm E-DUCT / E-DUCT_EARTH', 1.500),\n    (3,  '63mm E-DUCT_SDR17.6', 2.000),\n    (4,  '110mm E-DUCT_SDR17.6 / COMMS_SDR17.6', 3.000),\n    (5,  '125mm E-DUCT_SDR17.6 / COMMS / ECC_SDR17.6', 3.500),\n    (6,  '125mm E-DUCT_HDD_SDR11', 3.500),\n    (7,  '140mm E-DUCT_COMMS_HDD_SDR11', 3.500),\n    (8,  '160mm E-DUCT_SDR21', 4.500),\n    (9,  '180mm E-DUCT_HDD_SDR11', 4.500),\n    (10, '200mm E-DUCT_SDR21', 5.500),\n    (11, 'Direct buried HV cable - 1c x 2000mm2 Aluminium HV (Incoming feed, Energinet -> FRD2A/C (L1/L2/L3))', 2.500),\n    (12, 'Direct buried HV cable - 1c x 2000mm2 Aluminium HV (Incoming feed, Energinet -> FRD2A/D (L1/L2/L3))', 2.500),\n    (13, 'Direct buried HV cable - 1c x 800mm2 Aluminium HV (Outgoing feed, FRD2A/C -> FRD1A/B (L1/L2/L3))', 2.500),\n    (14, 'Direct buried HV cable - 1c x 800mm2 Aluminium HV (Outgoing feed, FRD2A/D -> FRD1A/A (L1/L2/L3))', 2.500),\n    (15, 'Direct buried cable (generic) - Unarmoured multicore cable, OD <= 25mm', 0.0),\n    (16, 'Direct buried cable (generic) - Unarmoured multicore cable, 25mm < OD <= 50mm', 0.0),\n    (17, 'Direct buried cable (generic) - Unarmoured multicore cable, OD > 50mm', 0.0),\n    (18, 'Direct buried cable (generic) - Armoured (SWA) multicore cable', 0.0),\n    (19, 'Direct buried cable (generic) - Single-core cable (armoured or unarmoured)', 0.0),\n    (20, 'Direct buried cable (generic) - Individually shielded / overall-shielded cable', 0.0),\n    (21, 'Direct buried cable (generic) - Lead-sheathed cable', 0.0)\n]\n\ndef choose_radius_from_table():\n    form = Form()\n    form.Text = 'Select Duct / Cable - Vertical Curve Radius'\n    form.Size = Size(900, 245)\n    form.StartPosition = FormStartPosition.CenterScreen\n    form.TopMost = True\n\n    lbl = Label()\n    lbl.Text = 'Select duct / cable from P02 Detail Summary - Profile Elements Table:'\n    lbl.Location = Point(15, 15)\n    lbl.Size = Size(840, 20)\n    form.Controls.Add(lbl)\n\n    combo = ComboBox()\n    combo.Location = Point(15, 42)\n    combo.Size = Size(850, 25)\n    combo.DropDownStyle = ComboBoxStyle.DropDownList\n    for no, name, r in PROFILE_RADIUS_TABLE:\n        if r > 0:\n            combo.Items.Add('{:02d} | {} | R = {:.3f} m'.format(no, name, r))\n        else:\n            combo.Items.Add('{:02d} | {} | R = NOT SET'.format(no, name))\n    combo.SelectedIndex = 0\n    form.Controls.Add(combo)\n\n    note = Label()\n    note.Text = 'NOTE: Radius values are PRACTICAL design radii from the table. Do not use a smaller radius. Rows showing NOT SET must be confirmed before use.'\n    note.Location = Point(15, 76)\n    note.Size = Size(850, 40)\n    form.Controls.Add(note)\n\n    ok = Button()\n    ok.Text = 'Use selected radius'\n    ok.Location = Point(570, 135)\n    ok.Size = Size(145, 30)\n    ok.DialogResult = DialogResult.OK\n    form.AcceptButton = ok\n    form.Controls.Add(ok)\n\n    cancel = Button()\n    cancel.Text = 'Cancel'\n    cancel.Location = Point(725, 135)\n    cancel.Size = Size(140, 30)\n    cancel.DialogResult = DialogResult.Cancel\n    form.CancelButton = cancel\n    form.Controls.Add(cancel)\n\n    result = form.ShowDialog()\n    if result != DialogResult.OK or combo.SelectedIndex < 0:\n        return None\n    return PROFILE_RADIUS_TABLE[combo.SelectedIndex]\n\n# Radius source control:\n# IN[2] = False -> choose radius from embedded Profile Elements table.\n# IN[2] = True  -> bypass dropdown and use manual radius from IN[0] (metres).\nuse_manual_radius = bool(IN[2]) if (len(IN) > 2 and IN[2] is not None) else False\nmanual_radius = float(IN[0]) if (len(IN) > 0 and IN[0] is not None) else None\n\nselected_table_item = None if use_manual_radius else choose_radius_from_table()\nif use_manual_radius:\n    radius = manual_radius\n    selected_description = 'Manual radius override'\n    selected_no = None\nelse:\n    radius = selected_table_item[2] if selected_table_item is not None else None\n    selected_description = selected_table_item[1] if selected_table_item is not None else None\n    selected_no = selected_table_item[0] if selected_table_item is not None else None\n\nminGradeBreak = float(IN[1]) if (len(IN) > 1 and IN[1] is not None) else 0.0001\n\nreport = []\n\nif use_manual_radius and (radius is None or radius <= 0):\n    report.append('ERROR: MANUAL mode is TRUE but IN[0] manual radius must be greater than 0.000 m - nothing done.')\nelif (not use_manual_radius) and selected_table_item is None:\n    report.append('Cancelled - no duct/cable selected, nothing done.')\nelif not radius or radius <= 0:\n    report.append(\"ERROR: selected table row {} '{}' has no Curve Radius set - nothing done.\".format(selected_no, selected_description))\nelse:\n    if use_manual_radius:\n        report.append(\"RADIUS SOURCE: MANUAL | IN[0] Curve Radius R={:.3f} m\".format(radius))\n    else:\n        report.append(\"RADIUS SOURCE: TABLE | No. {} | {} | Curve Radius R={:.3f} m\".format(selected_no, selected_description, radius))\n    doc = Application.DocumentManager.MdiActiveDocument\n    db = doc.Database\n    ed = doc.Editor\n\n    opts = PromptSelectionOptions()\n    opts.MessageForAdding = \"Select design Profile line(s) to add sag/crest curves to: \"\n    selResult = ed.GetSelection(opts)\n\n    if str(selResult.Status) != \"OK\" or selResult.Value is None or selResult.Value.Count == 0:\n        report.append(\"No profiles selected - nothing done.\")\n    else:\n        grandCurves = 0\n        grandSkipped = 0\n        grandErrors = 0\n        validProfiles = 0\n\n        with doc.LockDocument():\n            with db.TransactionManager.StartTransaction() as tr:\n                for selObj in selResult.Value:\n                    profId = selObj.ObjectId\n                    try:\n                        profile = tr.GetObject(profId, OpenMode.ForWrite)\n                        if not isinstance(profile, Profile):\n                            try: clsName = profile.GetType().FullName\n                            except Exception: clsName = profile.GetRXClass().Name\n                            report.append(\"Skipped selected object {} - API type is {} (not Profile).\".format(profId.Handle.ToString(), clsName))\n                            continue\n                    except Exception as ex:\n                        report.append(\"Could not open selected object {} as a Profile: {}\".format(profId.Handle.ToString(), str(ex)))\n                        continue\n\n                    validProfiles += 1\n                    try:\n                        prof_name = profile.AcadObject.Name\n                    except Exception:\n                        prof_name = profId.Handle.ToString()\n                    label = \"'{}'\".format(prof_name)\n\n                    try:\n                        pvis = profile.PVIs\n                        count = pvis.Count\n                    except Exception as ex:\n                        report.append(\"{}: profile has no editable PVI collection - {}\".format(label, str(ex)))\n                        grandErrors += 1\n                        continue\n                    if count < 3:\n                        report.append(\"{}: fewer than 3 PVIs - nothing to curve\".format(label))\n                        grandSkipped += 1\n                        continue\n\n                    # Snapshot the PVI data and the IDs of the profile entities on each side.\n                    # Civil 3D 2027 creates vertical curves through Profile.Entities, not Profile.PVIs.\n                    work = []\n                    for i in range(1, count - 1):\n                        pvi = pvis[i]\n                        try:\n                            sta = pvi.Station\n                            elev = pvi.Elevation\n                            gradeIn = pvi.GradeIn\n                            gradeOut = pvi.GradeOut\n                            beforeId = pvi.EntityBefore\n                            afterId = pvi.EntityAfter\n                            work.append((i, sta, elev, gradeIn, gradeOut, beforeId, afterId))\n                        except Exception as ex:\n                            report.append(\"  {} PVI {}: could not read PVI/entity links - {}\".format(label, i+1, str(ex)))\n\n                    madeHere = skippedHere = errorsHere = 0\n                    entities = profile.Entities\n\n                    # Work from the end of the profile backwards so adding a curve does not\n                    # disturb entity relationships still to be processed upstream.\n                    for item in reversed(work):\n                        i, sta, elev, gradeIn, gradeOut, beforeId, afterId = item\n                        delta = gradeOut - gradeIn\n                        if abs(delta) < minGradeBreak:\n                            skippedHere += 1\n                            report.append(\"  {} sta {:.3f}: grade break {:+.3f}% below threshold - skipped\".format(label, sta, delta*100.0))\n                            continue\n\n                        kind = \"SAG\" if delta > 0 else \"CREST\"\n                        curveType = VerticalCurveType.Sag if delta > 0 else VerticalCurveType.Crest\n                        try:\n                            curve = entities.AddFreeSymmetricParabolaByRadius(\n                                beforeId, afterId, curveType, radius)\n                            madeHere += 1\n                            try:\n                                actualLen = curve.Length\n                                report.append(\"  {} sta {:.3f}: {} added, R={:.3f} m, L={:.3f} m\".format(label, sta, kind, radius, actualLen))\n                            except Exception:\n                                report.append(\"  {} sta {:.3f}: {} added, R={:.3f} m\".format(label, sta, kind, radius))\n                        except Exception as ex:\n                            errorsHere += 1\n                            report.append(\"  {} sta {:.3f}: could not add {} curve R={:.3f} m - {}\".format(label, sta, kind, radius, str(ex)))\n\n                    report.append(\"{}: {} curve(s) added, {} skipped, {} failed\".format(label, madeHere, skippedHere, errorsHere))\n                    grandCurves += madeHere\n                    grandSkipped += skippedHere\n                    grandErrors += errorsHere\n                tr.Commit()\n\n        ed.Regen()\n        if validProfiles == 0:\n            report.append(\"No valid Civil 3D Profiles were found in the selection.\")\n        report.append(\"TOTAL: {} curve(s) added, {} skipped, {} failed\".format(grandCurves, grandSkipped, grandErrors))\n\nOUT = report\n",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
      "Id": "7c4e2a1b3f5d4e8a9b6c1d2e3f4a5b6c",
      "NodeType": "PythonScriptNode",
