{
  "Uuid": "2d6a5b3e-9c1f-4a7e-8b2d-6f4e1c9a7d3b",
  "IsCustomNode": false,
  "Description": "Select a Civil 3D Profile, choose duct/cable from embedded Profile Elements table, and add sag/crest curves using the selected table radius.",
